<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Layout.Display">
    <docs:DocsPage
        Section="Layout"
        Title="Display"
        Intro="Utilities for showing and hiding elements. hidden maps to Avalonia&#x27;s IsVisible property.">
        <StackPanel
            Spacing="52">
            <StackPanel
                Classes="docs-overviewStack">
                <docs:DocsNote
                    Classes="supported"
                    Title="Implemented in this sample"
                    Body="hidden sets IsVisible to false, so the element no longer takes part in layout, like display: none. block sets IsVisible back to true, and the last of the two wins. Removing the class restores visibility. Avalonia has no separate layout-preserving visibility, so invisible and the other display values are not mapped." />
                <docs:DocsUtilityTable
                    x:Name="UtilityTable"
                    CollapsedRowCount="6" />
                <docs:DocsNote
                    Classes="gap"
                    Title="Not implemented yet"
                    Body="These forms sit outside the current parser surface.">
                    <StackPanel
                        Spacing="6">
                        <TextBlock
                            Classes="docs-tableClass"
                            Text="invisible · flex · grid · inline · inline-block · contents · sm:hidden" />
                    </StackPanel>
                </docs:DocsNote>
            </StackPanel>

            <StackPanel
                Spacing="22">
                <TextBlock
                    Classes="docs-eyebrow"
                    Text="Examples" />
                <StackPanel
                    Classes="docs-exampleStack">
                    <docs:DocsSection
                        Heading="Hidden and block"
                        Summary="Three boxes carry a class each, but only two are visible: the one with hidden takes no space, and block shows the last one again.">
                        <docs:DocsExample>
                            <docs:DocsExample.Snippets>
                                <x:String>&lt;Border tw:Tw.Class=&quot;hidden&quot; /&gt;</x:String>
                                <x:String>&lt;Border tw:Tw.Class=&quot;block&quot; /&gt;</x:String>
                                <x:String>&lt;Border tw:Tw.Class=&quot;hidden block&quot; /&gt;</x:String>
                            </docs:DocsExample.Snippets>
                            <StackPanel
                                Spacing="10">
                                <Border
                                    tw:Tw.Class="hidden bg-red-500 p-3">
                                    <TextBlock
                                        Text="hidden: you cannot see this" />
                                </Border>
                                <Border
                                    tw:Tw.Class="block bg-sky-600 p-3">
                                    <TextBlock
                                        Text="block: visible" />
                                </Border>
                                <Border
                                    tw:Tw.Class="hidden block bg-emerald-600 p-3">
                                    <TextBlock
                                        Text="hidden block: the last one wins" />
                                </Border>
                            </StackPanel>
                        </docs:DocsExample>
                    </docs:DocsSection>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </docs:DocsPage>
</UserControl>
