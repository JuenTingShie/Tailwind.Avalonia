<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Layout.Display">
    <docs:DocsPage
        Section="Layout"
        Title="Display"
        Intro="Utilities for showing and hiding elements. hidden maps to Avalonia&#x27;s IsVisible property."
        Supported="hidden sets IsVisible to false, so the element no longer takes part in layout, like display: none. block sets IsVisible back to true, and the last of the two wins. Removing the class restores visibility. Avalonia has no separate layout-preserving visibility, so invisible and the other display values are not mapped.">
        <docs:DocsPage.Utilities>
            <docs:UtilityReferenceRow ClassName="hidden" AxamlStyle="IsVisible: false" />
            <docs:UtilityReferenceRow ClassName="block" AxamlStyle="IsVisible: true" />
        </docs:DocsPage.Utilities>
        <docs:DocsPage.Gaps>
            <docs:DocsGap Text="invisible · flex · grid · inline · inline-block · contents · sm:hidden" />
        </docs:DocsPage.Gaps>

        <docs:DocsSection
            Heading="Hidden and block"
            Summary="Three boxes carry a class each, but only two are visible: the one with hidden takes no space, and block shows the last one again.">
            <docs:DocsExample>
                <StackPanel
                    Spacing="10">
                    <Border
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="hidden bg-red-500 p-3">
                        <TextBlock
                            Text="hidden: you cannot see this" />
                    </Border>
                    <Border
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="block bg-sky-600 p-3">
                        <TextBlock
                            Text="block: visible" />
                    </Border>
                    <Border
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="hidden block bg-emerald-600 p-3">
                        <TextBlock
                            Text="hidden block: the last one wins" />
                    </Border>
                </StackPanel>
            </docs:DocsExample>
        </docs:DocsSection>
    </docs:DocsPage>
</UserControl>
