<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Layout.Overflow">
    <docs:DocsPage
        Section="Layout"
        Title="Overflow"
        Intro="Utilities for controlling how content that exceeds its container is drawn. They map to Avalonia&#x27;s ClipToBounds property."
        Supported="overflow-hidden and overflow-clip set ClipToBounds to true, and overflow-visible sets it to false. Removing the class restores the control&#x27;s default. Avalonia panels and borders can only clip or not clip; on a ScrollViewer, overflow-x-* and overflow-y-* set the scrollbar visibility of each axis, and overscroll-* controls scroll chaining.">
        <docs:DocsPage.Utilities>
            <docs:UtilityReferenceRow ClassName="overflow-hidden" AxamlStyle="ClipToBounds: true" />
            <docs:UtilityReferenceRow ClassName="overflow-clip" AxamlStyle="ClipToBounds: true" />
            <docs:UtilityReferenceRow ClassName="overflow-visible" AxamlStyle="ClipToBounds: false" />
            <docs:UtilityReferenceRow ClassName="overscroll-auto" AxamlStyle="ScrollViewer.IsScrollChainingEnabled: true" />
            <docs:UtilityReferenceRow ClassName="overscroll-contain / overscroll-none" AxamlStyle="ScrollViewer.IsScrollChainingEnabled: false" />
            <docs:UtilityReferenceRow ClassName="overflow-x-auto / -scroll / -hidden / -clip" AxamlStyle="ScrollViewer.HorizontalScrollBarVisibility: Auto / Visible / Hidden / Disabled" />
            <docs:UtilityReferenceRow ClassName="overflow-y-auto / -scroll / -hidden / -clip" AxamlStyle="ScrollViewer.VerticalScrollBarVisibility: Auto / Visible / Hidden / Disabled" />
        </docs:DocsPage.Utilities>
        <docs:DocsPage.Gaps>
            <docs:DocsGap Text="overflow-auto · overflow-scroll (use overflow-x-* / overflow-y-* on a ScrollViewer)" />
        </docs:DocsPage.Gaps>

        <docs:DocsSection
            Heading="Clipping overflowing children"
            Summary="Both containers are 8rem wide and hold a wider child. The first clips it, the second lets it spill over.">
            <docs:DocsExample>
                <StackPanel
                    Spacing="10">
                    <Border
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="w-32 h-12 bg-slate-700 overflow-hidden">
                        <Border
                            tw:Tw.Class="w-48 h-8 bg-sky-500"
                            HorizontalAlignment="Left" />
                    </Border>
                    <Border
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="w-32 h-12 bg-slate-700 overflow-visible">
                        <Border
                            tw:Tw.Class="w-48 h-8 bg-sky-500"
                            HorizontalAlignment="Left" />
                    </Border>
                </StackPanel>
            </docs:DocsExample>
        </docs:DocsSection>
    </docs:DocsPage>
</UserControl>
