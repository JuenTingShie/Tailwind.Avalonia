<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Layout.Overflow">
    <docs:DocsPage
        Section="Layout"
        Title="Overflow"
        Intro="Utilities for controlling how content that exceeds its container is drawn. They map to Avalonia&#x27;s ClipToBounds property.">
        <StackPanel
            Spacing="52">
            <StackPanel
                Classes="docs-overviewStack">
                <docs:DocsNote
                    Classes="supported"
                    Title="Implemented in this sample"
                    Body="overflow-hidden and overflow-clip set ClipToBounds to true, and overflow-visible sets it to false. Removing the class restores the control&#x27;s default. Avalonia panels and borders can only clip or not clip, so scroll and per-axis variants are not mapped." />
                <docs:DocsUtilityTable
                    x:Name="UtilityTable"
                    CollapsedRowCount="6" />
                <docs:DocsNote
                    Classes="gap"
                    Title="Not implemented yet"
                    Body="These forms sit outside the current parser surface.">
                    <StackPanel
                        Spacing="6">
                        <TextBlock
                            Classes="docs-tableClass"
                            Text="overflow-auto · overflow-scroll · overflow-x-* · overflow-y-*" />
                    </StackPanel>
                </docs:DocsNote>
            </StackPanel>

            <StackPanel
                Spacing="22">
                <TextBlock
                    Classes="docs-eyebrow"
                    Text="Examples" />
                <StackPanel
                    Classes="docs-exampleStack">
                    <docs:DocsSection
                        Heading="Clipping overflowing children"
                        Summary="Both containers are 8rem wide and hold a wider child. The first clips it, the second lets it spill over.">
                        <docs:DocsExample>
                            <docs:DocsExample.Snippets>
                                <x:String>&lt;Border tw:Tw.Class=&quot;overflow-hidden&quot; /&gt;</x:String>
                                <x:String>&lt;Border tw:Tw.Class=&quot;overflow-visible&quot; /&gt;</x:String>
                            </docs:DocsExample.Snippets>
                            <StackPanel
                                Spacing="10">
                                <Border
                                    tw:Tw.Class="w-32 h-12 bg-slate-700 overflow-hidden">
                                    <Border
                                        tw:Tw.Class="w-48 h-8 bg-sky-500"
                                        HorizontalAlignment="Left" />
                                </Border>
                                <Border
                                    tw:Tw.Class="w-32 h-12 bg-slate-700 overflow-visible">
                                    <Border
                                        tw:Tw.Class="w-48 h-8 bg-sky-500"
                                        HorizontalAlignment="Left" />
                                </Border>
                            </StackPanel>
                        </docs:DocsExample>
                    </docs:DocsSection>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </docs:DocsPage>
</UserControl>
