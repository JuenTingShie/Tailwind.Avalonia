<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Layout.ScrollSnap">
    <docs:DocsPage
        Section="Layout"
        Title="Scroll snap"
        Intro="Utilities for snapping scroll positions. They map to the ScrollViewer snap point settings."
        Supported="snap-x, snap-y and snap-both turn on mandatory snap points for an axis, snap-none turns them off, and snap-start / snap-center / snap-end choose where the snap points align. Put them on a ScrollViewer whose content is a Panel (for example a StackPanel); its children are the snap points. Avalonia's built-in snapping only reacts to touch gestures, so Tailwind.Avalonia also settles the offset on the nearest child shortly after wheel or scrollbar scrolling stops. Snapping is always mandatory (Avalonia has no &quot;proximity&quot; strictness), and alignment applies to the whole scroller instead of each child as in CSS.">
        <docs:DocsPage.Utilities>
            <docs:UtilityReferenceRow ClassName="snap-x" AxamlStyle="ScrollViewer.HorizontalSnapPointsType: Mandatory" />
            <docs:UtilityReferenceRow ClassName="snap-y" AxamlStyle="ScrollViewer.VerticalSnapPointsType: Mandatory" />
            <docs:UtilityReferenceRow ClassName="snap-both" AxamlStyle="both axes: Mandatory" />
            <docs:UtilityReferenceRow ClassName="snap-none" AxamlStyle="both axes: None" />
            <docs:UtilityReferenceRow ClassName="snap-start" AxamlStyle="SnapPointsAlignment: Near" />
            <docs:UtilityReferenceRow ClassName="snap-center" AxamlStyle="SnapPointsAlignment: Center" />
            <docs:UtilityReferenceRow ClassName="snap-end" AxamlStyle="SnapPointsAlignment: Far" />
        </docs:DocsPage.Utilities>
        <docs:DocsPage.Gaps>
            <docs:DocsGap Text="snap-proximity · snap-align-none · snap-normal / snap-always · scroll-margin / scroll-padding" />
        </docs:DocsPage.Gaps>

        <docs:DocsSection
            Heading="Horizontal snapping"
            Summary="snap-x turns on snapping for the horizontal axis. Scroll the strip with the wheel (Shift+wheel), the scrollbar or a touch drag; when scrolling stops it settles with a card at the start edge.">
            <docs:DocsExample>
                <ScrollViewer docs:DocsCode.Show="True" Width="420" HorizontalAlignment="Left" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" tw:Tw.Class="snap-x snap-start">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="180" Height="90" CornerRadius="10" tw:Tw.Class="bg-sky-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Card 1" /></Border>
                        <Border Width="180" Height="90" CornerRadius="10" tw:Tw.Class="bg-emerald-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Card 2" /></Border>
                        <Border Width="180" Height="90" CornerRadius="10" tw:Tw.Class="bg-amber-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Card 3" /></Border>
                        <Border Width="180" Height="90" CornerRadius="10" tw:Tw.Class="bg-rose-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Card 4" /></Border>
                        <Border Width="180" Height="90" CornerRadius="10" tw:Tw.Class="bg-violet-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Card 5" /></Border>
                        <Border Width="180" Height="90" CornerRadius="10" tw:Tw.Class="bg-teal-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Card 6" /></Border>
                    </StackPanel>
                </ScrollViewer>
            </docs:DocsExample>
        </docs:DocsSection>

        <docs:DocsSection
            Heading="Vertical snapping"
            Summary="snap-y does the same for the vertical axis.">
            <docs:DocsExample>
                <ScrollViewer docs:DocsCode.Show="True" Width="260" Height="200" HorizontalAlignment="Left" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" tw:Tw.Class="snap-y snap-start">
                    <StackPanel Spacing="12">
                        <Border Height="80" CornerRadius="10" tw:Tw.Class="bg-sky-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Row 1" /></Border>
                        <Border Height="80" CornerRadius="10" tw:Tw.Class="bg-emerald-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Row 2" /></Border>
                        <Border Height="80" CornerRadius="10" tw:Tw.Class="bg-amber-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Row 3" /></Border>
                        <Border Height="80" CornerRadius="10" tw:Tw.Class="bg-rose-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Row 4" /></Border>
                        <Border Height="80" CornerRadius="10" tw:Tw.Class="bg-violet-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Row 5" /></Border>
                        <Border Height="80" CornerRadius="10" tw:Tw.Class="bg-teal-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Row 6" /></Border>
                    </StackPanel>
                </ScrollViewer>
            </docs:DocsExample>
        </docs:DocsSection>

        <docs:DocsSection
            Heading="Snap alignment"
            Summary="snap-start, snap-center and snap-end choose which edge of a child lines up with the viewport. In Avalonia the alignment applies to the whole scroller, not to each child.">
            <docs:DocsExample>
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="docs-miniTitle" Text="snap-start" />
                        <ScrollViewer docs:DocsCode.Show="True" Width="150" Height="200" HorizontalAlignment="Left" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" tw:Tw.Class="snap-y snap-start">
                            <StackPanel Spacing="12">
                                <Border Height="80" CornerRadius="10" tw:Tw.Class="bg-sky-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Row 1" /></Border>
                                <Border Height="80" CornerRadius="10" tw:Tw.Class="bg-emerald-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Row 2" /></Border>
                                <Border Height="80" CornerRadius="10" tw:Tw.Class="bg-amber-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Row 3" /></Border>
                                <Border Height="80" CornerRadius="10" tw:Tw.Class="bg-rose-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Row 4" /></Border>
                                <Border Height="80" CornerRadius="10" tw:Tw.Class="bg-violet-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Row 5" /></Border>
                                <Border Height="80" CornerRadius="10" tw:Tw.Class="bg-teal-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Row 6" /></Border>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Classes="docs-miniTitle" Text="snap-center" />
                        <ScrollViewer docs:DocsCode.Show="True" Width="150" Height="200" HorizontalAlignment="Left" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" tw:Tw.Class="snap-y snap-center">
                            <StackPanel Spacing="12">
                                <Border Height="80" CornerRadius="10" tw:Tw.Class="bg-sky-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Row 1" /></Border>
                                <Border Height="80" CornerRadius="10" tw:Tw.Class="bg-emerald-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Row 2" /></Border>
                                <Border Height="80" CornerRadius="10" tw:Tw.Class="bg-amber-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Row 3" /></Border>
                                <Border Height="80" CornerRadius="10" tw:Tw.Class="bg-rose-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Row 4" /></Border>
                                <Border Height="80" CornerRadius="10" tw:Tw.Class="bg-violet-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Row 5" /></Border>
                                <Border Height="80" CornerRadius="10" tw:Tw.Class="bg-teal-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Row 6" /></Border>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Classes="docs-miniTitle" Text="snap-end" />
                        <ScrollViewer docs:DocsCode.Show="True" Width="150" Height="200" HorizontalAlignment="Left" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" tw:Tw.Class="snap-y snap-end">
                            <StackPanel Spacing="12">
                                <Border Height="80" CornerRadius="10" tw:Tw.Class="bg-sky-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Row 1" /></Border>
                                <Border Height="80" CornerRadius="10" tw:Tw.Class="bg-emerald-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Row 2" /></Border>
                                <Border Height="80" CornerRadius="10" tw:Tw.Class="bg-amber-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Row 3" /></Border>
                                <Border Height="80" CornerRadius="10" tw:Tw.Class="bg-rose-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Row 4" /></Border>
                                <Border Height="80" CornerRadius="10" tw:Tw.Class="bg-violet-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Row 5" /></Border>
                                <Border Height="80" CornerRadius="10" tw:Tw.Class="bg-teal-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Row 6" /></Border>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </docs:DocsExample>
        </docs:DocsSection>

        <docs:DocsSection
            Heading="Snapping on both axes"
            Summary="snap-both snaps horizontally and vertically; here each cell settles in the middle of the viewport.">
            <docs:DocsExample>
                <ScrollViewer docs:DocsCode.Show="True" Width="300" Height="220" HorizontalAlignment="Left" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" tw:Tw.Class="snap-both snap-center">
                    <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                        <Border Grid.Row="0" Grid.Column="0" Width="150" Height="110" CornerRadius="10" tw:Tw.Class="bg-sky-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="1,1" /></Border>
                        <Border Grid.Row="0" Grid.Column="1" Width="150" Height="110" CornerRadius="10" tw:Tw.Class="bg-emerald-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="1,2" /></Border>
                        <Border Grid.Row="0" Grid.Column="2" Width="150" Height="110" CornerRadius="10" tw:Tw.Class="bg-amber-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="1,3" /></Border>
                        <Border Grid.Row="1" Grid.Column="0" Width="150" Height="110" CornerRadius="10" tw:Tw.Class="bg-rose-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="2,1" /></Border>
                        <Border Grid.Row="1" Grid.Column="1" Width="150" Height="110" CornerRadius="10" tw:Tw.Class="bg-violet-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="2,2" /></Border>
                        <Border Grid.Row="1" Grid.Column="2" Width="150" Height="110" CornerRadius="10" tw:Tw.Class="bg-teal-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="2,3" /></Border>
                        <Border Grid.Row="2" Grid.Column="0" Width="150" Height="110" CornerRadius="10" tw:Tw.Class="bg-sky-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="3,1" /></Border>
                        <Border Grid.Row="2" Grid.Column="1" Width="150" Height="110" CornerRadius="10" tw:Tw.Class="bg-emerald-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="3,2" /></Border>
                        <Border Grid.Row="2" Grid.Column="2" Width="150" Height="110" CornerRadius="10" tw:Tw.Class="bg-amber-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="3,3" /></Border>
                    </Grid>
                </ScrollViewer>
            </docs:DocsExample>
        </docs:DocsSection>

        <docs:DocsSection
            Heading="Turning snapping off"
            Summary="snap-none removes snapping, for example to override a snap class set by a style. The list stops wherever scrolling stops.">
            <docs:DocsExample>
                <ScrollViewer docs:DocsCode.Show="True" Width="260" Height="200" HorizontalAlignment="Left" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" tw:Tw.Class="snap-none">
                    <StackPanel Spacing="12">
                        <Border Height="80" CornerRadius="10" tw:Tw.Class="bg-sky-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Row 1" /></Border>
                        <Border Height="80" CornerRadius="10" tw:Tw.Class="bg-emerald-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Row 2" /></Border>
                        <Border Height="80" CornerRadius="10" tw:Tw.Class="bg-amber-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Row 3" /></Border>
                        <Border Height="80" CornerRadius="10" tw:Tw.Class="bg-rose-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Row 4" /></Border>
                        <Border Height="80" CornerRadius="10" tw:Tw.Class="bg-violet-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Row 5" /></Border>
                        <Border Height="80" CornerRadius="10" tw:Tw.Class="bg-teal-500"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" tw:Tw.Class="text-white font-bold" Text="Row 6" /></Border>
                    </StackPanel>
                </ScrollViewer>
            </docs:DocsExample>
        </docs:DocsSection>
    </docs:DocsPage>
</UserControl>
