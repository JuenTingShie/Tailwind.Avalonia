<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Layout.FlexDirectionGap">
    <docs:DocsPage
        Section="Layout"
        Title="Direction and gap"
        Intro="Utilities for choosing how a panel lays out its children and how far apart they sit. They map to Avalonia&#x27;s panel Orientation and spacing properties."
        Supported="flex-row and flex-col set Orientation on StackPanel and WrapPanel. gap-&lt;n&gt;, gap-x-&lt;n&gt;, gap-y-&lt;n&gt;, space-x-&lt;n&gt; and space-y-&lt;n&gt; use the spacing scale (or an arbitrary value such as gap-[10px]) and land on the property the panel offers: StackPanel.Spacing along its stack axis, WrapPanel.ItemSpacing and LineSpacing, and Grid.ColumnSpacing and RowSpacing. A gap on the other axis of a StackPanel has nothing to space, so it is ignored, and elements without any spacing property ignore the token with a warning. Removing the classes restores the defaults. These are ordinary layout properties, so they behave the same on every target.">
        <docs:DocsPage.Utilities>
            <docs:UtilityReferenceRow ClassName="flex-row" AxamlStyle="Orientation: Horizontal" />
            <docs:UtilityReferenceRow ClassName="flex-col" AxamlStyle="Orientation: Vertical" />
            <docs:UtilityReferenceRow ClassName="gap-&lt;n&gt;" AxamlStyle="StackPanel.Spacing / WrapPanel.ItemSpacing+LineSpacing / Grid.ColumnSpacing+RowSpacing" />
            <docs:UtilityReferenceRow ClassName="gap-x-&lt;n&gt;" AxamlStyle="horizontal spacing" />
            <docs:UtilityReferenceRow ClassName="gap-y-&lt;n&gt;" AxamlStyle="vertical spacing" />
            <docs:UtilityReferenceRow ClassName="space-x-&lt;n&gt; / space-y-&lt;n&gt;" AxamlStyle="StackPanel.Spacing along that axis" />
        </docs:DocsPage.Utilities>
        <docs:DocsPage.Gaps>
            <docs:DocsGap Text="flex-row-reverse · flex-col-reverse · flex-wrap on a StackPanel · justify-* / items-* · space-x-reverse" />
        </docs:DocsPage.Gaps>

        <docs:DocsSection
            Heading="Direction and gap on panels"
            Summary="From top to bottom: a horizontal StackPanel with gap-2, a vertical one with gap-4, a WrapPanel with separate horizontal and vertical gaps and a two-column Grid with gap-2.">
            <docs:DocsExample>
                <StackPanel
                    Spacing="20">
                <StackPanel
                    docs:DocsCode.Show="True"
                    tw:Tw.Class="flex-row gap-2">
                    <Border
                        tw:Tw.Class="w-14 h-10 rounded-md bg-sky-600 p-2">
                        <TextBlock
                            Text="1" />
                    </Border>
                    <Border
                        tw:Tw.Class="w-14 h-10 rounded-md bg-sky-600 p-2">
                        <TextBlock
                            Text="2" />
                    </Border>
                    <Border
                        tw:Tw.Class="w-14 h-10 rounded-md bg-sky-600 p-2">
                        <TextBlock
                            Text="3" />
                    </Border>
                    <Border
                        tw:Tw.Class="w-14 h-10 rounded-md bg-sky-600 p-2">
                        <TextBlock
                            Text="4" />
                    </Border>
                </StackPanel>
                <StackPanel
                    docs:DocsCode.Show="True"
                    tw:Tw.Class="flex-col gap-4">
                    <Border
                        tw:Tw.Class="w-14 h-10 rounded-md bg-sky-600 p-2">
                        <TextBlock
                            Text="1" />
                    </Border>
                    <Border
                        tw:Tw.Class="w-14 h-10 rounded-md bg-sky-600 p-2">
                        <TextBlock
                            Text="2" />
                    </Border>
                    <Border
                        tw:Tw.Class="w-14 h-10 rounded-md bg-sky-600 p-2">
                        <TextBlock
                            Text="3" />
                    </Border>
                    <Border
                        tw:Tw.Class="w-14 h-10 rounded-md bg-sky-600 p-2">
                        <TextBlock
                            Text="4" />
                    </Border>
                </StackPanel>
                <WrapPanel
                    docs:DocsCode.Show="True"
                    tw:Tw.Class="w-48 gap-x-2 gap-y-4">
                    <Border
                        tw:Tw.Class="w-14 h-10 rounded-md bg-sky-600 p-2">
                        <TextBlock
                            Text="1" />
                    </Border>
                    <Border
                        tw:Tw.Class="w-14 h-10 rounded-md bg-sky-600 p-2">
                        <TextBlock
                            Text="2" />
                    </Border>
                    <Border
                        tw:Tw.Class="w-14 h-10 rounded-md bg-sky-600 p-2">
                        <TextBlock
                            Text="3" />
                    </Border>
                    <Border
                        tw:Tw.Class="w-14 h-10 rounded-md bg-sky-600 p-2">
                        <TextBlock
                            Text="4" />
                    </Border>
                    <Border
                        tw:Tw.Class="w-14 h-10 rounded-md bg-sky-600 p-2">
                        <TextBlock
                            Text="5" />
                    </Border>
                    <Border
                        tw:Tw.Class="w-14 h-10 rounded-md bg-sky-600 p-2">
                        <TextBlock
                            Text="6" />
                    </Border>
                </WrapPanel>
                <Grid
                    docs:DocsCode.Show="True"
                    tw:Tw.Class="w-40 gap-2"
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto">
                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        tw:Tw.Class="h-10 rounded-md bg-sky-600 p-2">
                        <TextBlock
                            Text="1" />
                    </Border>
                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        tw:Tw.Class="h-10 rounded-md bg-sky-600 p-2">
                        <TextBlock
                            Text="2" />
                    </Border>
                    <Border
                        Grid.Row="1"
                        Grid.Column="0"
                        tw:Tw.Class="h-10 rounded-md bg-sky-600 p-2">
                        <TextBlock
                            Text="3" />
                    </Border>
                    <Border
                        Grid.Row="1"
                        Grid.Column="1"
                        tw:Tw.Class="h-10 rounded-md bg-sky-600 p-2">
                        <TextBlock
                            Text="4" />
                    </Border>
                </Grid>
                </StackPanel>
            </docs:DocsExample>
        </docs:DocsSection>
    </docs:DocsPage>
</UserControl>
