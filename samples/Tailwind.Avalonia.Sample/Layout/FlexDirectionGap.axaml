<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Layout.FlexDirectionGap">
    <docs:DocsPage
        Section="Layout"
        Title="Direction and gap"
        Intro="Utilities for choosing how a panel lays out its children and how far apart they sit. They map to Avalonia&#x27;s panel Orientation and spacing properties.">
        <StackPanel
            Spacing="52">
            <StackPanel
                Classes="docs-overviewStack">
                <docs:DocsNote
                    Classes="supported"
                    Title="Implemented in this sample"
                    Body="flex-row and flex-col set Orientation on StackPanel and WrapPanel. gap-&lt;n&gt;, gap-x-&lt;n&gt;, gap-y-&lt;n&gt;, space-x-&lt;n&gt; and space-y-&lt;n&gt; use the spacing scale (or an arbitrary value such as gap-[10px]) and land on the property the panel offers: StackPanel.Spacing along its stack axis, WrapPanel.ItemSpacing and LineSpacing, and Grid.ColumnSpacing and RowSpacing. A gap on the other axis of a StackPanel has nothing to space, so it is ignored, and elements without any spacing property ignore the token with a warning. Removing the classes restores the defaults. These are ordinary layout properties, so they behave the same on every target." />
                <docs:DocsUtilityTable
                    x:Name="UtilityTable"
                    CollapsedRowCount="6" />
                <docs:DocsNote
                    Classes="gap"
                    Title="Not implemented yet"
                    Body="These forms sit outside the current parser surface.">
                    <StackPanel
                        Spacing="6">
                        <TextBlock
                            Classes="docs-tableClass"
                            Text="flex-row-reverse · flex-col-reverse · flex-wrap on a StackPanel · justify-* / items-* · space-x-reverse" />
                    </StackPanel>
                </docs:DocsNote>
            </StackPanel>

            <StackPanel
                Spacing="22">
                <TextBlock
                    Classes="docs-eyebrow"
                    Text="Examples" />
                <StackPanel
                    Classes="docs-exampleStack">
                    <docs:DocsSection
                        Heading="Direction and gap on panels"
                        Summary="From top to bottom: a horizontal StackPanel with gap-2, a vertical one with gap-4, a WrapPanel with separate horizontal and vertical gaps and a two-column Grid with gap-2.">
                        <docs:DocsExample>
                            <docs:DocsExample.Snippets>
                                <x:String>&lt;StackPanel tw:Tw.Class=&quot;flex-row gap-2&quot; /&gt;</x:String>
                                <x:String>&lt;StackPanel tw:Tw.Class=&quot;flex-col gap-4&quot; /&gt;</x:String>
                                <x:String>&lt;WrapPanel tw:Tw.Class=&quot;w-48 gap-x-2 gap-y-4&quot; /&gt;</x:String>
                                <x:String>&lt;Grid tw:Tw.Class=&quot;gap-2&quot; /&gt;</x:String>
                            </docs:DocsExample.Snippets>
                            <StackPanel
                                Spacing="20">
                            <StackPanel
                                tw:Tw.Class="flex-row gap-2">
                                <Border
                                    tw:Tw.Class="w-14 h-10 rounded-md bg-sky-600 p-2">
                                    <TextBlock
                                        Text="1" />
                                </Border>
                                <Border
                                    tw:Tw.Class="w-14 h-10 rounded-md bg-sky-600 p-2">
                                    <TextBlock
                                        Text="2" />
                                </Border>
                                <Border
                                    tw:Tw.Class="w-14 h-10 rounded-md bg-sky-600 p-2">
                                    <TextBlock
                                        Text="3" />
                                </Border>
                                <Border
                                    tw:Tw.Class="w-14 h-10 rounded-md bg-sky-600 p-2">
                                    <TextBlock
                                        Text="4" />
                                </Border>
                            </StackPanel>
                            <StackPanel
                                tw:Tw.Class="flex-col gap-4">
                                <Border
                                    tw:Tw.Class="w-14 h-10 rounded-md bg-sky-600 p-2">
                                    <TextBlock
                                        Text="1" />
                                </Border>
                                <Border
                                    tw:Tw.Class="w-14 h-10 rounded-md bg-sky-600 p-2">
                                    <TextBlock
                                        Text="2" />
                                </Border>
                                <Border
                                    tw:Tw.Class="w-14 h-10 rounded-md bg-sky-600 p-2">
                                    <TextBlock
                                        Text="3" />
                                </Border>
                                <Border
                                    tw:Tw.Class="w-14 h-10 rounded-md bg-sky-600 p-2">
                                    <TextBlock
                                        Text="4" />
                                </Border>
                            </StackPanel>
                            <WrapPanel
                                tw:Tw.Class="w-48 gap-x-2 gap-y-4">
                                <Border
                                    tw:Tw.Class="w-14 h-10 rounded-md bg-sky-600 p-2">
                                    <TextBlock
                                        Text="1" />
                                </Border>
                                <Border
                                    tw:Tw.Class="w-14 h-10 rounded-md bg-sky-600 p-2">
                                    <TextBlock
                                        Text="2" />
                                </Border>
                                <Border
                                    tw:Tw.Class="w-14 h-10 rounded-md bg-sky-600 p-2">
                                    <TextBlock
                                        Text="3" />
                                </Border>
                                <Border
                                    tw:Tw.Class="w-14 h-10 rounded-md bg-sky-600 p-2">
                                    <TextBlock
                                        Text="4" />
                                </Border>
                                <Border
                                    tw:Tw.Class="w-14 h-10 rounded-md bg-sky-600 p-2">
                                    <TextBlock
                                        Text="5" />
                                </Border>
                                <Border
                                    tw:Tw.Class="w-14 h-10 rounded-md bg-sky-600 p-2">
                                    <TextBlock
                                        Text="6" />
                                </Border>
                            </WrapPanel>
                            <Grid
                                tw:Tw.Class="w-40 gap-2"
                                ColumnDefinitions="*,*"
                                RowDefinitions="Auto,Auto">
                                <Border
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    tw:Tw.Class="h-10 rounded-md bg-sky-600 p-2">
                                    <TextBlock
                                        Text="1" />
                                </Border>
                                <Border
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    tw:Tw.Class="h-10 rounded-md bg-sky-600 p-2">
                                    <TextBlock
                                        Text="2" />
                                </Border>
                                <Border
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    tw:Tw.Class="h-10 rounded-md bg-sky-600 p-2">
                                    <TextBlock
                                        Text="3" />
                                </Border>
                                <Border
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    tw:Tw.Class="h-10 rounded-md bg-sky-600 p-2">
                                    <TextBlock
                                        Text="4" />
                                </Border>
                            </Grid>
                            </StackPanel>
                        </docs:DocsExample>
                    </docs:DocsSection>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </docs:DocsPage>
</UserControl>
