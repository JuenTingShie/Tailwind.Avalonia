<ResourceDictionary
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
     <x:String
           x:Key="SampleWindowTitle">Tailwind.Avalonia Docs Sample</x:String>
     <x:String
           x:Key="SampleDocsLibraryLabel">TAILWIND.AVALONIA</x:String>
     <x:String
           x:Key="SampleDocsExamplesEyebrow">EXAMPLES</x:String>
     <x:String
           x:Key="SampleDocsSupportNoteTitle">Implemented in this sample</x:String>
     <x:String
           x:Key="SampleDocsSupportNoteClass">bg-sky-950/35 border-sky-400/60</x:String>
     <x:String
           x:Key="SampleDocsSupportNoteTitleClass">text-sky-50</x:String>
     <x:String
           x:Key="SampleDocsSupportNoteBodyClass">text-sky-100/85</x:String>
     <x:String
           x:Key="SampleDocsLeftToRightLabel">Left-to-right</x:String>
     <x:String
           x:Key="SampleDocsRightToLeftLabel">Right-to-left</x:String>
     <x:String
           x:Key="SampleDocsPaddingTabTitle">Padding</x:String>
     <x:String
           x:Key="SampleDocsMarginTabTitle">Margin</x:String>
     <x:String
           x:Key="SamplePaddingPageTitle">Padding</x:String>
     <x:String
           x:Key="SamplePaddingPageDescription">Utilities for controlling an element&apos;s padding. This page mirrors the padding subset currently implemented in Tailwind.Avalonia and keeps the examples focused on real tw:Tw.Class usage.</x:String>
     <x:String
           x:Key="SamplePaddingSupportNote">Supported now: p, px, py, pt, pr, pb, pl, ps, pe, pbs, and pbe. Arbitrary values and responsive variants are intentionally left out until the parser supports them.</x:String>
     <x:String
           x:Key="SamplePaddingBasicTitle">Basic example</x:String>
     <x:String
           x:Key="SamplePaddingBasicDescription">Use p-&lt;number&gt; utilities like p-4 and p-8 to control padding on all sides of an element.</x:String>
     <x:String
           x:Key="SamplePaddingBasicCode">tw:Tw.Class=&quot;p-8&quot;</x:String>
     <x:String
           x:Key="SamplePaddingSideTitle">Adding padding to one side</x:String>
     <x:String
           x:Key="SamplePaddingSideDescription">Use pt-&lt;number&gt;, pr-&lt;number&gt;, pb-&lt;number&gt;, and pl-&lt;number&gt; utilities like pt-6 and pr-4 to control padding on one side of an element.</x:String>
     <x:String
           x:Key="SamplePaddingSideCode">tw:Tw.Class=&quot;pt-6 pr-4 pb-8 pl-2&quot;</x:String>
     <x:String
           x:Key="SamplePaddingAxisTitle">Adding horizontal and vertical padding</x:String>
     <x:String
           x:Key="SamplePaddingAxisDescription">Use px-&lt;number&gt; and py-&lt;number&gt; utilities like px-8 and py-8 to control axis-specific padding.</x:String>
     <x:String
           x:Key="SamplePaddingAxisCode">tw:Tw.Class=&quot;px-8&quot;    tw:Tw.Class=&quot;py-8&quot;</x:String>
     <x:String
           x:Key="SamplePaddingLogicalTitle">Using logical properties</x:String>
     <x:String
           x:Key="SamplePaddingLogicalDescription">Use ps-&lt;number&gt;, pe-&lt;number&gt;, pbs-&lt;number&gt;, and pbe-&lt;number&gt; utilities to map padding based on text direction and writing mode.</x:String>
     <x:String
           x:Key="SamplePaddingLogicalCode">tw:Tw.Class=&quot;ps-8 pe-8 pbs-8&quot;</x:String>
     <x:String
           x:Key="SampleMarginPageTitle">Margin</x:String>
     <x:String
           x:Key="SampleMarginPageDescription">Utilities for controlling the space around elements. This page focuses on the margin utilities that Tailwind.Avalonia already parses, including negative and logical variants.</x:String>
     <x:String
           x:Key="SampleMarginSupportNote">Supported now: m, mx, my, mt, mr, mb, ml, ms, me, mbs, and mbe, plus negative margin values. Auto margins, arbitrary values, and responsive variants are still outside the current parser scope.</x:String>
     <x:String
           x:Key="SampleMarginBasicTitle">Basic example</x:String>
     <x:String
           x:Key="SampleMarginBasicDescription">Use m-&lt;number&gt; utilities like m-4 and m-8 to control the outer space on all sides of an element.</x:String>
     <x:String
           x:Key="SampleMarginBasicCode">tw:Tw.Class=&quot;m-8&quot;</x:String>
     <x:String
           x:Key="SampleMarginSideTitle">Adding margin to one side</x:String>
     <x:String
           x:Key="SampleMarginSideDescription">Use mt-&lt;number&gt;, mr-&lt;number&gt;, mb-&lt;number&gt;, and ml-&lt;number&gt; utilities like mt-6 and mr-4 to control margin on one side of an element.</x:String>
     <x:String
           x:Key="SampleMarginSideCode">tw:Tw.Class=&quot;mt-6 mr-4 mb-8 ml-2&quot;</x:String>
     <x:String
           x:Key="SampleMarginAxisTitle">Adding horizontal and vertical margin</x:String>
     <x:String
           x:Key="SampleMarginAxisDescription">Use mx-&lt;number&gt; and my-&lt;number&gt; utilities like mx-8 and my-8 to control axis-specific margin.</x:String>
     <x:String
           x:Key="SampleMarginAxisCode">tw:Tw.Class=&quot;mx-8&quot;    tw:Tw.Class=&quot;my-8&quot;</x:String>
     <x:String
           x:Key="SampleMarginNegativeTitle">Using negative values</x:String>
     <x:String
           x:Key="SampleMarginNegativeDescription">Prefix a margin utility with a leading minus sign, like -mt-8, when you need elements to intentionally overlap.</x:String>
     <x:String
           x:Key="SampleMarginNegativeCode">tw:Tw.Class=&quot;-mt-8&quot;</x:String>
     <x:String
           x:Key="SampleMarginNegativeBaseLabel">base block</x:String>
     <x:String
           x:Key="SampleMarginNegativeOffsetLabel">-mt-8</x:String>
     <x:String
           x:Key="SampleMarginLogicalTitle">Using logical properties</x:String>
     <x:String
           x:Key="SampleMarginLogicalDescription">Use ms-&lt;number&gt;, me-&lt;number&gt;, mbs-&lt;number&gt;, and mbe-&lt;number&gt; utilities when margin should follow the current text direction or writing mode.</x:String>
     <x:String
           x:Key="SampleMarginLogicalCode">tw:Tw.Class=&quot;ms-8 me-8 mbs-8&quot;</x:String>
     <x:Double
           x:Key="SampleDocsTabMinWidth">176</x:Double>
     <x:Double
           x:Key="SampleDocsSectionSpacing">40</x:Double>
     <x:Double
           x:Key="SampleDocsSectionCardSpacing">16</x:Double>
     <x:Double
           x:Key="SampleDocsPreviewHeight">208</x:Double>
     <x:Double
           x:Key="SampleDocsTallPreviewHeight">352</x:Double>
     <x:Double
           x:Key="SampleDocsCompactPreviewHeight">176</x:Double>
     <Thickness
           x:Key="SampleDocsShellMargin">28</Thickness>
     <Thickness
           x:Key="SampleDocsContentMargin">28,24,40,32</Thickness>
     <Thickness
           x:Key="SampleDocsCodePadding">20,16</Thickness>
     <CornerRadius
           x:Key="SampleDocsSurfaceCornerRadius">20</CornerRadius>
     <CornerRadius
           x:Key="SampleDocsInnerCornerRadius">16</CornerRadius>
     <CornerRadius
           x:Key="SampleDocsChipCornerRadius">12</CornerRadius>
</ResourceDictionary>