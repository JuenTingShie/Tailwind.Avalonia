<ResourceDictionary
     xmlns="https://github.com/avaloniaui"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:String
         x:Key="SampleWindowTitle">Tailwind.Avalonia.Sample</x:String>
    <x:String
         x:Key="SampleShowcaseTitle">Tailwind.Avalonia spacing + color tokens</x:String>
    <x:String
         x:Key="SampleStaticSpacingDescription">StaticResource: Padding4 + BrushBlue700</x:String>
    <x:String
         x:Key="SampleUtilitySpacingClass">p-6 mx-4 py-4</x:String>
    <x:String
         x:Key="SampleUtilitySpacingDescription">tw:Tw.Class=&apos;p-6 mx-4 py-4&apos; + BrushGreen800</x:String>
    <x:String
         x:Key="SampleLogicalSpacingClass">ps-6 pe-2 py-4</x:String>
    <x:String
         x:Key="SampleLogicalSpacingDescription">Logical parser: ps-6 pe-2 py-4 (RTL) + BrushOrange800</x:String>
    <x:Double
         x:Key="SampleShowcaseSpacing">20</x:Double>
    <x:Double
         x:Key="SampleTitleFontSize">24</x:Double>
    <CornerRadius
         x:Key="SampleCardCornerRadius">12</CornerRadius>
</ResourceDictionary>