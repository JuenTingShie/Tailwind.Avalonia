<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="1440"
    d:DesignHeight="920"
    x:Class="Tailwind.Avalonia.Sample.SampleShell">
    <UserControl.Styles>
        <Style
            Selector="TabStripItem">
            <Setter
                Property="MinWidth"
                Value="176" />
            <Setter
                Property="Margin"
                Value="0,0,16,8" />
            <Setter
                Property="Padding"
                Value="18,16" />
            <Setter
                Property="FontSize"
                Value="15" />
            <Setter
                Property="FontWeight"
                Value="SemiBold" />
            <Setter
                Property="Foreground"
                Value="{StaticResource BrushSlate400}" />
            <Setter
                Property="Background"
                Value="{StaticResource BrushSlate900}" />
            <Setter
                Property="BorderBrush"
                Value="{StaticResource BrushSlate800}" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="HorizontalContentAlignment"
                Value="Left" />
        </Style>
        <Style
            Selector="TabStripItem:selected">
            <Setter
                Property="Foreground"
                Value="{StaticResource BrushWhite}" />
            <Setter
                Property="Background"
                Value="{StaticResource BrushSlate800}" />
            <Setter
                Property="BorderBrush"
                Value="{StaticResource BrushSlate700}" />
        </Style>
    </UserControl.Styles>
    <Grid
        Background="{StaticResource BrushSlate950}">
        <Grid
            Margin="28"
            ColumnDefinitions="Auto,Auto,*"
            ColumnSpacing="24">
            <TabStrip
                x:Name="SectionTabStrip"
                Grid.Column="0">
                <TabStrip.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel
                            Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </TabStrip.ItemsPanel>
                <TabStrip.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Text="{ReflectionBinding Header}" />
                    </DataTemplate>
                </TabStrip.ItemTemplate>
            </TabStrip>
            <TabStrip
                x:Name="PageTabStrip"
                Grid.Column="1">
                <TabStrip.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel
                            Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </TabStrip.ItemsPanel>
                <TabStrip.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Text="{ReflectionBinding Header}" />
                    </DataTemplate>
                </TabStrip.ItemTemplate>
            </TabStrip>
            <Grid
                x:Name="PageHost"
                Grid.Column="2"
                ClipToBounds="True" />
        </Grid>
    </Grid>
</UserControl>