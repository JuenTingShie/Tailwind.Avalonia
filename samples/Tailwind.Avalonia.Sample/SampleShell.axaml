<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignWidth="1440"
    d:DesignHeight="920"
    x:Class="Tailwind.Avalonia.Sample.SampleShell">
    <UserControl.Resources>
        <StreamGeometry x:Key="HamburgerIconGeometry">M4,5 H20 V7 H4 Z M4,11 H20 V13 H4 Z M4,17 H20 V19 H4 Z</StreamGeometry>
        <StreamGeometry x:Key="CloseIconGeometry">M17.5 4C17.2239 4 17 4.22386 17 4.5V15.5C17 15.7761 17.2239 16 17.5 16C17.7761 16 18 15.7761 18 15.5V4.5C18 4.22386 17.7761 4 17.5 4Z M15 10C15 9.72386 14.7761 9.5 14.5 9.5H3.70711L6.8536 6.35355C7.0488 6.15829 7.0488 5.84171 6.8536 5.64645C6.6583 5.45118 6.3417 5.45118 6.1464 5.64645L2.1464 9.64645C2.09389 9.69898 2.05551 9.76028 2.03125 9.82563C2.01104 9.87992 2 9.93867 2 10C2 10.0613 2.01104 10.1201 2.03125 10.1744C2.05551 10.2397 2.09389 10.301 2.1464 10.3536L6.1464 14.3536C6.3417 14.5488 6.6583 14.5488 6.8536 14.3536C7.0488 14.1583 7.0488 13.8417 6.8536 13.6465L3.7071 10.5H14.5C14.7761 10.5 15 10.2761 15 10Z</StreamGeometry>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style
            Selector="Border.shell-paneSurface">
            <Setter
                Property="Background"
                Value="#F80B1120" />
            <Setter
                Property="BorderBrush"
                Value="{StaticResource BrushSlate800}" />
            <Setter
                Property="BorderThickness"
                Value="0,0,1,0" />
            <Setter
                Property="CornerRadius"
                Value="0" />
            <Setter
                Property="ClipToBounds"
                Value="True" />
        </Style>
        <Style
            Selector="Border.shell-navGroup">
            <Setter
                Property="Background"
                Value="{StaticResource BrushSlate950}" />
            <Setter
                Property="BorderBrush"
                Value="{StaticResource BrushSlate800}" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="CornerRadius"
                Value="22" />
            <Setter
                Property="Padding"
                Value="14" />
        </Style>
        <Style
            Selector="Border.shell-headerSurface">
            <Setter
                Property="Background"
                Value="#F80B1120" />
            <Setter
                Property="BorderBrush"
                Value="{StaticResource BrushSlate800}" />
            <Setter
                Property="BorderThickness"
                Value="0,0,0,1" />
            <Setter
                Property="CornerRadius"
                Value="0" />
            <Setter
                Property="Padding"
                Value="12,0" />
        </Style>
        <Style
            Selector="Border.shell-contentFrame">
            <Setter
                Property="Background"
                Value="#660F172A" />
            <Setter
                Property="BorderBrush"
                Value="{StaticResource BrushSlate800}" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="CornerRadius"
                Value="28" />
            <Setter
                Property="ClipToBounds"
                Value="True" />
        </Style>
        <Style
            Selector="Button.shell-toggle">
            <Setter
                Property="Background"
                Value="{StaticResource BrushSlate900}" />
            <Setter
                Property="BorderBrush"
                Value="{StaticResource BrushSlate700}" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="Foreground"
                Value="{StaticResource BrushWhite}" />
            <Setter
                Property="Width"
                Value="46" />
            <Setter
                Property="Height"
                Value="46" />
            <Setter
                Property="Padding"
                Value="0" />
            <Setter
                Property="CornerRadius"
                Value="16" />
            <Setter
                Property="FontWeight"
                Value="Bold" />
            <Setter
                Property="HorizontalContentAlignment"
                Value="Center" />
            <Setter
                Property="VerticalContentAlignment"
                Value="Center" />
        </Style>
        <Style
            Selector="Button.shell-toggle.accent">
            <Setter
                Property="Background"
                Value="#991D4ED8" />
            <Setter
                Property="BorderBrush"
                Value="#FF60A5FA" />
        </Style>
        <Style
            Selector="Button.shell-toggle:pointerover">
            <Setter
                Property="Opacity"
                Value="0.92" />
        </Style>
        <Style
            Selector="Button.shell-toggle:pressed">
            <Setter
                Property="Opacity"
                Value="0.82" />
        </Style>
        <Style
            Selector="TextBlock.shell-navLabel">
            <Setter
                Property="Foreground"
                Value="{StaticResource BrushSlate500}" />
            <Setter
                Property="FontSize"
                Value="11" />
            <Setter
                Property="FontWeight"
                Value="Bold" />
        </Style>
        <Style
            Selector="TextBlock.shell-currentSection">
            <Setter
                Property="Foreground"
                Value="{StaticResource BrushSky300}" />
            <Setter
                Property="FontSize"
                Value="11" />
            <Setter
                Property="FontWeight"
                Value="Bold" />
        </Style>
        <Style
            Selector="TextBlock.shell-currentPage">
            <Setter
                Property="Foreground"
                Value="{StaticResource BrushWhite}" />
            <Setter
                Property="FontSize"
                Value="18" />
            <Setter
                Property="FontWeight"
                Value="SemiBold" />
        </Style>
        <Style
            Selector="TabStrip.navigation-strip TabStripItem">
            <Setter
                Property="MinWidth"
                Value="0" />
            <Setter
                Property="Margin"
                Value="0,0,0,8" />
            <Setter
                Property="Padding"
                Value="16,14" />
            <Setter
                Property="FontSize"
                Value="14" />
            <Setter
                Property="FontWeight"
                Value="SemiBold" />
            <Setter
                Property="Foreground"
                Value="{StaticResource BrushSlate400}" />
            <Setter
                Property="Background"
                Value="#CC0F172A" />
            <Setter
                Property="BorderBrush"
                Value="{StaticResource BrushSlate800}" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="HorizontalAlignment"
                Value="Stretch" />
            <Setter
                Property="HorizontalContentAlignment"
                Value="Left" />
        </Style>
        <Style
            Selector="TabStrip.navigation-strip TabStripItem:pointerover">
            <Setter
                Property="Foreground"
                Value="{StaticResource BrushWhite}" />
            <Setter
                Property="Background"
                Value="#DD1E293B" />
            <Setter
                Property="BorderBrush"
                Value="{StaticResource BrushSlate700}" />
        </Style>
        <Style
            Selector="TabStrip.navigation-strip TabStripItem:selected">
            <Setter
                Property="Foreground"
                Value="{StaticResource BrushWhite}" />
            <Setter
                Property="Background"
                Value="#DD1E293B" />
            <Setter
                Property="BorderBrush"
                Value="{StaticResource BrushSky500}" />
        </Style>
        <Style
            Selector="TabStrip.navigation-strip.section-strip TabStripItem">
            <Setter
                Property="Padding"
                Value="18,16" />
            <Setter
                Property="FontSize"
                Value="15" />
        </Style>
        <Style
            Selector="TabStrip.navigation-strip.section-strip TabStripItem:selected">
            <Setter
                Property="Background"
                Value="#CC172554" />
            <Setter
                Property="BorderBrush"
                Value="{StaticResource BrushSky400}" />
        </Style>
        <Style
            Selector="TabStrip.navigation-strip.page-strip TabStripItem">
            <Setter
                Property="Margin"
                Value="12,0,0,8" />
            <Setter
                Property="Padding"
                Value="14,12" />
            <Setter
                Property="FontSize"
                Value="13" />
            <Setter
                Property="Background"
                Value="#88020617" />
        </Style>
        <Style
            Selector="TabStrip.navigation-strip.page-strip TabStripItem:selected">
            <Setter
                Property="Background"
                Value="#66312E81" />
            <Setter
                Property="BorderBrush"
                Value="{StaticResource BrushViolet400}" />
        </Style>
    </UserControl.Styles>
    <SplitView
        x:Name="NavigationSplitView"
        Background="{StaticResource BrushSlate950}"
        CompactPaneLength="0"
        DisplayMode="Overlay"
        IsPaneOpen="False"
        OpenPaneLength="336"
        PanePlacement="Left">
        <SplitView.Pane>
            <Grid
                Background="Transparent"
                Margin="0">
                <Border
                    Classes="shell-paneSurface">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel
                            Margin="16"
                            Spacing="18">
                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="12">
                                <Button
                                    x:Name="PaneCloseButton"
                                    Classes="shell-toggle"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    ToolTip.Tip="Hide navigation"
                                    VerticalAlignment="Top">
                                    <PathIcon
                                        Data="{StaticResource CloseIconGeometry}"
                                        Height="18"
                                        Width="18" />
                                </Button>
                            </Grid>

                            <Border
                                Classes="shell-navGroup">
                                <StackPanel
                                    Spacing="10">
                                    <TextBlock
                                        Classes="shell-navLabel"
                                        Text="SECTIONS" />
                                    <TabStrip
                                        x:Name="SectionTabStrip"
                                        Classes="navigation-strip section-strip">
                                        <TabStrip.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel
                                                    Orientation="Vertical" />
                                            </ItemsPanelTemplate>
                                        </TabStrip.ItemsPanel>
                                        <TabStrip.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    Text="{ReflectionBinding Header}"
                                                    TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </TabStrip.ItemTemplate>
                                    </TabStrip>
                                </StackPanel>
                            </Border>

                            <Border
                                Classes="shell-navGroup">
                                <StackPanel
                                    Spacing="10">
                                    <TextBlock
                                        Classes="shell-navLabel"
                                        Text="PAGES" />
                                    <TabStrip
                                        x:Name="PageTabStrip"
                                        Classes="navigation-strip page-strip">
                                        <TabStrip.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel
                                                    Orientation="Vertical" />
                                            </ItemsPanelTemplate>
                                        </TabStrip.ItemsPanel>
                                        <TabStrip.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    Text="{ReflectionBinding Header}"
                                                    TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </TabStrip.ItemTemplate>
                                    </TabStrip>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </SplitView.Pane>

        <SplitView.Content>
            <Grid
                Background="{StaticResource BrushSlate950}"
                ClipToBounds="True"
                RowDefinitions="Auto,*">
                <Border
                    x:Name="ShellHeader"
                    Classes="shell-headerSurface"
                    Margin="0">
                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="12"
                        MinHeight="44">
                        <Button
                            x:Name="PaneToggleButton"
                            Classes="shell-toggle"
                            Margin="0,6,0,6"
                            HorizontalAlignment="Left"
                            ToolTip.Tip="Show navigation"
                            VerticalAlignment="Center">
                            <PathIcon
                                Data="{StaticResource HamburgerIconGeometry}"
                                Height="18"
                                Width="18" />
                        </Button>
                        <Grid
                            Grid.Column="1"
                            ColumnDefinitions="Auto,Auto,*"
                            ColumnSpacing="10"
                            VerticalAlignment="Center">
                            <TextBlock
                                x:Name="CurrentSectionText"
                                Classes="shell-currentSection"
                                Text="SECTION"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="1"
                                Foreground="{StaticResource BrushSlate600}"
                                Text="/"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="CurrentPageText"
                                Grid.Column="2"
                                Classes="shell-currentPage"
                                Text="Page"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    x:Name="PageContentChrome"
                    Classes="shell-contentFrame"
                    Grid.Row="1"
                    Margin="12"
                    Padding="20">
                    <Grid
                        x:Name="PageHost"
                        ClipToBounds="True" />
                </Border>
            </Grid>
        </SplitView.Content>
    </SplitView>
</UserControl>
