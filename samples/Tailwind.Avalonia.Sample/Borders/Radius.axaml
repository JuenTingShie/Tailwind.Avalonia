<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Borders.Radius">
    <docs:DocsPage
        Section="Borders"
        Title="Radius"
        Intro="Utilities for controlling the border radius of an element. rounded-* folds a fixed named scale, physical sides, physical corners, and bracket arbitrary values into Avalonia's CornerRadius."
        Supported="rounded-* maps the named scale (none, xs, sm, md, lg, xl, 2xl, 3xl, 4xl, full), physical sides (rounded-t/r/b/l-*), physical corners (rounded-tl/tr/br/bl-*), and bracket arbitrary values like rounded-[6px] onto CornerRadius. Logical properties, custom properties, and responsive or hover/focus variants are still out of scope."
        GapsBody="These Tailwind border-radius rows remain outside the current parser surface.">
        <docs:DocsPage.Utilities>
            <docs:UtilityReferenceRow ClassName="rounded" AxamlStyle="&lt;Border CornerRadius=&quot;4&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="rounded-none" AxamlStyle="&lt;Border CornerRadius=&quot;0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="rounded-xs" AxamlStyle="&lt;Border CornerRadius=&quot;2&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="rounded-sm" AxamlStyle="&lt;Border CornerRadius=&quot;4&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="rounded-md" AxamlStyle="&lt;Border CornerRadius=&quot;6&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="rounded-lg" AxamlStyle="&lt;Border CornerRadius=&quot;8&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="rounded-xl" AxamlStyle="&lt;Border CornerRadius=&quot;12&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="rounded-2xl" AxamlStyle="&lt;Border CornerRadius=&quot;16&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="rounded-3xl" AxamlStyle="&lt;Border CornerRadius=&quot;24&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="rounded-4xl" AxamlStyle="&lt;Border CornerRadius=&quot;32&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="rounded-full" AxamlStyle="&lt;Border CornerRadius=&quot;9999&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="rounded-[&lt;value&gt;]" AxamlStyle="&lt;Border CornerRadius=&quot;&lt;parsed value&gt;&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="rounded-t-&lt;name&gt;" AxamlStyle="&lt;Border CornerRadius=&quot;&lt;v&gt;,&lt;v&gt;,0,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="rounded-t-[&lt;value&gt;]" AxamlStyle="&lt;Border CornerRadius=&quot;&lt;parsed&gt;,&lt;parsed&gt;,0,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="rounded-r-&lt;name&gt;" AxamlStyle="&lt;Border CornerRadius=&quot;0,&lt;v&gt;,&lt;v&gt;,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="rounded-r-[&lt;value&gt;]" AxamlStyle="&lt;Border CornerRadius=&quot;0,&lt;parsed&gt;,&lt;parsed&gt;,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="rounded-b-&lt;name&gt;" AxamlStyle="&lt;Border CornerRadius=&quot;0,0,&lt;v&gt;,&lt;v&gt;&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="rounded-b-[&lt;value&gt;]" AxamlStyle="&lt;Border CornerRadius=&quot;0,0,&lt;parsed&gt;,&lt;parsed&gt;&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="rounded-l-&lt;name&gt;" AxamlStyle="&lt;Border CornerRadius=&quot;&lt;v&gt;,0,0,&lt;v&gt;&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="rounded-l-[&lt;value&gt;]" AxamlStyle="&lt;Border CornerRadius=&quot;&lt;parsed&gt;,0,0,&lt;parsed&gt;&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="rounded-tl-&lt;name&gt;" AxamlStyle="&lt;Border CornerRadius=&quot;&lt;v&gt;,0,0,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="rounded-tl-[&lt;value&gt;]" AxamlStyle="&lt;Border CornerRadius=&quot;&lt;parsed&gt;,0,0,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="rounded-tr-&lt;name&gt;" AxamlStyle="&lt;Border CornerRadius=&quot;0,&lt;v&gt;,0,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="rounded-tr-[&lt;value&gt;]" AxamlStyle="&lt;Border CornerRadius=&quot;0,&lt;parsed&gt;,0,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="rounded-br-&lt;name&gt;" AxamlStyle="&lt;Border CornerRadius=&quot;0,0,&lt;v&gt;,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="rounded-br-[&lt;value&gt;]" AxamlStyle="&lt;Border CornerRadius=&quot;0,0,&lt;parsed&gt;,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="rounded-bl-&lt;name&gt;" AxamlStyle="&lt;Border CornerRadius=&quot;0,0,0,&lt;v&gt;&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="rounded-bl-[&lt;value&gt;]" AxamlStyle="&lt;Border CornerRadius=&quot;0,0,0,&lt;parsed&gt;&quot; /&gt;" />
        </docs:DocsPage.Utilities>
        <docs:DocsPage.Gaps>
            <docs:DocsGap Text="rounded-(&lt;custom-property&gt;) · md:rounded-lg (responsive) · hover:rounded-* · focus:rounded-*" />
        </docs:DocsPage.Gaps>

        <docs:DocsSection
            Heading="Basic example"
            Summary="Use rounded-sm, rounded-md, rounded-lg, or rounded-xl to apply different border radius sizes to an element.">
            <docs:DocsExample>
                <Border
                    Classes="docs-inset"
                    HorizontalAlignment="Left"
                    tw:Tw.Class="p-5">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="18">
                        <Border
                            docs:DocsCode.Show="True"
                            tw:Tw.Class="bg-sky-500 rounded-sm w-20 h-20">
                            <docs:DocsChip OnColor="True" Text="sm" />
                        </Border>
                        <Border
                            docs:DocsCode.Show="True"
                            tw:Tw.Class="bg-violet-500 rounded-md w-20 h-20">
                            <docs:DocsChip OnColor="True" Text="md" />
                        </Border>
                        <Border
                            docs:DocsCode.Show="True"
                            tw:Tw.Class="bg-emerald-500 rounded-lg w-20 h-20">
                            <docs:DocsChip OnColor="True" Text="lg" />
                        </Border>
                        <Border
                            docs:DocsCode.Show="True"
                            tw:Tw.Class="bg-amber-500 rounded-xl w-20 h-20">
                            <docs:DocsChip OnColor="True" Text="xl" />
                        </Border>
                    </StackPanel>
                </Border>
            </docs:DocsExample>
        </docs:DocsSection>

        <docs:DocsSection
            Heading="Rounding sides separately"
            Summary="Use rounded-t-&lt;name&gt;, rounded-r-&lt;name&gt;, rounded-b-&lt;name&gt;, and rounded-l-&lt;name&gt; to only round the two corners on one side of an element.">
            <docs:DocsExample>
                <Border
                    Classes="docs-inset"
                    HorizontalAlignment="Left"
                    tw:Tw.Class="p-5">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="18">
                        <Border
                            docs:DocsCode.Show="True"
                            tw:Tw.Class="bg-sky-500 rounded-t-lg w-20 h-20">
                            <docs:DocsChip OnColor="True" Text="t" />
                        </Border>
                        <Border
                            docs:DocsCode.Show="True"
                            tw:Tw.Class="bg-violet-500 rounded-r-lg w-20 h-20">
                            <docs:DocsChip OnColor="True" Text="r" />
                        </Border>
                        <Border
                            docs:DocsCode.Show="True"
                            tw:Tw.Class="bg-emerald-500 rounded-b-lg w-20 h-20">
                            <docs:DocsChip OnColor="True" Text="b" />
                        </Border>
                        <Border
                            docs:DocsCode.Show="True"
                            tw:Tw.Class="bg-amber-500 rounded-l-lg w-20 h-20">
                            <docs:DocsChip OnColor="True" Text="l" />
                        </Border>
                    </StackPanel>
                </Border>
            </docs:DocsExample>
        </docs:DocsSection>

        <docs:DocsSection
            Heading="Rounding corners separately"
            Summary="Use rounded-tl-&lt;name&gt;, rounded-tr-&lt;name&gt;, rounded-br-&lt;name&gt;, and rounded-bl-&lt;name&gt; to only round a single corner of an element.">
            <docs:DocsExample>
                <Border
                    Classes="docs-inset"
                    HorizontalAlignment="Left"
                    tw:Tw.Class="p-5">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="18">
                        <Border
                            docs:DocsCode.Show="True"
                            tw:Tw.Class="bg-sky-500 rounded-tl-lg w-20 h-20">
                            <docs:DocsChip OnColor="True" Text="tl" />
                        </Border>
                        <Border
                            docs:DocsCode.Show="True"
                            tw:Tw.Class="bg-violet-500 rounded-tr-lg w-20 h-20">
                            <docs:DocsChip OnColor="True" Text="tr" />
                        </Border>
                        <Border
                            docs:DocsCode.Show="True"
                            tw:Tw.Class="bg-emerald-500 rounded-br-lg w-20 h-20">
                            <docs:DocsChip OnColor="True" Text="br" />
                        </Border>
                        <Border
                            docs:DocsCode.Show="True"
                            tw:Tw.Class="bg-amber-500 rounded-bl-lg w-20 h-20">
                            <docs:DocsChip OnColor="True" Text="bl" />
                        </Border>
                    </StackPanel>
                </Border>
            </docs:DocsExample>
        </docs:DocsSection>

        <docs:DocsSection
            Heading="Using logical properties"
            Summary="Tailwind ships rounded-s-*, rounded-e-*, rounded-ss-*, rounded-se-*, rounded-es-*, and rounded-ee-* to set radius using logical start/end sides that flip with text direction. This parser does not implement them yet — rounded-t-*/r-*/b-*/l-* and rounded-tl-*/tr-*/br-*/bl-* only resolve to physical corners, so a value set for LTR stays put under RightToLeft FlowDirection.">
            <docs:DocsNote
                Classes="gap"
                Title="Logical radius mapping (not implemented)">
                <StackPanel
                    Spacing="6">
                    <TextBlock
                        Classes="docs-tableClass"
                        Text="rounded-s-lg → LTR: top-left + bottom-left · RTL: top-right + bottom-right" />
                    <TextBlock
                        Classes="docs-tableClass"
                        Text="rounded-e-lg → LTR: top-right + bottom-right · RTL: top-left + bottom-left" />
                    <TextBlock
                        Classes="docs-tableClass"
                        Text="rounded-ss-lg → LTR: top-left · RTL: top-right" />
                    <TextBlock
                        Classes="docs-tableClass"
                        Text="rounded-se-lg → LTR: top-right · RTL: top-left" />
                    <TextBlock
                        Classes="docs-tableClass"
                        Text="rounded-es-lg → LTR: bottom-left · RTL: bottom-right" />
                    <TextBlock
                        Classes="docs-tableClass"
                        Text="rounded-ee-lg → LTR: bottom-right · RTL: bottom-left" />
                </StackPanel>
            </docs:DocsNote>
        </docs:DocsSection>

        <docs:DocsSection
            Heading="Creating pill buttons"
            Summary="Use rounded-full to create pill buttons, useful for things like navigation items or badges.">
            <docs:DocsExample>
                <Border
                    Classes="docs-inset"
                    HorizontalAlignment="Left"
                    tw:Tw.Class="p-5">
                    <Button
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="bg-sky-500 text-white rounded-full px-5 py-2.5"
                        Content="Save Changes" />
                </Border>
            </docs:DocsExample>
        </docs:DocsSection>

        <docs:DocsSection
            Heading="Removing the border radius"
            Summary="Use rounded-none to remove an existing border radius from an element.">
            <docs:DocsExample>
                <Border
                    Classes="docs-inset"
                    HorizontalAlignment="Left"
                    tw:Tw.Class="p-5">
                    <Button
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="bg-sky-500 text-white rounded-none px-5 py-2.5"
                        Content="Save Changes" />
                </Border>
            </docs:DocsExample>
        </docs:DocsSection>

        <docs:DocsSection
            Heading="Using a custom value"
            Summary="Bracket syntax like rounded-[6px] takes a direct arbitrary value.">
            <StackPanel
                Spacing="18">
                <docs:DocsNote
                    Title="How arbitrary radius resolves">
                    <StackPanel
                        Spacing="8">
                        <TextBlock
                            Classes="docs-tableClass"
                            Text="px · rem · em · unitless" />
                        <TextBlock
                            Classes="docs-noteBody"
                            Text="Arbitrary radius values are parser-only and emit no generated package keys." />
                        <TextBlock
                            Classes="docs-noteBody"
                            Text="rem and em resolve against a 16px base. Unitless values are treated as px." />
                        <TextBlock
                            Classes="docs-noteBody"
                            Text="Only bracket syntax is parsed; rounded-(&lt;custom-property&gt;) stays unsupported." />
                    </StackPanel>
                </docs:DocsNote>
                <docs:DocsExample>
                    <Border
                        Classes="docs-inset"
                        HorizontalAlignment="Left"
                        tw:Tw.Class="p-5">
                        <Border
                            docs:DocsCode.Show="True"
                            tw:Tw.Class="bg-sky-500 rounded-[6px] w-20 h-20">
                            <docs:DocsChip OnColor="True" Text="[6px]" />
                        </Border>
                    </Border>
                </docs:DocsExample>
            </StackPanel>
        </docs:DocsSection>
    </docs:DocsPage>
</UserControl>
