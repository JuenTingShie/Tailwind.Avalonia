<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:media="clr-namespace:Avalonia.Media;assembly=Avalonia.Base"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Spacing.Padding">
    <docs:DocsPage
        Section="Spacing"
        Title="Padding"
        Intro="Utilities for controlling an element&apos;s padding. The parser folds the shared spacing scale and bracket arbitrary values into Avalonia&apos;s Padding thickness, including the logical inline and block edges.">
        <StackPanel
            Spacing="52">
            <StackPanel
                Classes="docs-overviewStack">
                <docs:DocsNote
                    Classes="supported"
                    Title="Implemented in this sample"
                    Body="p-&lt;number&gt; sets padding on all sides; px-*/py-* target an axis, pt/pr/pb/pl-* target one physical side, and the logical ps/pe-*, pbs/pbe-*, and visual psv/pev-* variants map to inline/block or final-rendered sides. Bracket arbitrary values like p-[12px] take a direct value. Custom properties, such as p-(&lt;custom-property&gt;) and its per-side forms, are still out of scope." />
                <docs:DocsUtilityTable
                    x:Name="UtilityTable"
                    CollapsedRowCount="6" />
                <docs:DocsNote
                    Classes="gap"
                    Title="Not implemented yet"
                    Body="These Tailwind padding rows remain outside the current parser surface.">
                    <StackPanel
                        Spacing="6">
                        <TextBlock
                            Classes="docs-tableClass"
                            Text="p-(&lt;custom-property&gt;) · px-(&lt;custom-property&gt;) · py-(&lt;custom-property&gt;) · pt-(&lt;custom-property&gt;) · pr-(&lt;custom-property&gt;) · pb-(&lt;custom-property&gt;) · pl-(&lt;custom-property&gt;)" />
                    </StackPanel>
                </docs:DocsNote>
            </StackPanel>

            <StackPanel
                Spacing="22">
                <TextBlock
                    Classes="docs-eyebrow"
                    Text="Examples" />
                <StackPanel
                    Classes="docs-exampleStack">
                    <docs:DocsSection
                        Heading="Basic example"
                        Summary="Use p-&lt;number&gt; utilities like p-4 and p-8 to control padding on all sides of an element.">
                        <docs:DocsExample
                            Code="&lt;Border tw:Tw.Class=&quot;p-8&quot; /&gt;">
                            <Border
                                Classes="docs-paddingShell"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                tw:Tw.Class="p-8">
                                <Border
                                    Classes="docs-paddingCore">
                                    <Grid
                                        tw:Tw.Class="min-w-24 min-h-14">
                                        <TextBlock
                                            Classes="docs-chip"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="p-8" />
                                    </Grid>
                                </Border>
                            </Border>
                        </docs:DocsExample>
                    </docs:DocsSection>

                    <docs:DocsSection
                        Heading="Adding padding to one side"
                        Summary="Use pt-&lt;number&gt;, pr-&lt;number&gt;, pb-&lt;number&gt;, and pl-&lt;number&gt; utilities like pt-6 and pr-4 to control padding on one side of an element.">
                        <docs:DocsExample>
                            <docs:DocsExample.Snippets>
                                <x:String>&lt;Border tw:Tw.Class="pt-6" /&gt;</x:String>
                                <x:String>&lt;Border tw:Tw.Class="pr-4" /&gt;</x:String>
                                <x:String>&lt;Border tw:Tw.Class="pb-8" /&gt;</x:String>
                                <x:String>&lt;Border tw:Tw.Class="pl-2" /&gt;</x:String>
                            </docs:DocsExample.Snippets>
                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="18">
                                <Border
                                    Classes="docs-paddingShell"
                                    tw:Tw.Class="pt-6">
                                    <Border
                                        Classes="docs-paddingCore">
                                        <Grid
                                            tw:Tw.Class="min-w-[84px] min-h-[52px]">
                                            <TextBlock
                                                Classes="docs-chip"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="pt-6" />
                                        </Grid>
                                    </Border>
                                </Border>
                                <Border
                                    Classes="docs-paddingShell"
                                    tw:Tw.Class="pr-4">
                                    <Border
                                        Classes="docs-paddingCore">
                                        <Grid
                                            tw:Tw.Class="min-w-[84px] min-h-[52px]">
                                            <TextBlock
                                                Classes="docs-chip"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="pr-4" />
                                        </Grid>
                                    </Border>
                                </Border>
                                <Border
                                    Classes="docs-paddingShell"
                                    tw:Tw.Class="pb-8">
                                    <Border
                                        Classes="docs-paddingCore">
                                        <Grid
                                            tw:Tw.Class="min-w-[84px] min-h-[52px]">
                                            <TextBlock
                                                Classes="docs-chip"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="pb-8" />
                                        </Grid>
                                    </Border>
                                </Border>
                                <Border
                                    Classes="docs-paddingShell"
                                    tw:Tw.Class="pl-2">
                                    <Border
                                        Classes="docs-paddingCore">
                                        <Grid
                                            tw:Tw.Class="min-w-[84px] min-h-[52px]">
                                            <TextBlock
                                                Classes="docs-chip"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="pl-2" />
                                        </Grid>
                                    </Border>
                                </Border>
                            </StackPanel>
                        </docs:DocsExample>
                    </docs:DocsSection>

                    <docs:DocsSection
                        Heading="Adding horizontal and vertical padding"
                        Summary="Use px-&lt;number&gt; and py-&lt;number&gt; utilities like px-8 and py-8 to control axis-specific padding.">
                        <docs:DocsExample>
                            <docs:DocsExample.Snippets>
                                <x:String>&lt;Border tw:Tw.Class="px-8" /&gt;</x:String>
                                <x:String>&lt;Border tw:Tw.Class="py-8" /&gt;</x:String>
                            </docs:DocsExample.Snippets>
                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="24">
                                <Border
                                    Classes="docs-paddingShell"
                                    tw:Tw.Class="px-8">
                                    <Border
                                        Classes="docs-paddingCore">
                                        <Grid
                                            tw:Tw.Class="min-w-[92px] min-h-14">
                                            <TextBlock
                                                Classes="docs-chip"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="px-8" />
                                        </Grid>
                                    </Border>
                                </Border>
                                <Border
                                    Classes="docs-paddingShell"
                                    tw:Tw.Class="py-8">
                                    <Border
                                        Classes="docs-paddingCore">
                                        <Grid
                                            tw:Tw.Class="min-w-[92px] min-h-14">
                                            <TextBlock
                                                Classes="docs-chip"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="py-8" />
                                        </Grid>
                                    </Border>
                                </Border>
                            </StackPanel>
                        </docs:DocsExample>
                    </docs:DocsSection>

                    <docs:DocsSection
                        Heading="Using logical properties"
                        Summary="Use ps-&lt;number&gt;, pe-&lt;number&gt;, pbs-&lt;number&gt;, and pbe-&lt;number&gt; utilities to map padding based on text direction and writing mode. In Avalonia RTL, logical layout is resolved first from FlowDirection, then the final rendered result is mirrored, so the screen side can differ from the physical thickness side. Use psv-&lt;number&gt; and pev-&lt;number&gt; when you want padding to stay on the final visual start or end side after Avalonia mirrors RTL content.">
                        <StackPanel
                            Spacing="18">
                            <docs:DocsNote
                                Classes="supported"
                                Title="Teaching note"
                                Body="The visualized side-mapping demo below adds ScaleTransform only to cancel Avalonia&apos;s automatic RTL mirror for teaching. In the real RTL demo, layout logic is applied first, then Avalonia&apos;s mirror changes the final rendered side. Real app usage is the unmodified RTL rendering demo and the code examples below." />
                            <docs:DocsExample
                                CodeLabel="Actual usage">
                                <docs:DocsExample.Snippets>
                                    <x:String>&lt;Border FlowDirection="LeftToRight" tw:Tw.Class="ps-8" /&gt;</x:String>
                                    <x:String>&lt;Border FlowDirection="LeftToRight" tw:Tw.Class="pe-8" /&gt;</x:String>
                                    <x:String>&lt;Border FlowDirection="RightToLeft" tw:Tw.Class="ps-8" /&gt;</x:String>
                                    <x:String>&lt;Border FlowDirection="RightToLeft" tw:Tw.Class="pe-8" /&gt;</x:String>
                                    <x:String>&lt;Border FlowDirection="LeftToRight" tw:Tw.Class="pbs-8" /&gt;</x:String>
                                    <x:String>&lt;Border FlowDirection="LeftToRight" tw:Tw.Class="pbe-8" /&gt;</x:String>
                                    <x:String>&lt;Border FlowDirection="RightToLeft" tw:Tw.Class="pbs-8" /&gt;</x:String>
                                    <x:String>&lt;Border FlowDirection="RightToLeft" tw:Tw.Class="pbe-8" /&gt;</x:String>
                                    <x:String>&lt;Border FlowDirection="LeftToRight" tw:Tw.Class="psv-8" /&gt;</x:String>
                                    <x:String>&lt;Border FlowDirection="LeftToRight" tw:Tw.Class="pev-8" /&gt;</x:String>
                                    <x:String>&lt;Border FlowDirection="RightToLeft" tw:Tw.Class="psv-8" /&gt;</x:String>
                                    <x:String>&lt;Border FlowDirection="RightToLeft" tw:Tw.Class="pev-8" /&gt;</x:String>
                                </docs:DocsExample.Snippets>
                                <StackPanel
                                    Spacing="24">
                                    <StackPanel
                                        Spacing="16">
                                        <TextBlock
                                            Classes="docs-miniTitle"
                                            Text="Real RTL rendering" />
                                        <TextBlock
                                            Classes="docs-noteBody"
                                            Text="This preview shows the actual Avalonia result when FlowDirection changes. It uses tw:Tw.Class and FlowDirection only, with no extra transforms. Under RTL, the logical padding is calculated first, then Avalonia mirrors the rendered output." />
                                        <Grid
                                            ColumnDefinitions="*,*"
                                            ColumnSpacing="20">
                                            <Border
                                                Grid.Column="0"
                                                Classes="docs-inset">
                                                <StackPanel
                                                    Spacing="12">
                                                    <TextBlock
                                                        Classes="docs-miniTitle"
                                                        Text="Left-to-right" />
                                                    <StackPanel
                                                        Orientation="Vertical"
                                                        Spacing="12">
                                                        <Grid
                                                            ColumnDefinitions="Auto,*,Auto"
                                                            ColumnSpacing="10">
                                                            <TextBlock
                                                                Classes="docs-miniTitle"
                                                                VerticalAlignment="Center"
                                                                Text="start -&gt;" />
                                                            <Border
                                                                Grid.Column="1"
                                                                Classes="docs-paddingShell"
                                                                FlowDirection="LeftToRight"
                                                                tw:Tw.Class="ps-8">
                                                                <Border
                                                                    Classes="docs-paddingCore">
                                                                    <Grid
                                                                        tw:Tw.Class="min-w-[88px] min-h-12">
                                                                        <TextBlock
                                                                            Classes="docs-chip"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            Text="ps-8" />
                                                                    </Grid>
                                                                </Border>
                                                            </Border>
                                                            <TextBlock
                                                                Grid.Column="2"
                                                                Classes="docs-miniTitle"
                                                                VerticalAlignment="Center"
                                                                Text="&lt;- end" />
                                                        </Grid>
                                                        <Grid
                                                            ColumnDefinitions="Auto,*,Auto"
                                                            ColumnSpacing="10">
                                                            <TextBlock
                                                                Classes="docs-miniTitle"
                                                                VerticalAlignment="Center"
                                                                Text="start -&gt;" />
                                                            <Border
                                                                Grid.Column="1"
                                                                Classes="docs-paddingShell"
                                                                FlowDirection="LeftToRight"
                                                                tw:Tw.Class="pe-8">
                                                                <Border
                                                                    Classes="docs-paddingCore">
                                                                    <Grid
                                                                        tw:Tw.Class="min-w-[88px] min-h-12">
                                                                        <TextBlock
                                                                            Classes="docs-chip"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            Text="pe-8" />
                                                                    </Grid>
                                                                </Border>
                                                            </Border>
                                                            <TextBlock
                                                                Grid.Column="2"
                                                                Classes="docs-miniTitle"
                                                                VerticalAlignment="Center"
                                                                Text="&lt;- end" />
                                                        </Grid>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border
                                                Grid.Column="1"
                                                Classes="docs-inset">
                                                <StackPanel
                                                    Spacing="12">
                                                    <TextBlock
                                                        Classes="docs-miniTitle"
                                                        Text="Right-to-left" />
                                                    <StackPanel
                                                        Orientation="Vertical"
                                                        Spacing="12">
                                                        <Grid
                                                            ColumnDefinitions="Auto,*,Auto"
                                                            ColumnSpacing="10">
                                                            <TextBlock
                                                                Classes="docs-miniTitle"
                                                                VerticalAlignment="Center"
                                                                Text="end -&gt;" />
                                                            <Border
                                                                Grid.Column="1"
                                                                Classes="docs-paddingShell"
                                                                FlowDirection="RightToLeft"
                                                                tw:Tw.Class="ps-8">
                                                                <Border
                                                                    Classes="docs-paddingCore">
                                                                    <Grid
                                                                        tw:Tw.Class="min-w-[88px] min-h-12">
                                                                        <TextBlock
                                                                            Classes="docs-chip"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            Text="ps-8" />
                                                                    </Grid>
                                                                </Border>
                                                            </Border>
                                                            <TextBlock
                                                                Grid.Column="2"
                                                                Classes="docs-miniTitle"
                                                                VerticalAlignment="Center"
                                                                Text="&lt;- start" />
                                                        </Grid>
                                                        <Grid
                                                            ColumnDefinitions="Auto,*,Auto"
                                                            ColumnSpacing="10">
                                                            <TextBlock
                                                                Classes="docs-miniTitle"
                                                                VerticalAlignment="Center"
                                                                Text="end -&gt;" />
                                                            <Border
                                                                Grid.Column="1"
                                                                Classes="docs-paddingShell"
                                                                FlowDirection="RightToLeft"
                                                                tw:Tw.Class="pe-8">
                                                                <Border
                                                                    Classes="docs-paddingCore">
                                                                    <Grid
                                                                        tw:Tw.Class="min-w-[88px] min-h-12">
                                                                        <TextBlock
                                                                            Classes="docs-chip"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            Text="pe-8" />
                                                                    </Grid>
                                                                </Border>
                                                            </Border>
                                                            <TextBlock
                                                                Grid.Column="2"
                                                                Classes="docs-miniTitle"
                                                                VerticalAlignment="Center"
                                                                Text="&lt;- start" />
                                                        </Grid>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel
                                        Spacing="16">
                                        <TextBlock
                                            Classes="docs-miniTitle"
                                            Text="Block start and end" />
                                        <TextBlock
                                            Classes="docs-noteBody"
                                            Text="In the sample&apos;s horizontal writing mode, pbs-8 stays on top and pbe-8 stays on bottom in both LTR and RTL. FlowDirection changes inline start and end, but it does not remap the block axis here." />
                                        <Grid
                                            ColumnDefinitions="*,*"
                                            ColumnSpacing="20">
                                            <Border
                                                Grid.Column="0"
                                                Classes="docs-inset">
                                                <StackPanel
                                                    Spacing="12">
                                                    <TextBlock
                                                        Classes="docs-miniTitle"
                                                        Text="Left-to-right" />
                                                    <StackPanel
                                                        Orientation="Vertical"
                                                        Spacing="12">
                                                        <Grid
                                                            RowDefinitions="Auto,*,Auto"
                                                            RowSpacing="10">
                                                            <TextBlock
                                                                Classes="docs-miniTitle"
                                                                HorizontalAlignment="Center"
                                                                Text="block start" />
                                                            <Border
                                                                Grid.Row="1"
                                                                Classes="docs-paddingShell"
                                                                FlowDirection="LeftToRight"
                                                                HorizontalAlignment="Center"
                                                                tw:Tw.Class="pbs-8">
                                                                <Border
                                                                    Classes="docs-paddingCore">
                                                                    <Grid
                                                                        tw:Tw.Class="min-w-[88px] min-h-12">
                                                                        <TextBlock
                                                                            Classes="docs-chip"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            Text="pbs-8" />
                                                                    </Grid>
                                                                </Border>
                                                            </Border>
                                                            <TextBlock
                                                                Grid.Row="2"
                                                                Classes="docs-miniTitle"
                                                                HorizontalAlignment="Center"
                                                                Text="block end" />
                                                        </Grid>
                                                        <Grid
                                                            RowDefinitions="Auto,*,Auto"
                                                            RowSpacing="10">
                                                            <TextBlock
                                                                Classes="docs-miniTitle"
                                                                HorizontalAlignment="Center"
                                                                Text="block start" />
                                                            <Border
                                                                Grid.Row="1"
                                                                Classes="docs-paddingShell"
                                                                FlowDirection="LeftToRight"
                                                                HorizontalAlignment="Center"
                                                                tw:Tw.Class="pbe-8">
                                                                <Border
                                                                    Classes="docs-paddingCore">
                                                                    <Grid
                                                                        tw:Tw.Class="min-w-[88px] min-h-12">
                                                                        <TextBlock
                                                                            Classes="docs-chip"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            Text="pbe-8" />
                                                                    </Grid>
                                                                </Border>
                                                            </Border>
                                                            <TextBlock
                                                                Grid.Row="2"
                                                                Classes="docs-miniTitle"
                                                                HorizontalAlignment="Center"
                                                                Text="block end" />
                                                        </Grid>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border
                                                Grid.Column="1"
                                                Classes="docs-inset">
                                                <StackPanel
                                                    Spacing="12">
                                                    <TextBlock
                                                        Classes="docs-miniTitle"
                                                        Text="Right-to-left" />
                                                    <StackPanel
                                                        Orientation="Vertical"
                                                        Spacing="12">
                                                        <Grid
                                                            RowDefinitions="Auto,*,Auto"
                                                            RowSpacing="10">
                                                            <TextBlock
                                                                Classes="docs-miniTitle"
                                                                HorizontalAlignment="Center"
                                                                Text="block start" />
                                                            <Border
                                                                Grid.Row="1"
                                                                Classes="docs-paddingShell"
                                                                FlowDirection="RightToLeft"
                                                                HorizontalAlignment="Center"
                                                                tw:Tw.Class="pbs-8">
                                                                <Border
                                                                    Classes="docs-paddingCore">
                                                                    <Grid
                                                                        tw:Tw.Class="min-w-[88px] min-h-12">
                                                                        <TextBlock
                                                                            Classes="docs-chip"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            Text="pbs-8" />
                                                                    </Grid>
                                                                </Border>
                                                            </Border>
                                                            <TextBlock
                                                                Grid.Row="2"
                                                                Classes="docs-miniTitle"
                                                                HorizontalAlignment="Center"
                                                                Text="block end" />
                                                        </Grid>
                                                        <Grid
                                                            RowDefinitions="Auto,*,Auto"
                                                            RowSpacing="10">
                                                            <TextBlock
                                                                Classes="docs-miniTitle"
                                                                HorizontalAlignment="Center"
                                                                Text="block start" />
                                                            <Border
                                                                Grid.Row="1"
                                                                Classes="docs-paddingShell"
                                                                FlowDirection="RightToLeft"
                                                                HorizontalAlignment="Center"
                                                                tw:Tw.Class="pbe-8">
                                                                <Border
                                                                    Classes="docs-paddingCore">
                                                                    <Grid
                                                                        tw:Tw.Class="min-w-[88px] min-h-12">
                                                                        <TextBlock
                                                                            Classes="docs-chip"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            Text="pbe-8" />
                                                                    </Grid>
                                                                </Border>
                                                            </Border>
                                                            <TextBlock
                                                                Grid.Row="2"
                                                                Classes="docs-miniTitle"
                                                                HorizontalAlignment="Center"
                                                                Text="block end" />
                                                        </Grid>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel
                                        Spacing="16">
                                        <TextBlock
                                            Classes="docs-miniTitle"
                                            Text="Visualized side mapping" />
                                        <TextBlock
                                            Classes="docs-noteBody"
                                            Text="This teaching preview cancels Avalonia&apos;s RTL mirror so the physical start/end side is easier to inspect side-by-side." />
                                        <Grid
                                            ColumnDefinitions="*,*"
                                            ColumnSpacing="20">
                                            <Border
                                                Grid.Column="0"
                                                Classes="docs-inset">
                                                <StackPanel
                                                    Spacing="12">
                                                    <TextBlock
                                                        Classes="docs-miniTitle"
                                                        Text="Left-to-right" />
                                                    <StackPanel
                                                        Orientation="Vertical"
                                                        Spacing="12">
                                                        <Border
                                                            Classes="docs-paddingShell"
                                                            FlowDirection="LeftToRight"
                                                            tw:Tw.Class="ps-8">
                                                            <Border
                                                                Classes="docs-paddingCore">
                                                                <Grid
                                                                    tw:Tw.Class="min-w-[88px] min-h-12">
                                                                    <TextBlock
                                                                        Classes="docs-chip"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Text="ps-8" />
                                                                </Grid>
                                                            </Border>
                                                        </Border>
                                                        <Border
                                                            Classes="docs-paddingShell"
                                                            FlowDirection="LeftToRight"
                                                            tw:Tw.Class="pe-8">
                                                            <Border
                                                                Classes="docs-paddingCore">
                                                                <Grid
                                                                    tw:Tw.Class="min-w-[88px] min-h-12">
                                                                    <TextBlock
                                                                        Classes="docs-chip"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Text="pe-8" />
                                                                </Grid>
                                                            </Border>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border
                                                Grid.Column="1"
                                                Classes="docs-inset">
                                                <StackPanel
                                                    Spacing="12">
                                                    <TextBlock
                                                        Classes="docs-miniTitle"
                                                        Text="Right-to-left" />
                                                    <StackPanel
                                                        Orientation="Vertical"
                                                        Spacing="12">
                                                        <Border
                                                            Classes="docs-paddingShell"
                                                            FlowDirection="RightToLeft"
                                                            RenderTransformOrigin="50%, 50%"
                                                            tw:Tw.Class="ps-8">
                                                            <Border.RenderTransform>
                                                                <media:ScaleTransform
                                                                    ScaleX="-1" />
                                                            </Border.RenderTransform>
                                                            <Border
                                                                Classes="docs-paddingCore">
                                                                <Grid
                                                                    tw:Tw.Class="min-w-[88px] min-h-12">
                                                                    <TextBlock
                                                                        Classes="docs-chip"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Text="ps-8" />
                                                                </Grid>
                                                            </Border>
                                                        </Border>
                                                        <Border
                                                            Classes="docs-paddingShell"
                                                            FlowDirection="RightToLeft"
                                                            RenderTransformOrigin="50%, 50%"
                                                            tw:Tw.Class="pe-8">
                                                            <Border.RenderTransform>
                                                                <media:ScaleTransform
                                                                    ScaleX="-1" />
                                                            </Border.RenderTransform>
                                                            <Border
                                                                Classes="docs-paddingCore">
                                                                <Grid
                                                                    tw:Tw.Class="min-w-[88px] min-h-12">
                                                                    <TextBlock
                                                                        Classes="docs-chip"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Text="pe-8" />
                                                                </Grid>
                                                            </Border>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel
                                        Spacing="16">
                                        <TextBlock
                                            Classes="docs-miniTitle"
                                            Text="Visual start and end aliases" />
                                        <TextBlock
                                            Classes="docs-noteBody"
                                            Text="psv-8 follows the final rendered start side, and pev-8 follows the final rendered end side. In RTL they intentionally write physical left and right padding so Avalonia&apos;s mirror lands the spacing on the expected visual side." />
                                        <Grid
                                            ColumnDefinitions="*,*"
                                            ColumnSpacing="20">
                                            <Border
                                                Grid.Column="0"
                                                Classes="docs-inset">
                                                <StackPanel
                                                    Spacing="12">
                                                    <TextBlock
                                                        Classes="docs-miniTitle"
                                                        Text="Left-to-right" />
                                                    <StackPanel
                                                        Orientation="Vertical"
                                                        Spacing="12">
                                                        <Grid
                                                            ColumnDefinitions="Auto,*,Auto"
                                                            ColumnSpacing="10">
                                                            <TextBlock
                                                                Classes="docs-miniTitle"
                                                                VerticalAlignment="Center"
                                                                Text="start -&gt;" />
                                                            <Border
                                                                Grid.Column="1"
                                                                Classes="docs-paddingShell"
                                                                FlowDirection="LeftToRight"
                                                                tw:Tw.Class="psv-8">
                                                                <Border
