<UserControl
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:media="clr-namespace:Avalonia.Media;assembly=Avalonia.Base"
      xmlns:tw="using:Tailwind.Avalonia"
      x:Class="Tailwind.Avalonia.Sample.Spacing.Padding">
     <UserControl.Resources>
          <ResourceDictionary>
               <ResourceDictionary.MergedDictionaries>
                    <ResourceInclude
                          Source="avares://Tailwind.Avalonia/Themes/Tailwind.axaml"/>
               </ResourceDictionary.MergedDictionaries>
          </ResourceDictionary>
     </UserControl.Resources>
     <UserControl.Styles>
          <StyleInclude
                Source="/Spacing/SpacingDocsStyles.axaml"/>
     </UserControl.Styles>
     <Border
           Background="{StaticResource BrushSlate950}">
          <ScrollViewer
                HorizontalScrollBarVisibility="Disabled">
               <StackPanel
                     Margin="28,24,40,32"
                     Spacing="40">
                    <StackPanel
                          Spacing="10">
                         <TextBlock
                               Classes="docs-library"
                               Text="SPACING"/>
                         <TextBlock
                               Classes="docs-pageTitle"
                               Text="Padding"/>
                         <TextBlock
                               Classes="docs-body"
                               Text="Utilities for controlling an element&apos;s padding."/>
                    </StackPanel>
                    <StackPanel
                          Spacing="18">
                         <TextBlock
                               Classes="docs-eyebrow"
                               Text="EXAMPLES"/>
                         <StackPanel
                               Spacing="16">
                              <TextBlock
                                    Classes="docs-sectionTitle"
                                    Text="Basic example"/>
                              <TextBlock
                                    Classes="docs-body"
                                    Text="Use p-&lt;number&gt; utilities like p-4 and p-8 to control padding on all sides of an element."/>
                              <Border
                                    Classes="docs-surface">
                                   <StackPanel
                                         Spacing="0">
                                        <Border
                                              Background="{StaticResource BrushSlate950}"
                                              Height="208"
                                              Padding="28">
                                             <Grid>
                                                  <Border
                                                        Classes="docs-paddingShell"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        tw:Tw.Class="p-8">
                                                       <Border
                                                             Classes="docs-paddingCore">
                                                            <Grid
                                                                  MinWidth="96"
                                                                  MinHeight="56">
                                                                 <TextBlock
                                                                       Classes="docs-chip"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Text="p-8"/>
                                                            </Grid>
                                                       </Border>
                                                  </Border>
                                             </Grid>
                                        </Border>
                                         <Border
                                               BorderBrush="{StaticResource BrushSlate800}"
                                               BorderThickness="0,1,0,0"
                                               Padding="20,16">
                                             <StackPanel
                                                   Spacing="6">
                                                  <TextBlock
                                                        Classes="docs-miniTitle"
                                                        Text="Utility version"/>
                                                  <TextBlock
                                                        Classes="docs-code"
                                                        Text="&lt;Border tw:Tw.Class=&quot;p-8&quot; /&gt;"/>
                                                  <TextBlock
                                                        Classes="docs-miniTitle"
                                                        Text="StaticResource version"/>
                                                  <TextBlock
                                                        Classes="docs-code"
                                                        Text="&lt;Border"/>
                                                  <TextBlock
                                                        Classes="docs-code"
                                                        Text="  Padding=&quot;{StaticResource Padding8}&quot; /&gt;"/>
                                             </StackPanel>
                                         </Border>
                                   </StackPanel>
                              </Border>
                         </StackPanel>
                         <StackPanel
                               Spacing="16">
                              <TextBlock
                                    Classes="docs-sectionTitle"
                                    Text="Adding padding to one side"/>
                              <TextBlock
                                    Classes="docs-body"
                                    Text="Use pt-&lt;number&gt;, pr-&lt;number&gt;, pb-&lt;number&gt;, and pl-&lt;number&gt; utilities like pt-6 and pr-4 to control padding on one side of an element."/>
                              <Border
                                    Classes="docs-surface">
                                   <StackPanel
                                         Spacing="0">
                                        <Border
                                              Background="{StaticResource BrushSlate950}"
                                              Height="176"
                                              Padding="24">
                                             <Grid>
                                                  <StackPanel
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Spacing="18">
                                                       <Border
                                                             Classes="docs-paddingShell"
                                                             tw:Tw.Class="pt-6">
                                                            <Border
                                                                  Classes="docs-paddingCore">
                                                                 <Grid
                                                                       MinWidth="84"
                                                                       MinHeight="52">
                                                                      <TextBlock
                                                                            Classes="docs-chip"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            Text="pt-6"/>
                                                                 </Grid>
                                                            </Border>
                                                       </Border>
                                                       <Border
                                                             Classes="docs-paddingShell"
                                                             tw:Tw.Class="pr-4">
                                                            <Border
                                                                  Classes="docs-paddingCore">
                                                                 <Grid
                                                                       MinWidth="84"
                                                                       MinHeight="52">
                                                                      <TextBlock
                                                                            Classes="docs-chip"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            Text="pr-4"/>
                                                                 </Grid>
                                                            </Border>
                                                       </Border>
                                                       <Border
                                                             Classes="docs-paddingShell"
                                                             tw:Tw.Class="pb-8">
                                                            <Border
                                                                  Classes="docs-paddingCore">
                                                                 <Grid
                                                                       MinWidth="84"
                                                                       MinHeight="52">
                                                                      <TextBlock
                                                                            Classes="docs-chip"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            Text="pb-8"/>
                                                                 </Grid>
                                                            </Border>
                                                       </Border>
                                                       <Border
                                                             Classes="docs-paddingShell"
                                                             tw:Tw.Class="pl-2">
                                                            <Border
                                                                  Classes="docs-paddingCore">
                                                                 <Grid
                                                                       MinWidth="84"
                                                                       MinHeight="52">
                                                                      <TextBlock
                                                                            Classes="docs-chip"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            Text="pl-2"/>
                                                                 </Grid>
                                                            </Border>
                                                       </Border>
                                                  </StackPanel>
                                             </Grid>
                                        </Border>
                                         <Border
                                               BorderBrush="{StaticResource BrushSlate800}"
                                               BorderThickness="0,1,0,0"
                                               Padding="20,16">
                                              <StackPanel
                                                    Spacing="6">
                                                   <TextBlock
                                                         Classes="docs-miniTitle"
                                                         Text="Utility version"/>
                                                   <TextBlock
                                                         Classes="docs-code"
                                                         Text="&lt;Border tw:Tw.Class=&quot;pt-6&quot; /&gt;"/>
                                                  <TextBlock
                                                        Classes="docs-code"
                                                        Text="&lt;Border tw:Tw.Class=&quot;pr-4&quot; /&gt;"/>
                                                  <TextBlock
                                                        Classes="docs-code"
                                                        Text="&lt;Border tw:Tw.Class=&quot;pb-8&quot; /&gt;"/>
                                                   <TextBlock
                                                         Classes="docs-code"
                                                         Text="&lt;Border tw:Tw.Class=&quot;pl-2&quot; /&gt;"/>
                                                    <TextBlock
                                                          Classes="docs-miniTitle"
                                                          Text="StaticResource version"/>
                                                    <TextBlock
                                                          Classes="docs-code"
                                                          Text="&lt;Border"/>
                                                    <TextBlock
                                                          Classes="docs-code"
                                                          Text="  Padding=&quot;{StaticResource PaddingTop6}&quot; /&gt;"/>
                                                    <TextBlock
                                                          Classes="docs-code"
                                                          Text="&lt;Border"/>
                                                    <TextBlock
                                                          Classes="docs-code"
                                                          Text="  Padding=&quot;{StaticResource PaddingRight4}&quot; /&gt;"/>
                                                    <TextBlock
                                                          Classes="docs-code"
                                                          Text="&lt;Border"/>
                                                    <TextBlock
                                                          Classes="docs-code"
                                                          Text="  Padding=&quot;{StaticResource PaddingBottom8}&quot; /&gt;"/>
                                                    <TextBlock
                                                          Classes="docs-code"
                                                          Text="&lt;Border"/>
                                                    <TextBlock
                                                          Classes="docs-code"
                                                          Text="  Padding=&quot;{StaticResource PaddingLeft2}&quot; /&gt;"/>
                                              </StackPanel>
                                         </Border>
                                   </StackPanel>
                              </Border>
                         </StackPanel>
                         <StackPanel
                               Spacing="16">
                              <TextBlock
                                    Classes="docs-sectionTitle"
                                    Text="Adding horizontal and vertical padding"/>
                              <TextBlock
                                    Classes="docs-body"
                                    Text="Use px-&lt;number&gt; and py-&lt;number&gt; utilities like px-8 and py-8 to control axis-specific padding."/>
                              <Border
                                    Classes="docs-surface">
                                   <StackPanel
                                         Spacing="0">
                                        <Border
                                              Background="{StaticResource BrushSlate950}"
                                              Height="176"
                                              Padding="24">
                                             <Grid>
                                                  <StackPanel
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Spacing="24">
                                                       <Border
                                                             Classes="docs-paddingShell"
                                                             tw:Tw.Class="px-8">
                                                            <Border
                                                                  Classes="docs-paddingCore">
                                                                 <Grid
                                                                       MinWidth="92"
                                                                       MinHeight="56">
                                                                      <TextBlock
                                                                            Classes="docs-chip"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            Text="px-8"/>
                                                                 </Grid>
                                                            </Border>
                                                       </Border>
                                                       <Border
                                                             Classes="docs-paddingShell"
                                                             tw:Tw.Class="py-8">
                                                            <Border
                                                                  Classes="docs-paddingCore">
                                                                 <Grid
                                                                       MinWidth="92"
                                                                       MinHeight="56">
                                                                      <TextBlock
                                                                            Classes="docs-chip"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            Text="py-8"/>
                                                                 </Grid>
                                                            </Border>
                                                       </Border>
                                                  </StackPanel>
                                             </Grid>
                                        </Border>
                                         <Border
                                               BorderBrush="{StaticResource BrushSlate800}"
                                               BorderThickness="0,1,0,0"
                                               Padding="20,16">
                                              <StackPanel
                                                    Spacing="6">
                                                   <TextBlock
                                                         Classes="docs-miniTitle"
                                                         Text="Utility version"/>
                                                   <TextBlock
                                                         Classes="docs-code"
                                                         Text="&lt;Border tw:Tw.Class=&quot;px-8&quot; /&gt;"/>
                                                   <TextBlock
                                                         Classes="docs-code"
                                                         Text="&lt;Border tw:Tw.Class=&quot;py-8&quot; /&gt;"/>
                                                    <TextBlock
                                                          Classes="docs-miniTitle"
                                                          Text="StaticResource version"/>
                                                    <TextBlock
                                                          Classes="docs-code"
                                                          Text="&lt;Border"/>
                                                    <TextBlock
                                                          Classes="docs-code"
                                                          Text="  Padding=&quot;{StaticResource PaddingX8}&quot; /&gt;"/>
                                                    <TextBlock
                                                          Classes="docs-code"
                                                          Text="&lt;Border"/>
                                                    <TextBlock
                                                          Classes="docs-code"
                                                          Text="  Padding=&quot;{StaticResource PaddingY8}&quot; /&gt;"/>
                                              </StackPanel>
                                         </Border>
                                   </StackPanel>
                              </Border>
                         </StackPanel>
                         <StackPanel
                               Spacing="16">
                              <TextBlock
                                    Classes="docs-sectionTitle"
                                    Text="Using logical properties"/>
                              <TextBlock
                                    Classes="docs-body"
                                    Text="Use ps-&lt;number&gt;, pe-&lt;number&gt;, pbs-&lt;number&gt;, and pbe-&lt;number&gt; utilities to map padding based on text direction and writing mode. In Avalonia RTL, logical layout is resolved first from FlowDirection, then the final rendered result is mirrored, so the screen side can differ from the physical thickness side. Use psv-&lt;number&gt; and pev-&lt;number&gt; when you want padding to stay on the final visual start or end side after Avalonia mirrors RTL content."/>
                              <Border
                                    Classes="docs-note"
                                    BorderThickness="2"
                                    tw:Tw.Class="bg-sky-950/35 border-sky-400/60">
                                   <StackPanel
                                         Spacing="6">
                                        <TextBlock
                                              Classes="docs-noteTitle"
                                              tw:Tw.Class="text-sky-50"
                                              Text="Teaching note"/>
                                        <TextBlock
                                              Classes="docs-noteBody"
                                              tw:Tw.Class="text-sky-100/85"
                                              Text="The visualized side-mapping demo below adds ScaleTransform only to cancel Avalonia&apos;s automatic RTL mirror for teaching. In the real RTL demo, layout logic is applied first, then Avalonia&apos;s mirror changes the final rendered side. Real app usage is the unmodified RTL rendering demo and the code examples below."/>
                                   </StackPanel>
                              </Border>
                              <Border
                                    Classes="docs-surface">
                                   <StackPanel
                                         Spacing="0">
                                        <Border
                                              Background="{StaticResource BrushSlate950}"
                                              Padding="24">
                                             <StackPanel
                                                   Spacing="24">
                                                  <StackPanel
                                                        Spacing="16">
                                                       <TextBlock
                                                             Classes="docs-miniTitle"
                                                             Text="Real RTL rendering"/>
                                                       <TextBlock
                                                             Classes="docs-noteBody"
                                                             Text="This preview shows the actual Avalonia result when FlowDirection changes. It uses tw:Tw.Class and FlowDirection only, with no extra transforms. Under RTL, the logical padding is calculated first, then Avalonia mirrors the rendered output."/>
                                                       <Grid
                                                             ColumnDefinitions="*,*"
                                                             ColumnSpacing="20">
                                                            <Border
                                                                  Grid.Column="0"
                                                                  Classes="docs-inset">
                                                                 <StackPanel
                                                                       Spacing="12">
                                                                      <TextBlock
                                                                            Classes="docs-miniTitle"
                                                                            Text="Left-to-right"/>
                                                                      <StackPanel
                                                                            Orientation="Vertical"
                                                                            Spacing="12">
                                                                           <Grid
                                                                                 ColumnDefinitions="Auto,*,Auto"
                                                                                 ColumnSpacing="10">
                                                                                <TextBlock
                                                                                      Classes="docs-miniTitle"
                                                                                      VerticalAlignment="Center"
                                                                                      Text="start -&gt;"/>
                                                                                <Border
                                                                                      Grid.Column="1"
                                                                                      Classes="docs-paddingShell"
                                                                                      FlowDirection="LeftToRight"
                                                                                      tw:Tw.Class="ps-8">
                                                                                     <Border
                                                                                           Classes="docs-paddingCore">
                                                                                          <Grid
                                                                                                MinWidth="88"
                                                                                                MinHeight="48">
                                                                                               <TextBlock
                                                                                                     Classes="docs-chip"
                                                                                                     HorizontalAlignment="Center"
                                                                                                     VerticalAlignment="Center"
                                                                                                     Text="ps-8"/>
                                                                                          </Grid>
                                                                                     </Border>
                                                                                </Border>
                                                                                <TextBlock
                                                                                      Grid.Column="2"
                                                                                      Classes="docs-miniTitle"
                                                                                      VerticalAlignment="Center"
                                                                                      Text="&lt;- end"/>
                                                                           </Grid>
                                                                           <Grid
                                                                                 ColumnDefinitions="Auto,*,Auto"
                                                                                 ColumnSpacing="10">
                                                                                <TextBlock
                                                                                      Classes="docs-miniTitle"
                                                                                      VerticalAlignment="Center"
                                                                                      Text="start -&gt;"/>
                                                                                <Border
                                                                                      Grid.Column="1"
                                                                                      Classes="docs-paddingShell"
                                                                                      FlowDirection="LeftToRight"
                                                                                      tw:Tw.Class="pe-8">
                                                                                     <Border
                                                                                           Classes="docs-paddingCore">
                                                                                          <Grid
                                                                                                MinWidth="88"
                                                                                                MinHeight="48">
                                                                                               <TextBlock
                                                                                                     Classes="docs-chip"
                                                                                                     HorizontalAlignment="Center"
                                                                                                     VerticalAlignment="Center"
                                                                                                     Text="pe-8"/>
                                                                                          </Grid>
                                                                                     </Border>
                                                                                </Border>
                                                                                <TextBlock
                                                                                      Grid.Column="2"
                                                                                      Classes="docs-miniTitle"
                                                                                      VerticalAlignment="Center"
                                                                                      Text="&lt;- end"/>
                                                                           </Grid>
                                                                      </StackPanel>
                                                                 </StackPanel>
                                                            </Border>
                                                            <Border
                                                                  Grid.Column="1"
                                                                  Classes="docs-inset">
                                                                 <StackPanel
                                                                       Spacing="12">
                                                                      <TextBlock
                                                                            Classes="docs-miniTitle"
                                                                            Text="Right-to-left"/>
                                                                      <StackPanel
                                                                            Orientation="Vertical"
                                                                            Spacing="12">
                                                                           <Grid
                                                                                 ColumnDefinitions="Auto,*,Auto"
                                                                                 ColumnSpacing="10">
                                                                                <TextBlock
                                                                                      Classes="docs-miniTitle"
                                                                                      VerticalAlignment="Center"
                                                                                      Text="end -&gt;"/>
                                                                                <Border
                                                                                      Grid.Column="1"
                                                                                      Classes="docs-paddingShell"
                                                                                      FlowDirection="RightToLeft"
                                                                                      tw:Tw.Class="ps-8">
                                                                                     <Border
                                                                                           Classes="docs-paddingCore">
                                                                                          <Grid
                                                                                                MinWidth="88"
                                                                                                MinHeight="48">
                                                                                               <TextBlock
                                                                                                     Classes="docs-chip"
                                                                                                     HorizontalAlignment="Center"
                                                                                                     VerticalAlignment="Center"
                                                                                                     Text="ps-8"/>
                                                                                          </Grid>
                                                                                     </Border>
                                                                                </Border>
                                                                                <TextBlock
                                                                                      Grid.Column="2"
                                                                                      Classes="docs-miniTitle"
                                                                                      VerticalAlignment="Center"
                                                                                      Text="&lt;- start"/>
                                                                           </Grid>
                                                                           <Grid
                                                                                 ColumnDefinitions="Auto,*,Auto"
                                                                                 ColumnSpacing="10">
                                                                                <TextBlock
                                                                                      Classes="docs-miniTitle"
                                                                                      VerticalAlignment="Center"
                                                                                      Text="end -&gt;"/>
                                                                                <Border
                                                                                      Grid.Column="1"
                                                                                      Classes="docs-paddingShell"
                                                                                      FlowDirection="RightToLeft"
                                                                                      tw:Tw.Class="pe-8">
                                                                                     <Border
                                                                                           Classes="docs-paddingCore">
                                                                                          <Grid
                                                                                                MinWidth="88"
                                                                                                MinHeight="48">
                                                                                               <TextBlock
                                                                                                     Classes="docs-chip"
                                                                                                     HorizontalAlignment="Center"
                                                                                                     VerticalAlignment="Center"
                                                                                                     Text="pe-8"/>
                                                                                          </Grid>
                                                                                     </Border>
                                                                                </Border>
                                                                                <TextBlock
                                                                                      Grid.Column="2"
                                                                                      Classes="docs-miniTitle"
                                                                                      VerticalAlignment="Center"
                                                                                      Text="&lt;- start"/>
                                                                           </Grid>
                                                                      </StackPanel>
                                                                 </StackPanel>
                                                            </Border>
                                                       </Grid>
                                                  </StackPanel>
                                                  <StackPanel
                                                        Spacing="16">
                                                       <TextBlock
                                                             Classes="docs-miniTitle"
                                                             Text="Visualized side mapping"/>
                                                       <TextBlock
                                                             Classes="docs-noteBody"
                                                             Text="This teaching preview cancels Avalonia&apos;s RTL mirror so the physical start/end side is easier to inspect side-by-side."/>
                                                       <Grid
                                                             ColumnDefinitions="*,*"
                                                             ColumnSpacing="20">
                                                            <Border
                                                                  Grid.Column="0"
                                                                  Classes="docs-inset">
                                                                 <StackPanel
                                                                       Spacing="12">
                                                                      <TextBlock
                                                                            Classes="docs-miniTitle"
                                                                            Text="Left-to-right"/>
                                                                      <StackPanel
                                                                            Orientation="Vertical"
                                                                            Spacing="12">
                                                                           <Border
                                                                                 Classes="docs-paddingShell"
                                                                                 FlowDirection="LeftToRight"
                                                                                 tw:Tw.Class="ps-8">
                                                                                <Border
                                                                                      Classes="docs-paddingCore">
                                                                                     <Grid
                                                                                           MinWidth="88"
                                                                                           MinHeight="48">
                                                                                          <TextBlock
                                                                                                Classes="docs-chip"
                                                                                                HorizontalAlignment="Center"
                                                                                                VerticalAlignment="Center"
                                                                                                Text="ps-8"/>
                                                                                     </Grid>
                                                                                </Border>
                                                                           </Border>
                                                                           <Border
                                                                                 Classes="docs-paddingShell"
                                                                                 FlowDirection="LeftToRight"
                                                                                 tw:Tw.Class="pe-8">
                                                                                <Border
                                                                                      Classes="docs-paddingCore">
                                                                                     <Grid
                                                                                           MinWidth="88"
                                                                                           MinHeight="48">
                                                                                          <TextBlock
                                                                                                Classes="docs-chip"
                                                                                                HorizontalAlignment="Center"
                                                                                                VerticalAlignment="Center"
                                                                                                Text="pe-8"/>
                                                                                     </Grid>
                                                                                </Border>
                                                                           </Border>
                                                                      </StackPanel>
                                                                 </StackPanel>
                                                            </Border>
                                                            <Border
                                                                  Grid.Column="1"
                                                                  Classes="docs-inset">
                                                                 <StackPanel
                                                                       Spacing="12">
                                                                      <TextBlock
                                                                            Classes="docs-miniTitle"
                                                                            Text="Right-to-left"/>
                                                                      <StackPanel
                                                                            Orientation="Vertical"
                                                                            Spacing="12">
                                                                           <Border
                                                                                 Classes="docs-paddingShell"
                                                                                 FlowDirection="RightToLeft"
                                                                                 RenderTransformOrigin="50%, 50%"
                                                                                 tw:Tw.Class="ps-8">
                                                                                <Border.RenderTransform>
                                                                                     <media:ScaleTransform
                                                                                           ScaleX="-1"/>
                                                                                </Border.RenderTransform>
                                                                                <Border
                                                                                      Classes="docs-paddingCore">
                                                                                     <Grid
                                                                                           MinWidth="88"
                                                                                           MinHeight="48">
                                                                                          <TextBlock
                                                                                                Classes="docs-chip"
                                                                                                HorizontalAlignment="Center"
                                                                                                VerticalAlignment="Center"
                                                                                                Text="ps-8"/>
                                                                                     </Grid>
                                                                                </Border>
                                                                           </Border>
                                                                           <Border
                                                                                 Classes="docs-paddingShell"
                                                                                 FlowDirection="RightToLeft"
                                                                                 RenderTransformOrigin="50%, 50%"
                                                                                 tw:Tw.Class="pe-8">
                                                                                <Border.RenderTransform>
                                                                                     <media:ScaleTransform
                                                                                           ScaleX="-1"/>
                                                                                </Border.RenderTransform>
                                                                                <Border
                                                                                      Classes="docs-paddingCore">
                                                                                     <Grid
                                                                                           MinWidth="88"
                                                                                           MinHeight="48">
                                                                                          <TextBlock
                                                                                                Classes="docs-chip"
                                                                                                HorizontalAlignment="Center"
                                                                                                VerticalAlignment="Center"
                                                                                                Text="pe-8"/>
                                                                                     </Grid>
                                                                                </Border>
                                                                           </Border>
                                                                      </StackPanel>
                                                                 </StackPanel>
                                                            </Border>
                                                       </Grid>
                                                  </StackPanel>
                                                  <StackPanel
                                                        Spacing="16">
                                                       <TextBlock
                                                             Classes="docs-miniTitle"
                                                             Text="Visual start and end aliases"/>
                                                       <TextBlock
                                                             Classes="docs-noteBody"
                                                             Text="psv-8 follows the final rendered start side, and pev-8 follows the final rendered end side. In RTL they intentionally write physical left and right padding so Avalonia&apos;s mirror lands the spacing on the expected visual side."/>
                                                       <Grid
                                                             ColumnDefinitions="*,*"
                                                             ColumnSpacing="20">
                                                            <Border
                                                                  Grid.Column="0"
                                                                  Classes="docs-inset">
                                                                 <StackPanel
                                                                       Spacing="12">
                                                                      <TextBlock
                                                                            Classes="docs-miniTitle"
                                                                            Text="Left-to-right"/>
                                                                      <StackPanel
                                                                            Orientation="Vertical"
                                                                            Spacing="12">
                                                                           <Grid
                                                                                 ColumnDefinitions="Auto,*,Auto"
                                                                                 ColumnSpacing="10">
                                                                                <TextBlock
                                                                                      Classes="docs-miniTitle"
                                                                                      VerticalAlignment="Center"
                                                                                      Text="start -&gt;"/>
                                                                                <Border
                                                                                      Grid.Column="1"
                                                                                      Classes="docs-paddingShell"
                                                                                      FlowDirection="LeftToRight"
                                                                                      tw:Tw.Class="psv-8">
                                                                                     <Border
                                                                                           Classes="docs-paddingCore">
                                                                                          <Grid
                                                                                                MinWidth="88"
                                                                                                MinHeight="48">
                                                                                               <TextBlock
                                                                                                     Classes="docs-chip"
                                                                                                     HorizontalAlignment="Center"
                                                                                                     VerticalAlignment="Center"
                                                                                                     Text="psv-8"/>
                                                                                          </Grid>
                                                                                     </Border>
                                                                                </Border>
                                                                                <TextBlock
                                                                                      Grid.Column="2"
                                                                                      Classes="docs-miniTitle"
                                                                                      VerticalAlignment="Center"
                                                                                      Text="&lt;- end"/>
                                                                           </Grid>
                                                                           <Grid
                                                                                 ColumnDefinitions="Auto,*,Auto"
                                                                                 ColumnSpacing="10">
                                                                                <TextBlock
                                                                                      Classes="docs-miniTitle"
                                                                                      VerticalAlignment="Center"
                                                                                      Text="start -&gt;"/>
                                                                                <Border
                                                                                      Grid.Column="1"
                                                                                      Classes="docs-paddingShell"
                                                                                      FlowDirection="LeftToRight"
                                                                                      tw:Tw.Class="pev-8">
                                                                                     <Border
                                                                                           Classes="docs-paddingCore">
                                                                                          <Grid
                                                                                                MinWidth="88"
                                                                                                MinHeight="48">
                                                                                               <TextBlock
                                                                                                     Classes="docs-chip"
                                                                                                     HorizontalAlignment="Center"
                                                                                                     VerticalAlignment="Center"
                                                                                                     Text="pev-8"/>
                                                                                          </Grid>
                                                                                     </Border>
