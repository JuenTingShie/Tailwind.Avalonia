<UserControl
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:tw="using:Tailwind.Avalonia"
      x:Class="Tailwind.Avalonia.Sample.Spacing.Padding">
     <UserControl.Resources>
          <ResourceDictionary>
               <ResourceDictionary.MergedDictionaries>
                    <ResourceInclude
                          Source="avares://Tailwind.Avalonia/Themes/Tailwind.axaml"/>
               </ResourceDictionary.MergedDictionaries>
          </ResourceDictionary>
     </UserControl.Resources>
     <UserControl.Styles>
          <StyleInclude
                Source="/Spacing/SpacingDocsStyles.axaml"/>
     </UserControl.Styles>
     <Border
           Background="{StaticResource BrushSlate950}">
          <ScrollViewer
                HorizontalScrollBarVisibility="Disabled">
               <StackPanel
                     Margin="28,24,40,32"
                     Spacing="40">
                    <StackPanel
                          Spacing="10">
                         <TextBlock
                               Classes="docs-library"
                               Text="TAILWIND.AVALONIA"/>
                         <TextBlock
                               Classes="docs-pageTitle"
                               Text="Padding"/>
                         <TextBlock
                               Classes="docs-body"
                               Text="Utilities for controlling an element&apos;s padding. This page mirrors the padding subset currently implemented in Tailwind.Avalonia and keeps the examples focused on real tw:Tw.Class usage."/>
                         <Border
                               Classes="docs-note"
                               BorderThickness="2"
                               tw:Tw.Class="bg-sky-950/35 border-sky-400/60">
                              <StackPanel
                                    Spacing="6">
                                   <TextBlock
                                         Classes="docs-noteTitle"
                                         tw:Tw.Class="text-sky-50"
                                         Text="Implemented in this sample"/>
                                   <TextBlock
                                         Classes="docs-noteBody"
                                         tw:Tw.Class="text-sky-100/85"
                                         Text="Supported now: p, px, py, pt, pr, pb, pl, ps, pe, pbs, and pbe. Arbitrary values and responsive variants are intentionally left out until the parser supports them."/>
                              </StackPanel>
                         </Border>
                    </StackPanel>
                    <StackPanel
                          Spacing="18">
                         <TextBlock
                               Classes="docs-eyebrow"
                               Text="EXAMPLES"/>
                         <StackPanel
                               Spacing="16">
                              <TextBlock
                                    Classes="docs-sectionTitle"
                                    Text="Basic example"/>
                              <TextBlock
                                    Classes="docs-body"
                                    Text="Use p-&lt;number&gt; utilities like p-4 and p-8 to control padding on all sides of an element."/>
                              <Border
                                    Classes="docs-surface">
                                   <StackPanel
                                         Spacing="0">
                                        <Border
                                              Background="{StaticResource BrushSlate950}"
                                              Height="208"
                                              Padding="28">
                                             <Grid>
                                                  <Border
                                                        Classes="docs-paddingShell"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        tw:Tw.Class="p-8">
                                                       <Border
                                                             Classes="docs-paddingCore">
                                                            <Grid
                                                                  MinWidth="96"
                                                                  MinHeight="56">
                                                                 <TextBlock
                                                                       Classes="docs-chip"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Text="p-8"/>
                                                            </Grid>
                                                       </Border>
                                                  </Border>
                                             </Grid>
                                        </Border>
                                        <Border
                                              BorderBrush="{StaticResource BrushSlate800}"
                                              BorderThickness="0,1,0,0"
                                              Padding="20,16">
                                             <TextBlock
                                                   Classes="docs-code"
                                                   Text="tw:Tw.Class=&quot;p-8&quot;"/>
                                        </Border>
                                   </StackPanel>
                              </Border>
                         </StackPanel>
                         <StackPanel
                               Spacing="16">
                              <TextBlock
                                    Classes="docs-sectionTitle"
                                    Text="Adding padding to one side"/>
                              <TextBlock
                                    Classes="docs-body"
                                    Text="Use pt-&lt;number&gt;, pr-&lt;number&gt;, pb-&lt;number&gt;, and pl-&lt;number&gt; utilities like pt-6 and pr-4 to control padding on one side of an element."/>
                              <Border
                                    Classes="docs-surface">
                                   <StackPanel
                                         Spacing="0">
                                        <Border
                                              Background="{StaticResource BrushSlate950}"
                                              Height="176"
                                              Padding="24">
                                             <Grid>
                                                  <StackPanel
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Spacing="18">
                                                       <Border
                                                             Classes="docs-paddingShell"
                                                             tw:Tw.Class="pt-6">
                                                            <Border
                                                                  Classes="docs-paddingCore">
                                                                 <Grid
                                                                       MinWidth="84"
                                                                       MinHeight="52">
                                                                      <TextBlock
                                                                            Classes="docs-chip"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            Text="pt-6"/>
                                                                 </Grid>
                                                            </Border>
                                                       </Border>
                                                       <Border
                                                             Classes="docs-paddingShell"
                                                             tw:Tw.Class="pr-4">
                                                            <Border
                                                                  Classes="docs-paddingCore">
                                                                 <Grid
                                                                       MinWidth="84"
                                                                       MinHeight="52">
                                                                      <TextBlock
                                                                            Classes="docs-chip"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            Text="pr-4"/>
                                                                 </Grid>
                                                            </Border>
                                                       </Border>
                                                       <Border
                                                             Classes="docs-paddingShell"
                                                             tw:Tw.Class="pb-8">
                                                            <Border
                                                                  Classes="docs-paddingCore">
                                                                 <Grid
                                                                       MinWidth="84"
                                                                       MinHeight="52">
                                                                      <TextBlock
                                                                            Classes="docs-chip"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            Text="pb-8"/>
                                                                 </Grid>
                                                            </Border>
                                                       </Border>
                                                       <Border
                                                             Classes="docs-paddingShell"
                                                             tw:Tw.Class="pl-2">
                                                            <Border
                                                                  Classes="docs-paddingCore">
                                                                 <Grid
                                                                       MinWidth="84"
                                                                       MinHeight="52">
                                                                      <TextBlock
                                                                            Classes="docs-chip"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            Text="pl-2"/>
                                                                 </Grid>
                                                            </Border>
                                                       </Border>
                                                  </StackPanel>
                                             </Grid>
                                        </Border>
                                        <Border
                                              BorderBrush="{StaticResource BrushSlate800}"
                                              BorderThickness="0,1,0,0"
                                              Padding="20,16">
                                             <TextBlock
                                                   Classes="docs-code"
                                                   Text="tw:Tw.Class=&quot;pt-6 pr-4 pb-8 pl-2&quot;"/>
                                        </Border>
                                   </StackPanel>
                              </Border>
                         </StackPanel>
                         <StackPanel
                               Spacing="16">
                              <TextBlock
                                    Classes="docs-sectionTitle"
                                    Text="Adding horizontal and vertical padding"/>
                              <TextBlock
                                    Classes="docs-body"
                                    Text="Use px-&lt;number&gt; and py-&lt;number&gt; utilities like px-8 and py-8 to control axis-specific padding."/>
                              <Border
                                    Classes="docs-surface">
                                   <StackPanel
                                         Spacing="0">
                                        <Border
                                              Background="{StaticResource BrushSlate950}"
                                              Height="176"
                                              Padding="24">
                                             <Grid>
                                                  <StackPanel
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Spacing="24">
                                                       <Border
                                                             Classes="docs-paddingShell"
                                                             tw:Tw.Class="px-8">
                                                            <Border
                                                                  Classes="docs-paddingCore">
                                                                 <Grid
                                                                       MinWidth="92"
                                                                       MinHeight="56">
                                                                      <TextBlock
                                                                            Classes="docs-chip"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            Text="px-8"/>
                                                                 </Grid>
                                                            </Border>
                                                       </Border>
                                                       <Border
                                                             Classes="docs-paddingShell"
                                                             tw:Tw.Class="py-8">
                                                            <Border
                                                                  Classes="docs-paddingCore">
                                                                 <Grid
                                                                       MinWidth="92"
                                                                       MinHeight="56">
                                                                      <TextBlock
                                                                            Classes="docs-chip"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            Text="py-8"/>
                                                                 </Grid>
                                                            </Border>
                                                       </Border>
                                                  </StackPanel>
                                             </Grid>
                                        </Border>
                                        <Border
                                              BorderBrush="{StaticResource BrushSlate800}"
                                              BorderThickness="0,1,0,0"
                                              Padding="20,16">
                                             <TextBlock
                                                   Classes="docs-code"
                                                   Text="tw:Tw.Class=&quot;px-8&quot;    tw:Tw.Class=&quot;py-8&quot;"/>
                                        </Border>
                                   </StackPanel>
                              </Border>
                         </StackPanel>
                         <StackPanel
                               Spacing="16">
                              <TextBlock
                                    Classes="docs-sectionTitle"
                                    Text="Using logical properties"/>
                              <TextBlock
                                    Classes="docs-body"
                                    Text="Use ps-&lt;number&gt;, pe-&lt;number&gt;, pbs-&lt;number&gt;, and pbe-&lt;number&gt; utilities to map padding based on text direction and writing mode."/>
                              <Border
                                    Classes="docs-surface">
                                   <StackPanel
                                         Spacing="0">
                                        <Border
                                              Background="{StaticResource BrushSlate950}"
                                              Height="208"
                                              Padding="24">
                                             <Grid
                                                   ColumnDefinitions="*,*"
                                                   ColumnSpacing="20">
                                                  <Border
                                                        Classes="docs-inset">
                                                       <StackPanel
                                                             Spacing="12">
                                                            <TextBlock
                                                                  Classes="docs-miniTitle"
                                                                  Text="Left-to-right"/>
                                                            <StackPanel
                                                                  Orientation="Horizontal"
                                                                  FlowDirection="LeftToRight"
                                                                  Spacing="14">
                                                                 <Border
                                                                       Classes="docs-paddingShell"
                                                                       tw:Tw.Class="ps-8">
                                                                      <Border
                                                                            Classes="docs-paddingCore">
                                                                           <Grid
                                                                                 MinWidth="88"
                                                                                 MinHeight="48">
                                                                                <TextBlock
                                                                                      Classes="docs-chip"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"
                                                                                      Text="ps-8"/>
                                                                           </Grid>
                                                                      </Border>
                                                                 </Border>
                                                                 <Border
                                                                       Classes="docs-paddingShell"
                                                                       tw:Tw.Class="pe-8">
                                                                      <Border
                                                                            Classes="docs-paddingCore">
                                                                           <Grid
                                                                                 MinWidth="88"
                                                                                 MinHeight="48">
                                                                                <TextBlock
                                                                                      Classes="docs-chip"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"
                                                                                      Text="pe-8"/>
                                                                           </Grid>
                                                                      </Border>
                                                                 </Border>
                                                            </StackPanel>
                                                            <Border
                                                                  Classes="docs-paddingShell"
                                                                  HorizontalAlignment="Left"
                                                                  tw:Tw.Class="pbs-8">
                                                                 <Border
                                                                       Classes="docs-paddingCore">
                                                                      <Grid
                                                                            MinWidth="88"
                                                                            MinHeight="48">
                                                                           <TextBlock
                                                                                 Classes="docs-chip"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"
                                                                                 Text="pbs-8"/>
                                                                      </Grid>
                                                                 </Border>
                                                            </Border>
                                                       </StackPanel>
                                                  </Border>
                                                  <Border
                                                        Classes="docs-inset">
                                                       <StackPanel
                                                             Spacing="12">
                                                            <TextBlock
                                                                  Classes="docs-miniTitle"
                                                                  Text="Right-to-left"/>
                                                            <StackPanel
                                                                  Orientation="Horizontal"
                                                                  FlowDirection="RightToLeft"
                                                                  Spacing="14">
                                                                 <Border
                                                                       Classes="docs-paddingShell"
                                                                       tw:Tw.Class="ps-8">
                                                                      <Border
                                                                            Classes="docs-paddingCore">
                                                                           <Grid
                                                                                 MinWidth="88"
                                                                                 MinHeight="48">
                                                                                <TextBlock
                                                                                      Classes="docs-chip"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"
                                                                                      Text="ps-8"/>
                                                                           </Grid>
                                                                      </Border>
                                                                 </Border>
                                                                 <Border
                                                                       Classes="docs-paddingShell"
                                                                       tw:Tw.Class="pe-8">
                                                                      <Border
                                                                            Classes="docs-paddingCore">
                                                                           <Grid
                                                                                 MinWidth="88"
                                                                                 MinHeight="48">
                                                                                <TextBlock
                                                                                      Classes="docs-chip"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"
                                                                                      Text="pe-8"/>
                                                                           </Grid>
                                                                      </Border>
                                                                 </Border>
                                                            </StackPanel>
                                                            <Border
                                                                  Classes="docs-paddingShell"
                                                                  HorizontalAlignment="Left"
                                                                  tw:Tw.Class="pbs-8">
                                                                 <Border
                                                                       Classes="docs-paddingCore">
                                                                      <Grid
                                                                            MinWidth="88"
                                                                            MinHeight="48">
                                                                           <TextBlock
                                                                                 Classes="docs-chip"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"
                                                                                 Text="pbs-8"/>
                                                                      </Grid>
                                                                 </Border>
                                                            </Border>
                                                       </StackPanel>
                                                  </Border>
                                             </Grid>
                                        </Border>
                                        <Border
                                              BorderBrush="{StaticResource BrushSlate800}"
                                              BorderThickness="0,1,0,0"
                                              Padding="20,16">
                                             <TextBlock
                                                   Classes="docs-code"
                                                   Text="tw:Tw.Class=&quot;ps-8 pe-8 pbs-8&quot;"/>
                                        </Border>
                                   </StackPanel>
                              </Border>
                         </StackPanel>
                    </StackPanel>
               </StackPanel>
          </ScrollViewer>
     </Border>
</UserControl>