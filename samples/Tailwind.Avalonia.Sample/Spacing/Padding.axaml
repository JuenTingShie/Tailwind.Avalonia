                    </docs:DocsSection>

                    <docs:DocsSection
                        Heading="Arbitrary padding values"
                        Summary="Use bracket syntax like p-[12px] for direct arbitrary values.">
                        <StackPanel
                            Spacing="18">
                            <docs:DocsNote
                                Title="How arbitrary padding resolves">
                                <StackPanel
                                    Spacing="8">
                                    <TextBlock
                                        Classes="docs-tableClass"
                                        Text="px · rem · em · unitless" />
                                    <TextBlock
                                        Classes="docs-noteBody"
                                        Text="Arbitrary padding values are parser-only and do not emit generated package keys." />
                                    <TextBlock
                                        Classes="docs-noteBody"
                                        Text="rem and em use 16px base. Unitless values are treated as px." />
                                    <TextBlock
                                        Classes="docs-noteBody"
                                        Text="Current parser only supports bracket arbitrary syntax. p-(&lt;custom-property&gt;) remains unsupported." />
                                    <TextBlock
                                        Classes="docs-noteBody"
                                        Text="Percentages stay unsupported; a % token fails to parse and the whole class is dropped." />
                                </StackPanel>
                            </docs:DocsNote>
                            <docs:DocsExample>
                                <docs:DocsExample.Snippets>
                                    <x:String>&lt;Border tw:Tw.Class="p-[12px]" /&gt;</x:String>
                                    <x:String>&lt;Border tw:Tw.Class="px-[20px] py-[10px]" /&gt;</x:String>
                                    <x:String>&lt;Border tw:Tw.Class="pt-[8px] pr-[12px] pb-[16px] pl-[20px]" /&gt;</x:String>
                                </docs:DocsExample.Snippets>
                                <StackPanel
                                    Spacing="12">
                                    <Border
                                        Classes="docs-paddingShell"
                                        HorizontalAlignment="Center"
                                        tw:Tw.Class="p-[12px]">
                                        <Border
                                            Classes="docs-paddingCore">
                                            <Grid
                                                tw:Tw.Class="min-w-24 min-h-14">
                                                <TextBlock
                                                    Classes="docs-chip"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Text="p-[12px]" />
                                            </Grid>
                                        </Border>
                                    </Border>
                                    <Border
                                        Classes="docs-paddingShell"
                                        HorizontalAlignment="Center"
                                        tw:Tw.Class="px-[20px] py-[10px]">
                                        <Border
                                            Classes="docs-paddingCore">
                                            <Grid
                                                tw:Tw.Class="min-w-24 min-h-14">
                                                <TextBlock
                                                    Classes="docs-chip"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Text="px-[20px] py-[10px]" />
                                            </Grid>
                                        </Border>
                                    </Border>
                                    <Border
                                        Classes="docs-paddingShell"
                                        HorizontalAlignment="Center"
                                        tw:Tw.Class="pt-[8px] pr-[12px] pb-[16px] pl-[20px]">
                                        <Border
                                            Classes="docs-paddingCore">
                                            <Grid
                                                tw:Tw.Class="min-w-[120px] min-h-14">
                                                <TextBlock
                                                    Classes="docs-chip"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Text="pt/pr/pb/pl" />
                                            </Grid>
                                        </Border>
                                    </Border>
                                </StackPanel>
                            </docs:DocsExample>
                        </StackPanel>
                    </docs:DocsSection>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </docs:DocsPage>
</UserControl>
