                                                      </StackPanel>
                                                </TabItem>
                                                <TabItem
                                                       Classes="docs-exampleTab"
                                                       Header="StaticResource">
                                                      <StackPanel
                                                             Spacing="0">
                                                            <Border
                                                                   Background="{StaticResource BrushSlate950}"
                                                                   Height="208"
                                                                   Padding="28">
                                                                  <Grid>
                                                                        <Border
                                                                               Classes="docs-marginShell"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center">
                                                                              <StackPanel
                                                                                     Spacing="0">
                                                                                    <Border
                                                                                           Background="{StaticResource BrushSky400}"
                                                                                           CornerRadius="12"
                                                                                           Width="240"
                                                                                           Padding="16">
                                                                                          <TextBlock
                                                                                                 Classes="docs-chip"
                                                                                                 HorizontalAlignment="Center"
                                                                                                 Text="base block"/>
                                                                                    </Border>
                                                                                    <Border
                                                                                           Background="{StaticResource BrushBlue500}"
                                                                                           CornerRadius="12"
                                                                                           Width="188"
                                                                                           Padding="16"
                                                                                           HorizontalAlignment="Center"
                                                                                           Margin="{StaticResource NegativeMarginTop8}">
                                                                                          <TextBlock
                                                                                                 Classes="docs-chip"
                                                                                                 HorizontalAlignment="Center"
                                                                                                 Text="NegativeMarginTop8"/>
                                                                                    </Border>
                                                                              </StackPanel>
                                                                        </Border>
                                                                  </Grid>
                                                            </Border>
                                                            <Border
                                                                   BorderBrush="{StaticResource BrushSlate800}"
                                                                   BorderThickness="0,1,0,0"
                                                                   Padding="20,16">
                                                                  <StackPanel
                                                                         Spacing="6">
                                                                        <TextBlock
                                                                               Classes="docs-miniTitle"
                                                                               Text="AXAML"/>
                                                                        <TextBlock
                                                                               Classes="docs-code"
                                                                               xml:space="preserve">&lt;Border
  Margin=&quot;{StaticResource NegativeMarginTop8}&quot; /&gt;</TextBlock>
                                                                  </StackPanel>
