                                                                                </Border.RenderTransform>
                                                                                <TextBlock
                                                                                    Classes="docs-chip"
                                                                                    HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center"
                                                                                    Text="me-8" />
                                                                            </Border>
