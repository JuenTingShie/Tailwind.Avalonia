<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:media="clr-namespace:Avalonia.Media;assembly=Avalonia.Base"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Spacing.Margin">
    <docs:DocsPage
        Section="Spacing"
        Title="Margin"
        Intro="Utilities for controlling an element&apos;s margin. Margin currently maps the numeric spacing scale, bracket arbitrary values, and negative variants onto Avalonia&apos;s Margin thickness, together with the logical side utilities."
        Supported="m-&lt;number&gt; sets margin on all sides; mx-*/my-* target an axis, mt/mr/mb/ml-* target one physical side, and the logical ms/me-* (inline start/end) and mbs/mbe-* (block start/end) follow the flow direction. A leading minus sign, as in -mt-8, negates any of these, and bracket arbitrary values like m-[8px] take a direct value. Auto values, such as m-auto and its axis/logical variants, and custom properties are still out of scope. As in Tailwind v4, &lt;number&gt; is any multiple of 0.25 on the 4px spacing scale, so values like 13 or 17 work too."
        GapsBody="These Tailwind margin rows remain outside the current parser surface.">
        <docs:DocsPage.Utilities>
            <docs:UtilityReferenceRow ClassName="m-&lt;number&gt;" AxamlStyle="&lt;Border Margin=&quot;&lt;number&gt;&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="m-[&lt;value&gt;]" AxamlStyle="&lt;Border Margin=&quot;&lt;parsed value&gt;&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="mx-&lt;number&gt;" AxamlStyle="&lt;Border Margin=&quot;&lt;number&gt;,0,&lt;number&gt;,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="mx-[&lt;value&gt;]" AxamlStyle="&lt;Border Margin=&quot;&lt;parsed&gt;,0,&lt;parsed&gt;,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="my-&lt;number&gt;" AxamlStyle="&lt;Border Margin=&quot;0,&lt;number&gt;,0,&lt;number&gt;&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="my-[&lt;value&gt;]" AxamlStyle="&lt;Border Margin=&quot;0,&lt;parsed&gt;,0,&lt;parsed&gt;&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="mt-&lt;number&gt;" AxamlStyle="&lt;Border Margin=&quot;0,&lt;number&gt;,0,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="mt-[&lt;value&gt;]" AxamlStyle="&lt;Border Margin=&quot;0,&lt;parsed&gt;,0,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="mr-&lt;number&gt;" AxamlStyle="&lt;Border Margin=&quot;0,0,&lt;number&gt;,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="mr-[&lt;value&gt;]" AxamlStyle="&lt;Border Margin=&quot;0,0,&lt;parsed&gt;,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="mb-&lt;number&gt;" AxamlStyle="&lt;Border Margin=&quot;0,0,0,&lt;number&gt;&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="mb-[&lt;value&gt;]" AxamlStyle="&lt;Border Margin=&quot;0,0,0,&lt;parsed&gt;&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="ml-&lt;number&gt;" AxamlStyle="&lt;Border Margin=&quot;&lt;number&gt;,0,0,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="ml-[&lt;value&gt;]" AxamlStyle="&lt;Border Margin=&quot;&lt;parsed&gt;,0,0,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="ms-&lt;number&gt;" AxamlStyle="LTR &lt;Border Margin=&quot;&lt;number&gt;,0,0,0&quot; /&gt;; RTL &lt;Border Margin=&quot;0,0,&lt;number&gt;,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="ms-[&lt;value&gt;]" AxamlStyle="LTR &lt;Border Margin=&quot;&lt;parsed&gt;,0,0,0&quot; /&gt;; RTL &lt;Border Margin=&quot;0,0,&lt;parsed&gt;,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="me-&lt;number&gt;" AxamlStyle="LTR &lt;Border Margin=&quot;0,0,&lt;number&gt;,0&quot; /&gt;; RTL &lt;Border Margin=&quot;&lt;number&gt;,0,0,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="me-[&lt;value&gt;]" AxamlStyle="LTR &lt;Border Margin=&quot;0,0,&lt;parsed&gt;,0&quot; /&gt;; RTL &lt;Border Margin=&quot;&lt;parsed&gt;,0,0,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="mbs-&lt;number&gt;" AxamlStyle="&lt;Border Margin=&quot;0,&lt;number&gt;,0,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="mbs-[&lt;value&gt;]" AxamlStyle="&lt;Border Margin=&quot;0,&lt;parsed&gt;,0,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="mbe-&lt;number&gt;" AxamlStyle="&lt;Border Margin=&quot;0,0,0,&lt;number&gt;&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="mbe-[&lt;value&gt;]" AxamlStyle="&lt;Border Margin=&quot;0,0,0,&lt;parsed&gt;&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="-m-&lt;number&gt;" AxamlStyle="&lt;Border Margin=&quot;-&lt;number&gt;&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="-m-[&lt;value&gt;]" AxamlStyle="&lt;Border Margin=&quot;-&lt;parsed value&gt;&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="-mx-&lt;number&gt;" AxamlStyle="&lt;Border Margin=&quot;-&lt;number&gt;,0,-&lt;number&gt;,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="-mx-[&lt;value&gt;]" AxamlStyle="&lt;Border Margin=&quot;-&lt;parsed&gt;,0,-&lt;parsed&gt;,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="-my-&lt;number&gt;" AxamlStyle="&lt;Border Margin=&quot;0,-&lt;number&gt;,0,-&lt;number&gt;&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="-my-[&lt;value&gt;]" AxamlStyle="&lt;Border Margin=&quot;0,-&lt;parsed&gt;,0,-&lt;parsed&gt;&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="-mt-&lt;number&gt;" AxamlStyle="&lt;Border Margin=&quot;0,-&lt;number&gt;,0,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="-mt-[&lt;value&gt;]" AxamlStyle="&lt;Border Margin=&quot;0,-&lt;parsed&gt;,0,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="-mr-&lt;number&gt;" AxamlStyle="&lt;Border Margin=&quot;0,0,-&lt;number&gt;,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="-mr-[&lt;value&gt;]" AxamlStyle="&lt;Border Margin=&quot;0,0,-&lt;parsed&gt;,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="-mb-&lt;number&gt;" AxamlStyle="&lt;Border Margin=&quot;0,0,0,-&lt;number&gt;&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="-mb-[&lt;value&gt;]" AxamlStyle="&lt;Border Margin=&quot;0,0,0,-&lt;parsed&gt;&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="-ml-&lt;number&gt;" AxamlStyle="&lt;Border Margin=&quot;-&lt;number&gt;,0,0,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="-ml-[&lt;value&gt;]" AxamlStyle="&lt;Border Margin=&quot;-&lt;parsed&gt;,0,0,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="-ms-&lt;number&gt;" AxamlStyle="LTR &lt;Border Margin=&quot;-&lt;number&gt;,0,0,0&quot; /&gt;; RTL &lt;Border Margin=&quot;0,0,-&lt;number&gt;,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="-ms-[&lt;value&gt;]" AxamlStyle="LTR &lt;Border Margin=&quot;-&lt;parsed&gt;,0,0,0&quot; /&gt;; RTL &lt;Border Margin=&quot;0,0,-&lt;parsed&gt;,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="-me-&lt;number&gt;" AxamlStyle="LTR &lt;Border Margin=&quot;0,0,-&lt;number&gt;,0&quot; /&gt;; RTL &lt;Border Margin=&quot;-&lt;number&gt;,0,0,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="-me-[&lt;value&gt;]" AxamlStyle="LTR &lt;Border Margin=&quot;0,0,-&lt;parsed&gt;,0&quot; /&gt;; RTL &lt;Border Margin=&quot;-&lt;parsed&gt;,0,0,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="-mbs-&lt;number&gt;" AxamlStyle="&lt;Border Margin=&quot;0,-&lt;number&gt;,0,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="-mbs-[&lt;value&gt;]" AxamlStyle="&lt;Border Margin=&quot;0,-&lt;parsed&gt;,0,0&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="-mbe-&lt;number&gt;" AxamlStyle="&lt;Border Margin=&quot;0,0,0,-&lt;number&gt;&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="-mbe-[&lt;value&gt;]" AxamlStyle="&lt;Border Margin=&quot;0,0,0,-&lt;parsed&gt;&quot; /&gt;" />
        </docs:DocsPage.Utilities>
        <docs:DocsPage.Gaps>
            <docs:DocsGap Text="m-auto · mx-auto · my-auto · ms-auto · me-auto" />
            <docs:DocsGap Text="m-(&lt;custom-property&gt;) · mx-(&lt;custom-property&gt;) · my-(&lt;custom-property&gt;) · mt-(&lt;custom-property&gt;) · mr-(&lt;custom-property&gt;) · mb-(&lt;custom-property&gt;) · ml-(&lt;custom-property&gt;)" />
        </docs:DocsPage.Gaps>

        <docs:DocsSection
            Heading="Basic example"
            Summary="Use m-&lt;number&gt; utilities like m-4 and m-8 to control the outer space on all sides of an element.">
            <docs:DocsExample>
                <docs:MarginSpecimen
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Frame="w-[280px] h-[120px]"
                    Box="bg-sky-500 m-8"
                    OnColor="True"
                    ShowCode="True" />
            </docs:DocsExample>
        </docs:DocsSection>

        <docs:DocsSection
            Heading="Adding margin to one side"
            Summary="Use mt-&lt;number&gt;, mr-&lt;number&gt;, mb-&lt;number&gt;, and ml-&lt;number&gt; utilities like mt-6 and mr-4 to control margin on one side of an element.">
            <docs:DocsExample>
                <Border
                    tw:Tw.Class="border-slate-800 max-w-[620px]"
                    BorderThickness="1"
                    HorizontalAlignment="Center">
                    <Grid
                        RowDefinitions="Auto, Auto, Auto"
                        ColumnDefinitions="Auto, *, *, Auto">
                        <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            Classes="docs-marginShell"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top">
                            <Border
                                docs:DocsCode.Show="True"
                                tw:Tw.Class="bg-violet-500 mt-6 w-[68px] h-14"
                                CornerRadius="12">
                                <docs:DocsChip OnColor="True" Text="mt-6" />
                            </Border>
                        </Border>
                        <Border
                            Grid.Row="1"
                            Grid.Column="0"
                            Classes="docs-marginShell"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                            <Border
                                docs:DocsCode.Show="True"
                                tw:Tw.Class="bg-violet-500 ml-2 w-16 h-14"
                                CornerRadius="12">
                                <docs:DocsChip OnColor="True" Text="ml-2" />
                            </Border>
                        </Border>
                        <Border
                            Grid.Row="1"
                            Grid.Column="3"
                            Classes="docs-marginShell"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                            <Border
                                docs:DocsCode.Show="True"
                                tw:Tw.Class="bg-violet-500 mr-4 w-16 h-14"
                                CornerRadius="12">
                                <docs:DocsChip OnColor="True" Text="mr-4" />
                            </Border>
                        </Border>
                        <Border
                            Grid.Row="2"
                            Grid.Column="2"
                            Classes="docs-marginShell"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom">
                            <Border
                                docs:DocsCode.Show="True"
                                tw:Tw.Class="bg-violet-500 mb-8 w-[68px] h-14"
                                CornerRadius="12">
                                <docs:DocsChip OnColor="True" Text="mb-8" />
                            </Border>
                        </Border>
                    </Grid>
                </Border>
            </docs:DocsExample>
        </docs:DocsSection>

        <docs:DocsSection
            Heading="Adding horizontal and vertical margin"
            Summary="Use mx-&lt;number&gt; and my-&lt;number&gt; utilities like mx-8 and my-8 to control axis-specific margin.">
            <docs:DocsExample>
                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="24">
                    <Border
                        Classes="docs-marginShell">
                        <Border
                            docs:DocsCode.Show="True"
                            tw:Tw.Class="bg-amber-500 mx-8"
                            CornerRadius="12">
                            <Border
                                tw:Tw.Class="w-[72px] h-14">
                                <docs:DocsChip OnColor="True" Text="mx-8" />
                            </Border>
                        </Border>
                    </Border>
                    <Border
                        Classes="docs-marginShell">
                        <Border
                            docs:DocsCode.Show="True"
                            tw:Tw.Class="bg-rose-500 my-8"
                            CornerRadius="12">
                            <Border
                                tw:Tw.Class="w-[72px] h-14">
                                <docs:DocsChip OnColor="True" Text="my-8" />
                            </Border>
                        </Border>
                    </Border>
                </StackPanel>
            </docs:DocsExample>
        </docs:DocsSection>

        <docs:DocsSection
            Heading="Using negative values"
            Summary="Prefix a margin utility with a leading minus sign, like -mt-8, when you need elements to intentionally overlap.">
            <docs:DocsExample>
                <Border
                    Classes="docs-marginShell"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <StackPanel
                        Spacing="0">
                        <Border
                            docs:DocsCode.Show="True"
                            tw:Tw.Class="bg-sky-400 w-60 p-4"
                            CornerRadius="12">
                            <TextBlock
                                Classes="docs-chip"
                                HorizontalAlignment="Center"
                                Text="base block" />
                        </Border>
                        <Border
                            docs:DocsCode.Show="True"
                            tw:Tw.Class="bg-blue-500 -mt-8 w-[188px] p-4"
                            CornerRadius="12"
                            HorizontalAlignment="Center">
                            <TextBlock
                                Classes="docs-chip"
                                HorizontalAlignment="Center"
                                Text="-mt-8" />
                        </Border>
                    </StackPanel>
                </Border>
            </docs:DocsExample>
        </docs:DocsSection>

        <docs:DocsSection
            Heading="Using logical properties"
            Summary="Use ms-&lt;number&gt;, me-&lt;number&gt;, mbs-&lt;number&gt;, and mbe-&lt;number&gt; utilities when margin should follow the current text direction or writing mode. In Avalonia RTL, logical layout is resolved first from FlowDirection, then the final rendered result is mirrored, so the screen side can differ from the physical margin side.">
            <StackPanel
                Spacing="18">
                <docs:DocsNote
                    Classes="supported"
                    Title="Teaching note"
                    Body="The visualized side-mapping demo below adds ScaleTransform only to cancel Avalonia&apos;s automatic RTL mirror for teaching. In the real RTL demo, layout logic is applied first, then Avalonia&apos;s mirror changes the final rendered side. Real app usage is the unmodified RTL rendering demo and the code examples below." />
                <docs:DocsExample
                    CodeLabel="Actual usage">
                    <StackPanel
                        Spacing="24">
                        <StackPanel
                            Spacing="16">
                            <TextBlock
                                Classes="docs-miniTitle"
                                Text="Real RTL rendering" />
                            <TextBlock
                                Classes="docs-noteBody"
                                Text="This preview shows the actual Avalonia result when FlowDirection changes. It uses tw:Tw.Class and FlowDirection only, with no extra transforms. Under RTL, the logical margin is calculated first, then Avalonia mirrors the rendered output." />
                            <docs:DirectionCompare>
                                <docs:DirectionCompare.LeftToRight>
                                    <StackPanel
                                        Orientation="Vertical"
                                        Spacing="12">
                                        <docs:DirectionRow Start="start -&gt;" End="&lt;- end">
                                            <docs:MarginSpecimen
                                                FlowDirection="LeftToRight"
                                                Frame="h-20"
                                                Box="bg-lime-500 ms-8"
                                                ShowCode="True"
                                                CodeAttributes="FlowDirection" />
                                        </docs:DirectionRow>
                                        <docs:DirectionRow Start="start -&gt;" End="&lt;- end">
                                            <docs:MarginSpecimen
                                                FlowDirection="LeftToRight"
                                                Frame="h-20"
                                                Box="bg-cyan-500 me-8"
                                                ShowCode="True"
                                                CodeAttributes="FlowDirection" />
                                        </docs:DirectionRow>
                                    </StackPanel>
                                </docs:DirectionCompare.LeftToRight>
                                <docs:DirectionCompare.RightToLeft>
                                    <StackPanel
                                        Orientation="Vertical"
                                        Spacing="12">
                                        <docs:DirectionRow Start="end -&gt;" End="&lt;- start">
                                            <docs:MarginSpecimen
                                                FlowDirection="RightToLeft"
                                                Frame="h-20"
                                                Box="bg-lime-500 ms-8"
                                                ShowCode="True"
                                                CodeAttributes="FlowDirection" />
                                        </docs:DirectionRow>
                                        <docs:DirectionRow Start="end -&gt;" End="&lt;- start">
                                            <docs:MarginSpecimen
                                                FlowDirection="RightToLeft"
                                                Frame="h-20"
                                                Box="bg-cyan-500 me-8"
                                                ShowCode="True"
                                                CodeAttributes="FlowDirection" />
                                        </docs:DirectionRow>
                                    </StackPanel>
                                </docs:DirectionCompare.RightToLeft>
                            </docs:DirectionCompare>
                        </StackPanel>
                        <StackPanel
                            Spacing="16">
                            <TextBlock
                                Classes="docs-miniTitle"
                                Text="Block start and end" />
                            <TextBlock
                                Classes="docs-noteBody"
                                Text="In the sample&apos;s horizontal writing mode, mbs-8 stays on top and mbe-8 stays on bottom in both LTR and RTL. FlowDirection changes inline start and end, but it does not remap the block axis here." />
                            <docs:DirectionCompare>
                                <docs:DirectionCompare.LeftToRight>
                                    <StackPanel
                                        Orientation="Vertical"
                                        Spacing="12">
                                        <docs:DirectionRow Orientation="Vertical" Start="block start" End="block end">
                                            <docs:MarginSpecimen
                                                HorizontalAlignment="Center"
                                                FlowDirection="LeftToRight"
                                                Frame="w-32 h-20"
                                                Box="bg-fuchsia-500 mbs-8"
                                                ShowCode="True"
                                                CodeAttributes="FlowDirection" />
                                        </docs:DirectionRow>
                                        <docs:DirectionRow Orientation="Vertical" Start="block start" End="block end">
                                            <docs:MarginSpecimen
                                                HorizontalAlignment="Center"
                                                FlowDirection="LeftToRight"
                                                Frame="w-32 h-20"
                                                Box="bg-sky-500 mbe-8"
                                                OnColor="True"
                                                ShowCode="True"
                                                CodeAttributes="FlowDirection" />
                                        </docs:DirectionRow>
                                    </StackPanel>
                                </docs:DirectionCompare.LeftToRight>
                                <docs:DirectionCompare.RightToLeft>
                                    <StackPanel
                                        Orientation="Vertical"
                                        Spacing="12">
                                        <docs:DirectionRow Orientation="Vertical" Start="block start" End="block end">
                                            <docs:MarginSpecimen
                                                HorizontalAlignment="Center"
                                                FlowDirection="RightToLeft"
                                                Frame="w-32 h-20"
                                                Box="bg-fuchsia-500 mbs-8"
                                                ShowCode="True"
                                                CodeAttributes="FlowDirection" />
                                        </docs:DirectionRow>
                                        <docs:DirectionRow Orientation="Vertical" Start="block start" End="block end">
                                            <docs:MarginSpecimen
                                                HorizontalAlignment="Center"
                                                FlowDirection="RightToLeft"
                                                Frame="w-32 h-20"
                                                Box="bg-sky-500 mbe-8"
                                                OnColor="True"
                                                ShowCode="True"
                                                CodeAttributes="FlowDirection" />
                                        </docs:DirectionRow>
                                    </StackPanel>
                                </docs:DirectionCompare.RightToLeft>
                            </docs:DirectionCompare>
                        </StackPanel>
                        <StackPanel
                            Spacing="16">
                            <TextBlock
                                Classes="docs-miniTitle"
                                Text="Visualized side mapping" />
                            <TextBlock
                                Classes="docs-noteBody"
                                Text="This teaching preview cancels Avalonia&apos;s RTL mirror so the physical start/end side is easier to inspect side-by-side." />
                            <docs:DirectionCompare>
                                <docs:DirectionCompare.LeftToRight>
                                    <StackPanel
                                        Orientation="Vertical"
                                        Spacing="12">
                                        <docs:MarginSpecimen
                                            FlowDirection="LeftToRight"
                                            Frame="h-20"
                                            Box="bg-lime-500 ms-8"
                                            ShowCode="True"
                                            CodeAttributes="FlowDirection" />
                                        <docs:MarginSpecimen
                                            FlowDirection="LeftToRight"
                                            Frame="h-20"
                                            Box="bg-cyan-500 me-8"
                                            ShowCode="True"
                                            CodeAttributes="FlowDirection" />
                                    </StackPanel>
                                </docs:DirectionCompare.LeftToRight>
                                <docs:DirectionCompare.RightToLeft>
                                    <StackPanel
                                        Orientation="Vertical"
                                        Spacing="12">
                                        <Border
                                            Classes="docs-marginShell"
                                            FlowDirection="RightToLeft">
                                            <Grid
                                                tw:Tw.Class="h-20">
                                                <Border
                                                    CornerRadius="12"
                                                    HorizontalAlignment="Stretch"
                                                    RenderTransformOrigin="50%, 50%"
                                                    VerticalAlignment="Stretch"
                                                    tw:Tw.Class="bg-lime-500 ms-8">
                                                    <Border.RenderTransform>
                                                        <media:ScaleTransform
                                                            ScaleX="-1" />
                                                    </Border.RenderTransform>
                                                    <docs:DocsChip Text="ms-8" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Border
                                            Classes="docs-marginShell"
                                            FlowDirection="RightToLeft">
                                            <Grid
                                                tw:Tw.Class="h-20">
                                                <Border
                                                    CornerRadius="12"
                                                    HorizontalAlignment="Stretch"
                                                    RenderTransformOrigin="50%, 50%"
                                                    VerticalAlignment="Stretch"
                                                    tw:Tw.Class="bg-cyan-500 me-8">
                                                    <Border.RenderTransform>
                                                        <media:ScaleTransform
                                                            ScaleX="-1" />
                                                    </Border.RenderTransform>
                                                    <docs:DocsChip Text="me-8" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </docs:DirectionCompare.RightToLeft>
                            </docs:DirectionCompare>
                        </StackPanel>
                    </StackPanel>
                </docs:DocsExample>
            </StackPanel>
        </docs:DocsSection>

        <docs:DocsSection
            Heading="Arbitrary margin values"
            Summary="Use bracket syntax like m-[8px] for direct arbitrary values.">
            <StackPanel
                Spacing="18">
                <docs:DocsNote
                    Title="How arbitrary margins resolve">
                    <StackPanel
                        Spacing="8">
                        <TextBlock
                            Classes="docs-tableClass"
                            Text="px · rem · em · unitless · negative prefix" />
                        <TextBlock
                            Classes="docs-noteBody"
                            Text="Arbitrary margin values are parser-only and do not emit generated package keys." />
                        <TextBlock
                            Classes="docs-noteBody"
                            Text="rem and em use 16px base. Unitless values are treated as px." />
                        <TextBlock
                            Classes="docs-noteBody"
                            Text="Current parser only supports bracket arbitrary syntax. m-(&lt;custom-property&gt;) and -m-(&lt;custom-property&gt;) remain unsupported." />
                        <TextBlock
                            Classes="docs-noteBody"
                            Text="Percentages stay unsupported; a % token fails to parse and that token is dropped, while the rest of the class list still applies." />
                    </StackPanel>
                </docs:DocsNote>
                <docs:DocsExample>
                    <StackPanel
                        Spacing="12">
                        <docs:MarginSpecimen
                            HorizontalAlignment="Center"
                            Frame="w-[280px] h-[120px]"
                            Box="bg-sky-500 m-[8px]"
                            OnColor="True"
                            ShowCode="True" />
                        <Border
                            Classes="docs-marginShell"
                            HorizontalAlignment="Center">
                            <Border
                                docs:DocsCode.Show="True"
                                tw:Tw.Class="bg-emerald-500 mx-[16px] my-[12px] w-[120px] h-14"
                                CornerRadius="12">
                                <docs:DocsChip OnColor="True" Text="mx/my" />
                            </Border>
                        </Border>
                        <Border
                            Classes="docs-marginShell"
                            HorizontalAlignment="Center">
                            <StackPanel
                                Spacing="0">
                                <Border
                                    docs:DocsCode.Show="True"
                                    tw:Tw.Class="bg-sky-400 w-60 p-4"
                                    CornerRadius="12">
                                    <TextBlock
                                        Classes="docs-chip"
                                        HorizontalAlignment="Center"
                                        Text="base block" />
                                </Border>
                                <Border
                                    docs:DocsCode.Show="True"
                                    tw:Tw.Class="bg-orange-500 -m-[4px] w-[188px] p-4"
                                    CornerRadius="12"
                                    HorizontalAlignment="Center">
                                    <TextBlock
                                        Classes="docs-chip on-color"
                                        HorizontalAlignment="Center"
                                        Text="-m-[4px]" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </docs:DocsExample>
            </StackPanel>
        </docs:DocsSection>
    </docs:DocsPage>
</UserControl>
