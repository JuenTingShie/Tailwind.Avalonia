                                                <StackPanel
                                                    Spacing="16">
                                                    <TextBlock
                                                        Classes="docs-miniTitle"
                                                        Text="Visual start and end aliases" />
                                                    <TextBlock
                                                        Classes="docs-noteBody"
                                                        Text="msv-8 follows the final rendered start side, and mev-8 follows the final rendered end side. In RTL they intentionally write physical left and right margin so Avalonia&apos;s mirror lands the spacing on the expected visual side." />
                                                    <Grid
                                                        ColumnDefinitions="*,*"
                                                        ColumnSpacing="20">
                                                        <Border
                                                            Grid.Column="0"
                                                            Classes="docs-inset">
