                    <StackPanel
                        Spacing="16">
                        <TextBlock
                            Classes="docs-sectionTitle"
                            Text="Arbitrary margin values" />
                        <TextBlock
                            Classes="docs-body"
                            Text="Use bracket syntax like m-[8px] for direct arbitrary values." />
                        <Border
                            Classes="docs-note">
                            <StackPanel
                                Spacing="8">
                                <TextBlock
                                    Classes="docs-noteTitle"
                                    Text="Arbitrary margin notes" />
                                <TextBlock
                                    Classes="docs-tableClass"
                                    Text="px / rem / em / % / unitless / negative prefix" />
                                <TextBlock
                                    Classes="docs-noteBody"
                                    Text="Arbitrary margin values are parser-only and do not emit generated package keys." />
                                <TextBlock
                                    Classes="docs-noteBody"
                                    Text="rem and em use 16px base. Unitless values are treated as px." />
                                <TextBlock
                                    Classes="docs-noteBody"
                                    Text="Current parser only supports bracket arbitrary syntax. m-(&lt;custom-property&gt;) and -m-(&lt;custom-property&gt;) remain unsupported." />
                                <TextBlock
                                    Classes="docs-noteBody"
                                    Text="% tokens are currently parsed as numeric values, not CSS percentage layout." />
                            </StackPanel>
                        </Border>
                        <Border
                            Classes="docs-surface">
                            <StackPanel
                                Spacing="0">
                                <Border
                                    tw:Tw.Class="bg-slate-950"
                                    Padding="24">
                                    <StackPanel
                                        Spacing="12">
                                        <Border
                                            Classes="docs-marginShell"
                                            HorizontalAlignment="Center">
