                                                                        Classes="docs-marginShell"
                                                                        FlowDirection="LeftToRight">
                                                                        <Grid
                                                                            Height="80">
                                                                            <Border
                                                                                CornerRadius="12"
                                                                                HorizontalAlignment="Stretch"
                                                                                VerticalAlignment="Stretch"
                                                                                tw:Tw.Class="bg-lime-500 ms-8">
                                                                                <TextBlock
                                                                                    Classes="docs-chip"
                                                                                    HorizontalAlignment="Center"
                                                                                    VerticalAlignment="Center"
                                                                                    Text="ms-8" />
                                                                            </Border>
                                                                        </Grid>
                                                                    </Border>
                                                                    <Border
                                                                        Classes="docs-marginShell"
                                                                        FlowDirection="LeftToRight">
                                                                        <Grid
                                                                            Height="80">
                                                                            <Border
                                                                                CornerRadius="12"
