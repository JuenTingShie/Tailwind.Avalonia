<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sample="using:Tailwind.Avalonia.Sample">
    <Styles.Resources>
        <x:Double
            x:Key="DocsExampleTabMinWidth">112</x:Double>
        <DrawingBrush
            x:Key="SamplePaddingStripeBrush"
            DestinationRect="0,0,24,24"
            Stretch="None"
            TileMode="Tile">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing
                        Brush="{StaticResource BrushViolet400}"
                        Geometry="M0,0 H24 V24 H0 Z" />
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen
                                Brush="#55FFFFFF"
                                Thickness="2" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry
                                    StartPoint="-6,18"
                                    EndPoint="18,-6" />
                                <LineGeometry
                                    StartPoint="0,24"
                                    EndPoint="24,0" />
                                <LineGeometry
                                    StartPoint="6,30"
                                    EndPoint="30,6" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Styles.Resources>
    <Style
        Selector="TextBlock.docs-library">
        <Setter
            Property="Foreground"
            Value="{StaticResource BrushSlate500}" />
        <Setter
            Property="FontSize"
            Value="12" />
        <Setter
            Property="FontWeight"
            Value="SemiBold" />
    </Style>
    <Style
        Selector="TextBlock.docs-pageTitle">
        <Setter
            Property="Foreground"
            Value="{StaticResource BrushWhite}" />
        <Setter
            Property="FontSize"
            Value="34" />
        <Setter
            Property="FontWeight"
            Value="Bold" />
    </Style>
    <Style
        Selector="StackPanel.docs-pageLayout">
        <Setter
            Property="Margin"
            Value="28,24,40,32" />
        <Setter
            Property="Spacing"
            Value="40" />
    </Style>
    <Style
        Selector="UserControl.docs-mobile StackPanel.docs-pageLayout">
        <Setter
            Property="Margin"
            Value="16,14,16,24" />
        <Setter
            Property="Spacing"
            Value="28" />
    </Style>
    <Style
        Selector="UserControl.docs-mobile TextBlock.docs-pageTitle">
        <Setter
            Property="FontSize"
            Value="28" />
    </Style>
    <Style
        Selector="TextBlock.docs-eyebrow">
        <Setter
            Property="Foreground"
            Value="{StaticResource BrushSlate400}" />
        <Setter
            Property="FontSize"
            Value="12" />
        <Setter
            Property="FontWeight"
            Value="SemiBold" />
    </Style>
    <Style
        Selector="TextBlock.docs-body">
        <Setter
            Property="Foreground"
            Value="{StaticResource BrushSlate300}" />
        <Setter
            Property="FontSize"
            Value="16" />
        <Setter
            Property="TextWrapping"
            Value="Wrap" />
        <Setter
            Property="MaxWidth"
            Value="900" />
    </Style>
    <Style
        Selector="UserControl.docs-mobile TextBlock.docs-body">
        <Setter
            Property="FontSize"
            Value="15" />
    </Style>
    <Style
        Selector="TextBlock.docs-sectionTitle">
        <Setter
            Property="Foreground"
            Value="{StaticResource BrushWhite}" />
        <Setter
            Property="FontSize"
            Value="24" />
        <Setter
            Property="FontWeight"
            Value="SemiBold" />
    </Style>
    <Style
        Selector="UserControl.docs-mobile TextBlock.docs-sectionTitle">
        <Setter
            Property="FontSize"
            Value="21" />
    </Style>
    <Style
        Selector="TextBlock.docs-noteTitle">
        <Setter
            Property="Foreground"
            Value="{StaticResource BrushWhite}" />
        <Setter
            Property="FontSize"
            Value="14" />
        <Setter
            Property="FontWeight"
            Value="SemiBold" />
    </Style>
    <Style
        Selector="TextBlock.docs-noteBody">
        <Setter
            Property="Foreground"
            Value="{StaticResource BrushSlate300}" />
        <Setter
            Property="FontSize"
            Value="14" />
        <Setter
            Property="TextWrapping"
            Value="Wrap" />
        <Setter
            Property="MaxWidth"
            Value="900" />
    </Style>
    <Style
        Selector="TextBlock.docs-miniTitle">
        <Setter
            Property="Foreground"
            Value="{StaticResource BrushSlate200}" />
        <Setter
            Property="FontSize"
            Value="13" />
        <Setter
            Property="FontWeight"
            Value="SemiBold" />
    </Style>
    <Style
        Selector="TextBlock.docs-code">
        <Setter
            Property="Foreground"
            Value="{StaticResource BrushSlate200}" />
        <Setter
            Property="FontSize"
            Value="14" />
        <Setter
            Property="TextWrapping"
            Value="Wrap" />
        <Setter
            Property="FontFamily"
            Value="Cascadia Mono, Consolas" />
        <Setter
            Property="sample:DocsCodeTextBehavior.NormalizeIndent"
            Value="True" />
    </Style>
    <Style
        Selector="UserControl.docs-mobile TextBlock.docs-code">
        <Setter
            Property="FontSize"
            Value="13" />
    </Style>
    <Style
        Selector="TextBlock.docs-chip">
        <Setter
            Property="Foreground"
            Value="{StaticResource BrushWhite}" />
        <Setter
            Property="FontSize"
            Value="14" />
        <Setter
            Property="FontWeight"
            Value="Bold" />
    </Style>
    <Style
        Selector="TabControl.docs-exampleTabs">
        <Setter
            Property="Background"
            Value="Transparent" />
        <Setter
            Property="BorderBrush"
            Value="Transparent" />
        <Setter
            Property="BorderThickness"
            Value="0" />
    </Style>
    <Style
        Selector="TabItem.docs-exampleTab">
        <Setter
            Property="MinWidth"
            Value="{StaticResource DocsExampleTabMinWidth}" />
        <Setter
            Property="Margin"
            Value="0,0,8,0" />
        <Setter
            Property="Padding"
            Value="14,10" />
        <Setter
            Property="FontSize"
            Value="13" />
        <Setter
            Property="FontWeight"
            Value="SemiBold" />
        <Setter
            Property="Foreground"
            Value="{StaticResource BrushSlate300}" />
        <Setter
            Property="Background"
            Value="{StaticResource BrushSlate950}" />
        <Setter
            Property="BorderBrush"
            Value="{StaticResource BrushSlate800}" />
        <Setter
            Property="BorderThickness"
            Value="1" />
        <Setter
            Property="HorizontalContentAlignment"
            Value="Center" />
    </Style>
    <Style
        Selector="UserControl.docs-mobile TabItem.docs-exampleTab">
        <Setter
            Property="MinWidth"
            Value="92" />
        <Setter
            Property="Margin"
            Value="0,0,6,0" />
        <Setter
            Property="Padding"
            Value="12,8" />
        <Setter
            Property="FontSize"
            Value="12" />
    </Style>
    <Style
        Selector="TabItem.docs-exampleTab:selected">
        <Setter
            Property="Foreground"
            Value="{StaticResource BrushWhite}" />
        <Setter
            Property="Background"
            Value="{StaticResource BrushSlate800}" />
        <Setter
            Property="BorderBrush"
            Value="{StaticResource BrushSlate700}" />
    </Style>
    <Style
        Selector="Border.docs-surface">
        <Setter
            Property="Background"
            Value="{StaticResource BrushSlate900}" />
        <Setter
            Property="BorderBrush"
            Value="{StaticResource BrushSlate800}" />
        <Setter
            Property="BorderThickness"
            Value="1" />
        <Setter
            Property="CornerRadius"
            Value="20" />
        <Setter
            Property="ClipToBounds"
            Value="True" />
    </Style>
    <Style
        Selector="Border.docs-note">
        <Setter
            Property="Background"
            Value="{StaticResource BrushSlate900}" />
        <Setter
            Property="BorderBrush"
            Value="{StaticResource BrushSlate800}" />
        <Setter
            Property="BorderThickness"
            Value="1" />
        <Setter
            Property="CornerRadius"
            Value="16" />
        <Setter
            Property="Padding"
            Value="18" />
    </Style>
    <Style
        Selector="Border.docs-inset">
        <Setter
            Property="Background"
            Value="{StaticResource BrushSlate800}" />
        <Setter
            Property="BorderBrush"
            Value="{StaticResource BrushSlate700}" />
        <Setter
            Property="BorderThickness"
            Value="1" />
        <Setter
            Property="CornerRadius"
            Value="16" />
        <Setter
            Property="Padding"
            Value="16" />
    </Style>
    <Style
        Selector="Border.docs-paddingShell">
        <Setter
            Property="Background"
            Value="{StaticResource SamplePaddingStripeBrush}" />
        <Setter
            Property="CornerRadius"
            Value="12" />
        <Setter
            Property="ClipToBounds"
            Value="True" />
    </Style>
    <Style
        Selector="Border.docs-paddingCore">
        <Setter
            Property="Background"
            Value="{StaticResource BrushViolet600}" />
        <Setter
            Property="CornerRadius"
            Value="12" />
    </Style>
    <Style
        Selector="Border.docs-marginShell">
        <Setter
            Property="Background"
            Value="{StaticResource SamplePaddingStripeBrush}" />
        <Setter
            Property="BorderBrush"
            Value="{StaticResource BrushSlate700}" />
        <Setter
            Property="BorderThickness"
            Value="1" />
        <Setter
            Property="CornerRadius"
            Value="16" />
        <Setter
            Property="Padding"
            Value="0" />
        <Setter
            Property="ClipToBounds"
            Value="True" />
    </Style>
    <Style
        Selector="Border.docs-referenceHeader">
        <Setter
            Property="Background"
            Value="{StaticResource BrushSlate900}" />
        <Setter
            Property="BorderBrush"
            Value="{StaticResource BrushSlate800}" />
        <Setter
            Property="BorderThickness"
            Value="0,0,0,1" />
        <Setter
            Property="Padding"
            Value="18,14" />
    </Style>
    <Style
        Selector="UserControl.docs-mobile Border.docs-referenceHeader">
        <Setter
            Property="Padding"
            Value="14,12" />
    </Style>
    <Style
        Selector="ItemsControl.docs-referenceList">
        <Setter
            Property="HorizontalAlignment"
            Value="Stretch" />
    </Style>
    <Style
        Selector="Border.docs-referenceRow">
        <Setter
            Property="Background"
            Value="{StaticResource BrushSlate950}" />
        <Setter
            Property="BorderBrush"
            Value="{StaticResource BrushSlate800}" />
        <Setter
            Property="BorderThickness"
            Value="0,0,0,1" />
        <Setter
            Property="Padding"
            Value="18,14" />
    </Style>
    <Style
        Selector="UserControl.docs-mobile Border.docs-referenceRow">
        <Setter
            Property="Padding"
            Value="14,12" />
    </Style>
    <Style
        Selector="Grid.docs-referenceColumns">
        <Setter
            Property="ColumnSpacing"
            Value="24" />
    </Style>
    <Style
        Selector="UserControl.docs-mobile Grid.docs-referenceColumns">
        <Setter
            Property="ColumnSpacing"
            Value="14" />
    </Style>
    <Style
        Selector="TextBlock.docs-referenceHeading">
        <Setter
            Property="Foreground"
            Value="{StaticResource BrushWhite}" />
        <Setter
            Property="FontSize"
            Value="15" />
        <Setter
            Property="FontWeight"
            Value="SemiBold" />
    </Style>
    <Style
        Selector="TextBlock.docs-tableClass">
        <Setter
            Property="Foreground"
            Value="{StaticResource BrushSky400}" />
        <Setter
            Property="FontFamily"
            Value="Cascadia Mono, Consolas" />
        <Setter
            Property="FontSize"
            Value="14" />
        <Setter
            Property="FontWeight"
            Value="SemiBold" />
        <Setter
            Property="TextWrapping"
            Value="Wrap" />
    </Style>
    <Style
        Selector="TextBlock.docs-tableStyle">
        <Setter
            Property="Foreground"
            Value="{StaticResource BrushViolet300}" />
        <Setter
            Property="FontFamily"
            Value="Cascadia Mono, Consolas" />
        <Setter
            Property="FontSize"
            Value="13" />
        <Setter
            Property="TextWrapping"
            Value="Wrap" />
    </Style>
    <Style
        Selector="Button.docs-showMoreButton">
        <Setter
            Property="BorderBrush"
            Value="{StaticResource BrushSlate600}" />
        <Setter
            Property="Background"
            Value="{StaticResource BrushSlate700}" />
        <Setter
            Property="BorderThickness"
            Value="1" />
        <Setter
            Property="Foreground"
            Value="{StaticResource BrushWhite}" />
        <Setter
            Property="FontSize"
            Value="12" />
        <Setter
            Property="FontWeight"
            Value="Bold" />
        <Setter
            Property="HorizontalContentAlignment"
            Value="Center" />
        <Setter
            Property="MinWidth"
            Value="132" />
        <Setter
            Property="Padding"
            Value="18,10" />
        <Setter
            Property="CornerRadius"
            Value="3" />
    </Style>
    <Style
        Selector="Button.docs-showMoreButton:pointerover">
        <Setter
            Property="Opacity"
            Value="0.92" />
    </Style>
    <Style
        Selector="Button.docs-showMoreButton:pressed">
        <Setter
            Property="Opacity"
            Value="0.8" />
    </Style>
</Styles>
