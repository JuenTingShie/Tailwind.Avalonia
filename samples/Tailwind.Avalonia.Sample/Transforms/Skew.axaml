<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Transforms.Skew">
    <docs:DocsPage
        Section="Transforms"
        Title="Skew"
        Intro="Utilities for skewing an element. They map to Avalonia&#x27;s RenderTransform.">
        <StackPanel
            Spacing="52">
            <StackPanel
                Classes="docs-overviewStack">
                <docs:DocsNote
                    Classes="supported"
                    Title="Implemented in this sample"
                    Body="rotate-*, scale-*, translate-*, skew-* and origin-* build one RenderTransform (and RenderTransformOrigin) for the element. Several transform classes on one element combine, with the translation applied outermost as in CSS, so it is not rotated or scaled. rotate and skew take degrees (rotate-45, rotate-[30deg]), scale takes percentages (scale-150 is 1.5x), translate uses the spacing scale (translate-x-4 is 16px) and a leading minus reverses the sign. Like CSS transforms, RenderTransform does not change layout. It is available on every visual on every target." />
                <docs:DocsUtilityTable
                    x:Name="UtilityTable"
                    CollapsedRowCount="6" />
            </StackPanel>

            <StackPanel
                Spacing="22">
                <TextBlock
                    Classes="docs-eyebrow"
                    Text="Examples" />
                <StackPanel
                    Classes="docs-exampleStack">
                    <docs:DocsSection
                        Heading="Skewing"
                        Summary="Skew angles are degrees. Negative values slant the other way.">
                        <docs:DocsExample>
                            <docs:DocsExample.Snippets>
                                <x:String>&lt;Border tw:Tw.Class=&quot;skew-x-12&quot; /&gt;</x:String>
                                <x:String>&lt;Border tw:Tw.Class=&quot;-skew-y-6&quot; /&gt;</x:String>
                            </docs:DocsExample.Snippets>
                            <WrapPanel
                                ItemSpacing="36"
                                LineSpacing="36"
                                Margin="24"
                                Width="460"
                                HorizontalAlignment="Left">
                                <Border
                                    tw:Tw.Class="skew-x-12 w-16 h-16 rounded-md bg-sky-600 text-white p-1">
                                    <TextBlock
                                        FontSize="11"
                                        Text="skew-x-12" />
                                </Border>
                                <Border
                                    tw:Tw.Class="-skew-y-6 w-16 h-16 rounded-md bg-sky-600 text-white p-1">
                                    <TextBlock
                                        FontSize="11"
                                        Text="-skew-y-6" />
                                </Border>
                            </WrapPanel>
                        </docs:DocsExample>
                    </docs:DocsSection>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </docs:DocsPage>
</UserControl>
