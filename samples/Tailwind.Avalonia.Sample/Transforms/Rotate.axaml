<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Transforms.Rotate">
    <docs:DocsPage
        Section="Transforms"
        Title="Rotate"
        Intro="Utilities for rotating an element. They map to Avalonia&#x27;s RenderTransform."
        Supported="rotate-*, scale-*, translate-*, skew-* and origin-* build one RenderTransform (and RenderTransformOrigin) for the element. Several transform classes on one element combine, with the translation applied outermost as in CSS, so it is not rotated or scaled. rotate and skew take degrees (rotate-45, rotate-[30deg]), scale takes percentages (scale-150 is 1.5x), translate uses the spacing scale (translate-x-4 is 16px) and a leading minus reverses the sign. Like CSS transforms, RenderTransform does not change layout. It is available on every visual on every target.">
        <docs:DocsPage.Utilities>
            <docs:UtilityReferenceRow ClassName="rotate-&lt;deg&gt;" AxamlStyle="RenderTransform: rotate n degrees" />
            <docs:UtilityReferenceRow ClassName="-rotate-&lt;deg&gt;" AxamlStyle="RenderTransform: rotate -n degrees" />
            <docs:UtilityReferenceRow ClassName="rotate-[&lt;deg&gt;deg]" AxamlStyle="RenderTransform: arbitrary angle in degrees" />
            <docs:UtilityReferenceRow ClassName="origin-center" AxamlStyle="RenderTransformOrigin: 50% 50%" />
            <docs:UtilityReferenceRow ClassName="origin-top-left" AxamlStyle="RenderTransformOrigin: 0 0" />
            <docs:UtilityReferenceRow ClassName="origin-&lt;side&gt;" AxamlStyle="top, right, bottom, left and the corners" />
            <docs:UtilityReferenceRow ClassName="transform-none" AxamlStyle="RenderTransform: identity" />
            <docs:UtilityReferenceRow ClassName="rotate-[&lt;angle&gt;]" AxamlStyle="deg, rad, grad or turn: rotate-[0.125turn], rotate-[1rad]" />
        </docs:DocsPage.Utilities>
        <docs:DocsPage.Gaps>
            <docs:DocsGap Text="rotate-x-* · rotate-y-* · rotate-z-* · 3D rotation" />
        </docs:DocsPage.Gaps>

        <docs:DocsSection
            Heading="Rotating around the center or a corner"
            Summary="The default origin is the center. origin-top-left rotates around the top-left corner instead.">
            <docs:DocsExample>
                <WrapPanel
                    ItemSpacing="36"
                    LineSpacing="36"
                    Margin="24"
                    Width="460"
                    HorizontalAlignment="Left">
                    <Border
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="rotate-12 w-28 h-16 rounded-md bg-sky-600 p-1">
                        <TextBlock
                            FontSize="11"
                            Text="rotate-12" />
                    </Border>
                    <Border
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="-rotate-45 w-28 h-16 rounded-md bg-sky-600 p-1">
                        <TextBlock
                            FontSize="11"
                            Text="-rotate-45" />
                    </Border>
                    <Border
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="rotate-45 origin-top-left w-28 h-16 rounded-md bg-sky-600 p-1">
                        <TextBlock
                            FontSize="11"
                            Text="rotate-45 origin-top-left" />
                    </Border>
                </WrapPanel>
            </docs:DocsExample>
        </docs:DocsSection>

        <docs:DocsSection
            Heading="Using other angle units"
            Summary="Bracket values accept the CSS angle units: deg, rad, grad and turn. skew-x-[…] and skew-y-[…] take them too.">
            <docs:DocsExample>
                <WrapPanel
                    ItemSpacing="40"
                    LineSpacing="24"
                    Margin="16">
                    <Border docs:DocsCode.Show="True" tw:Tw.Class="rotate-[0.125turn] w-28 h-16 rounded-md bg-sky-600 p-1"><TextBlock FontSize="11" Text="[0.125turn]" /></Border>
                    <Border docs:DocsCode.Show="True" tw:Tw.Class="rotate-[1rad] w-28 h-16 rounded-md bg-sky-600 p-1"><TextBlock FontSize="11" Text="[1rad]" /></Border>
                    <Border docs:DocsCode.Show="True" tw:Tw.Class="-rotate-[50grad] w-28 h-16 rounded-md bg-sky-600 p-1"><TextBlock FontSize="11" Text="-[50grad]" /></Border>
                </WrapPanel>
            </docs:DocsExample>
        </docs:DocsSection>
    </docs:DocsPage>
</UserControl>
