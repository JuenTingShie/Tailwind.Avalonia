<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Transforms.Scale">
    <docs:DocsPage
        Section="Transforms"
        Title="Scale"
        Intro="Utilities for scaling an element. They map to Avalonia&#x27;s RenderTransform."
        Supported="rotate-*, scale-*, translate-*, skew-* and origin-* build one RenderTransform (and RenderTransformOrigin) for the element. Several transform classes on one element combine, with the translation applied outermost as in CSS, so it is not rotated or scaled. rotate and skew take degrees (rotate-45, rotate-[30deg]), scale takes percentages (scale-150 is 1.5x), translate uses the spacing scale (translate-x-4 is 16px) and a leading minus reverses the sign. Like CSS transforms, RenderTransform does not change layout. It is available on every visual on every target.">
        <docs:DocsPage.Utilities>
            <docs:UtilityReferenceRow ClassName="scale-&lt;n&gt;" AxamlStyle="scale x and y by n percent" />
            <docs:UtilityReferenceRow ClassName="scale-x-&lt;n&gt;" AxamlStyle="scale horizontally" />
            <docs:UtilityReferenceRow ClassName="scale-y-&lt;n&gt;" AxamlStyle="scale vertically" />
            <docs:UtilityReferenceRow ClassName="-scale-x-100" AxamlStyle="mirror horizontally" />
            <docs:UtilityReferenceRow ClassName="scale-[1.25]" AxamlStyle="arbitrary multiplier" />
        </docs:DocsPage.Utilities>
        <docs:DocsPage.Gaps>
            <docs:DocsGap Text="scale-z-* · scale-3d" />
        </docs:DocsPage.Gaps>

        <docs:DocsSection
            Heading="Scaling and mirroring"
            Summary="Percent values: scale-50 halves the element, scale-125 enlarges it. A negative scale mirrors it.">
            <docs:DocsExample>
                <WrapPanel
                    ItemSpacing="36"
                    LineSpacing="36"
                    Margin="24"
                    Width="460"
                    HorizontalAlignment="Left">
                    <Border
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="scale-50 w-28 h-16 rounded-md bg-sky-600 p-1">
                        <TextBlock
                            FontSize="11"
                            Text="scale-50" />
                    </Border>
                    <Border
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="scale-125 w-28 h-16 rounded-md bg-sky-600 p-1">
                        <TextBlock
                            FontSize="11"
                            Text="scale-125" />
                    </Border>
                    <Border
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="-scale-x-100 w-28 h-16 rounded-md bg-sky-600 p-1">
                        <TextBlock
                            FontSize="11"
                            Text="-scale-x-100" />
                    </Border>
                </WrapPanel>
            </docs:DocsExample>
        </docs:DocsSection>
    </docs:DocsPage>
</UserControl>
