<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Transforms.Scale">
    <docs:DocsPage
        Section="Transforms"
        Title="Scale"
        Intro="Utilities for scaling an element. They map to Avalonia&#x27;s RenderTransform.">
        <StackPanel
            Spacing="52">
            <StackPanel
                Classes="docs-overviewStack">
                <docs:DocsNote
                    Classes="supported"
                    Title="Implemented in this sample"
                    Body="rotate-*, scale-*, translate-*, skew-* and origin-* build one RenderTransform (and RenderTransformOrigin) for the element. Several transform classes on one element combine, with the translation applied outermost as in CSS, so it is not rotated or scaled. rotate and skew take degrees (rotate-45, rotate-[30deg]), scale takes percentages (scale-150 is 1.5x), translate uses the spacing scale (translate-x-4 is 16px) and a leading minus reverses the sign. Like CSS transforms, RenderTransform does not change layout. It is available on every visual on every target." />
                <docs:DocsUtilityTable
                    x:Name="UtilityTable"
                    CollapsedRowCount="6" />
                <docs:DocsNote
                    Classes="gap"
                    Title="Not implemented yet"
                    Body="These forms sit outside the current parser surface.">
                    <StackPanel
                        Spacing="6">
                        <TextBlock
                            Classes="docs-tableClass"
                            Text="scale-z-* · scale-3d" />
                    </StackPanel>
                </docs:DocsNote>
            </StackPanel>

            <StackPanel
                Spacing="22">
                <TextBlock
                    Classes="docs-eyebrow"
                    Text="Examples" />
                <StackPanel
                    Classes="docs-exampleStack">
                    <docs:DocsSection
                        Heading="Scaling and mirroring"
                        Summary="Percent values: scale-50 halves the element, scale-125 enlarges it. A negative scale mirrors it.">
                        <docs:DocsExample>
                            <docs:DocsExample.Snippets>
                                <x:String>&lt;Border tw:Tw.Class=&quot;scale-50&quot; /&gt;</x:String>
                                <x:String>&lt;Border tw:Tw.Class=&quot;scale-125&quot; /&gt;</x:String>
                                <x:String>&lt;Border tw:Tw.Class=&quot;-scale-x-100&quot; /&gt;</x:String>
                            </docs:DocsExample.Snippets>
                            <WrapPanel
                                ItemSpacing="36"
                                LineSpacing="36"
                                Margin="24"
                                Width="460"
                                HorizontalAlignment="Left">
                                <Border
                                    tw:Tw.Class="scale-50 w-16 h-16 rounded-md bg-sky-600 p-1">
                                    <TextBlock
                                        FontSize="11"
                                        Text="scale-50" />
                                </Border>
                                <Border
                                    tw:Tw.Class="scale-125 w-16 h-16 rounded-md bg-sky-600 p-1">
                                    <TextBlock
                                        FontSize="11"
                                        Text="scale-125" />
                                </Border>
                                <Border
                                    tw:Tw.Class="-scale-x-100 w-16 h-16 rounded-md bg-sky-600 p-1">
                                    <TextBlock
                                        FontSize="11"
                                        Text="-scale-x-100" />
                                </Border>
                            </WrapPanel>
                        </docs:DocsExample>
                    </docs:DocsSection>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </docs:DocsPage>
</UserControl>
