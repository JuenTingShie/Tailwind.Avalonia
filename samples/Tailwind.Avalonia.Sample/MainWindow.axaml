                                              Classes="docs-sectionTitle"
                                              Text="{StaticResource SampleMarginLogicalTitle}"/>
                                        <TextBlock
                                              Classes="docs-body"
                                              Text="{StaticResource SampleMarginLogicalDescription}"/>
                                        <Border
                                              Classes="docs-surface">
                                             <StackPanel
                                                   Spacing="0">
                                                  <Border
                                                        Background="{StaticResource BrushSlate950}"
                                                        MinHeight="{StaticResource SampleDocsTallPreviewHeight}"
                                                        Padding="24">
                                                       <Grid
                                                             ColumnDefinitions="*,*"
                                                             ColumnSpacing="20">
                                                            <Border
                                                                  Classes="docs-inset">
                                                                 <StackPanel
                                                                       Spacing="12">
                                                                      <TextBlock
                                                                            Classes="docs-miniTitle"
                                                                            Text="{StaticResource SampleDocsLeftToRightLabel}"/>
                                                                      <Grid
                                                                            Width="280"
                                                                            Height="120"
                                                                            FlowDirection="LeftToRight">
                                                                           <Border
                                                                                 Background="{StaticResource BrushLime500}"
                                                                                 CornerRadius="{StaticResource SampleDocsChipCornerRadius}"
                                                                                 HorizontalAlignment="Stretch"
                                                                                 VerticalAlignment="Stretch"
                                                                                 tw:Tw.Class="ms-8">
                                                                                <TextBlock
                                                                                      Classes="docs-chip"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"
                                                                                      Text="ms-8"/>
                                                                           </Border>
                                                                      </Grid>
                                                                      <StackPanel
                                                                            Orientation="Horizontal"
                                                                            FlowDirection="LeftToRight"
                                                                            Spacing="14">
                                                                           <Border
                                                                                 Classes="docs-marginShell"
                                                                                 Padding="0">
                                                                                <Grid
                                                                                      Width="128"
                                                                                      Height="80">
                                                                                     <Border
                                                                                           Background="{StaticResource BrushCyan500}"
                                                                                           CornerRadius="{StaticResource SampleDocsChipCornerRadius}"
                                                                                           HorizontalAlignment="Stretch"
                                                                                           VerticalAlignment="Stretch"
                                                                                           tw:Tw.Class="me-8">
                                                                                          <TextBlock
                                                                                                Classes="docs-chip"
                                                                                                HorizontalAlignment="Center"
                                                                                                VerticalAlignment="Center"
                                                                                                Text="me-8"/>
                                                                                     </Border>
                                                                                </Grid>
                                                                           </Border>
                                                                           <Border
                                                                                 Classes="docs-marginShell"
                                                                                 Padding="0">
                                                                                <Grid
                                                                                      Width="128"
                                                                                      Height="80">
                                                                                     <Border
                                                                                           Background="{StaticResource BrushFuchsia500}"
                                                                                           CornerRadius="{StaticResource SampleDocsChipCornerRadius}"
                                                                                           HorizontalAlignment="Stretch"
                                                                                           VerticalAlignment="Stretch"
                                                                                           tw:Tw.Class="mbs-8">
                                                                                          <TextBlock
                                                                                                Classes="docs-chip"
                                                                                                HorizontalAlignment="Center"
                                                                                                VerticalAlignment="Center"
                                                                                                Text="mbs-8"/>
                                                                                     </Border>
                                                                                </Grid>
                                                                           </Border>
                                                                      </StackPanel>
                                                                 </StackPanel>
                                                            </Border>
                                                            <Border
                                                                  Classes="docs-inset">
                                                                 <StackPanel
                                                                       Spacing="12">
                                                                      <TextBlock
                                                                            Classes="docs-miniTitle"
                                                                            Text="{StaticResource SampleDocsRightToLeftLabel}"/>
                                                                      <Grid
                                                                            Width="280"
                                                                            Height="120"
                                                                            FlowDirection="RightToLeft">
                                                                           <Border
                                                                                 Background="{StaticResource BrushLime500}"
                                                                                 CornerRadius="{StaticResource SampleDocsChipCornerRadius}"
                                                                                 HorizontalAlignment="Stretch"
                                                                                 VerticalAlignment="Stretch"
                                                                                 tw:Tw.Class="ms-8">
                                                                                <TextBlock
                                                                                      Classes="docs-chip"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"
                                                                                      Text="ms-8"/>
                                                                           </Border>
                                                                      </Grid>
                                                                      <StackPanel
                                                                            Orientation="Horizontal"
                                                                            FlowDirection="RightToLeft"
                                                                            Spacing="14">
                                                                           <Border
                                                                                 Classes="docs-marginShell"
                                                                                 Padding="0">
                                                                                <Grid
                                                                                      Width="128"
                                                                                      Height="80">
                                                                                     <Border
                                                                                           Background="{StaticResource BrushCyan500}"
                                                                                           CornerRadius="{StaticResource SampleDocsChipCornerRadius}"
                                                                                           HorizontalAlignment="Stretch"
                                                                                           VerticalAlignment="Stretch"
                                                                                           tw:Tw.Class="me-8">
                                                                                          <TextBlock
                                                                                                Classes="docs-chip"
                                                                                                HorizontalAlignment="Center"
                                                                                                VerticalAlignment="Center"
                                                                                                Text="me-8"/>
                                                                                     </Border>
                                                                                </Grid>
                                                                           </Border>
                                                                           <Border
                                                                                 Classes="docs-marginShell"
                                                                                 Padding="0">
                                                                                <Grid
                                                                                      Width="128"
                                                                                      Height="80">
                                                                                     <Border
                                                                                           Background="{StaticResource BrushFuchsia500}"
                                                                                           CornerRadius="{StaticResource SampleDocsChipCornerRadius}"
                                                                                           HorizontalAlignment="Stretch"
                                                                                           VerticalAlignment="Stretch"
                                                                                           tw:Tw.Class="mbs-8">
                                                                                          <TextBlock
                                                                                                Classes="docs-chip"
                                                                                                HorizontalAlignment="Center"
                                                                                                VerticalAlignment="Center"
                                                                                                Text="mbs-8"/>
                                                                                     </Border>
                                                                                </Grid>
                                                                           </Border>
                                                                      </StackPanel>
                                                                 </StackPanel>
                                                            </Border>
                                                       </Grid>
                                                  </Border>
                                                  <Border
                                                        BorderBrush="{StaticResource BrushSlate800}"
                                                        BorderThickness="0,1,0,0"
                                                        Padding="{StaticResource SampleDocsCodePadding}">
                                                       <TextBlock
                                                             Classes="docs-code"
                                                             Text="{StaticResource SampleMarginLogicalCode}"/>
                                                  </Border>
                                             </StackPanel>
                                        </Border>
                                   </StackPanel>
                              </StackPanel>
                         </StackPanel>
                    </ScrollViewer>
               </Border>
          </TabItem>
     </TabControl>
</Window>