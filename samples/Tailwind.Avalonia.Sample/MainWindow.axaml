<Window
     xmlns="https://github.com/avaloniaui"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
     xmlns:tw="using:Tailwind.Avalonia"
     mc:Ignorable="d"
     d:DesignWidth="800"
     d:DesignHeight="450"
     x:Class="Tailwind.Avalonia.Sample.MainWindow"
     Title="{StaticResource SampleWindowTitle}">
    <ScrollViewer>
        <StackPanel
             Margin="{StaticResource Margin8}"
             Spacing="{StaticResource SampleShowcaseSpacing}">
            <TextBlock
                 FontSize="{StaticResource SampleTitleFontSize}"
                 FontWeight="Bold"
                 Text="{StaticResource SampleShowcaseTitle}"/>
            <Border
                 Background="{StaticResource SamplePrimarySurfaceBrush}"
                 CornerRadius="{StaticResource SampleCardCornerRadius}"
                 Padding="{StaticResource Padding4}">
                <TextBlock
                     Foreground="{StaticResource SampleOnAccentBrush}"
                     Text="{StaticResource SampleStaticSpacingDescription}"/>
            </Border>
            <Border
                 Background="{StaticResource SampleSuccessSurfaceBrush}"
                 CornerRadius="{StaticResource SampleCardCornerRadius}"
                 tw:Tw.Class="{StaticResource SampleUtilitySpacingClass}">
                <TextBlock
                     Foreground="{StaticResource SampleOnAccentBrush}"
                     Text="{StaticResource SampleUtilitySpacingDescription}"/>
            </Border>
            <Border
                 Background="{StaticResource SampleWarningSurfaceBrush}"
                 CornerRadius="{StaticResource SampleCardCornerRadius}"
                 FlowDirection="RightToLeft"
                 tw:Tw.Class="{StaticResource SampleLogicalSpacingClass}">
                <TextBlock
                     Foreground="{StaticResource SampleOnAccentBrush}"
                     Text="{StaticResource SampleLogicalSpacingDescription}"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>