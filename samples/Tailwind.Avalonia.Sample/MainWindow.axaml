                                             <StackPanel
                                                   Spacing="0">
                                                  <Border
                                                        Background="{StaticResource BrushSlate950}"
                                                        Height="{StaticResource SampleDocsCompactPreviewHeight}"
                                                        Padding="24">
                                                       <Grid>
                                                            <StackPanel
                                                                  Orientation="Horizontal"
                                                                  HorizontalAlignment="Center"
                                                                  Spacing="24">
                                                                 <Border
                                                                       Classes="docs-marginShell">
                                                                      <Border
                                                                            Background="{StaticResource BrushAmber500}"
