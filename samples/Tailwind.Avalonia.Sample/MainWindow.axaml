                                                       <TextBlock
                                                             Classes="docs-code"
                                                             Text="{StaticResource SampleMarginSideCode}"/>
                                                  </Border>
                                             </StackPanel>
                                        </Border>
                                   </StackPanel>
                                   <StackPanel
                                         Spacing="{StaticResource SampleDocsSectionCardSpacing}">
