<Window
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:tw="using:Tailwind.Avalonia"
      mc:Ignorable="d"
      d:DesignWidth="1440"
      d:DesignHeight="920"
      x:Class="Tailwind.Avalonia.Sample.MainWindow"
      Title="{StaticResource SampleWindowTitle}"
      Background="{StaticResource BrushSlate950}">
     <Window.Resources>
          <DrawingBrush
                x:Key="SamplePaddingStripeBrush"
                DestinationRect="0,0,24,24"
                Stretch="None"
                TileMode="Tile">
               <DrawingBrush.Drawing>
                    <DrawingGroup>
                         <GeometryDrawing
                               Brush="{StaticResource BrushViolet400}"
                               Geometry="M0,0 H24 V24 H0 Z"/>
                         <GeometryDrawing>
                              <GeometryDrawing.Pen>
                                   <Pen
                                         Brush="#55FFFFFF"
                                         Thickness="2"/>
                              </GeometryDrawing.Pen>
                              <GeometryDrawing.Geometry>
                                   <GeometryGroup>
                                        <LineGeometry
                                              StartPoint="-6,18"
                                              EndPoint="18,-6"/>
                                        <LineGeometry
                                              StartPoint="0,24"
                                              EndPoint="24,0"/>
                                        <LineGeometry
                                              StartPoint="6,30"
                                              EndPoint="30,6"/>
                                   </GeometryGroup>
                              </GeometryDrawing.Geometry>
                         </GeometryDrawing>
                    </DrawingGroup>
               </DrawingBrush.Drawing>
          </DrawingBrush>
     </Window.Resources>
     <Window.Styles>
          <Style
                Selector="TabItem">
               <Setter
                     Property="MinWidth"
                     Value="{StaticResource SampleDocsTabMinWidth}"/>
               <Setter
                     Property="Margin"
                     Value="0,0,16,8"/>
               <Setter
                     Property="Padding"
                     Value="18,16"/>
               <Setter
                     Property="FontSize"
                     Value="15"/>
               <Setter
                     Property="FontWeight"
                     Value="SemiBold"/>
               <Setter
                     Property="Foreground"
                     Value="{StaticResource BrushSlate400}"/>
               <Setter
                     Property="Background"
                     Value="{StaticResource BrushSlate900}"/>
               <Setter
                     Property="BorderBrush"
                     Value="{StaticResource BrushSlate800}"/>
               <Setter
                     Property="BorderThickness"
                     Value="1"/>
               <Setter
                     Property="HorizontalContentAlignment"
                     Value="Left"/>
          </Style>
          <Style
                Selector="TabItem:selected">
               <Setter
                     Property="Foreground"
                     Value="{StaticResource BrushWhite}"/>
               <Setter
                     Property="Background"
                     Value="{StaticResource BrushSlate800}"/>
               <Setter
                     Property="BorderBrush"
                     Value="{StaticResource BrushSlate700}"/>
          </Style>
          <Style
                Selector="TextBlock.docs-library">
               <Setter
                     Property="Foreground"
                     Value="{StaticResource BrushSlate500}"/>
               <Setter
                     Property="FontSize"
                     Value="12"/>
               <Setter
                     Property="FontWeight"
                     Value="SemiBold"/>
          </Style>
          <Style
                Selector="TextBlock.docs-pageTitle">
               <Setter
                     Property="Foreground"
                     Value="{StaticResource BrushWhite}"/>
               <Setter
                     Property="FontSize"
                     Value="34"/>
               <Setter
                     Property="FontWeight"
                     Value="Bold"/>
          </Style>
          <Style
                Selector="TextBlock.docs-eyebrow">
               <Setter
                     Property="Foreground"
                     Value="{StaticResource BrushSlate400}"/>
               <Setter
                     Property="FontSize"
                     Value="12"/>
               <Setter
                     Property="FontWeight"
                     Value="SemiBold"/>
          </Style>
          <Style
                Selector="TextBlock.docs-body">
               <Setter
                     Property="Foreground"
                     Value="{StaticResource BrushSlate300}"/>
               <Setter
                     Property="FontSize"
                     Value="16"/>
               <Setter
                     Property="TextWrapping"
                     Value="Wrap"/>
               <Setter
                     Property="MaxWidth"
                     Value="900"/>
          </Style>
          <Style
                Selector="TextBlock.docs-sectionTitle">
               <Setter
                     Property="Foreground"
                     Value="{StaticResource BrushWhite}"/>
               <Setter
                     Property="FontSize"
                     Value="24"/>
               <Setter
                     Property="FontWeight"
                     Value="SemiBold"/>
          </Style>
          <Style
                Selector="TextBlock.docs-noteTitle">
               <Setter
                     Property="Foreground"
                     Value="{StaticResource BrushWhite}"/>
               <Setter
                     Property="FontSize"
                     Value="14"/>
               <Setter
                     Property="FontWeight"
                     Value="SemiBold"/>
          </Style>
          <Style
                Selector="TextBlock.docs-noteBody">
               <Setter
                     Property="Foreground"
                     Value="{StaticResource BrushSlate300}"/>
               <Setter
                     Property="FontSize"
                     Value="14"/>
               <Setter
                     Property="TextWrapping"
                     Value="Wrap"/>
               <Setter
                     Property="MaxWidth"
                     Value="900"/>
          </Style>
          <Style
                Selector="TextBlock.docs-miniTitle">
               <Setter
                     Property="Foreground"
                     Value="{StaticResource BrushSlate200}"/>
               <Setter
                     Property="FontSize"
                     Value="13"/>
               <Setter
                     Property="FontWeight"
                     Value="SemiBold"/>
          </Style>
          <Style
                Selector="TextBlock.docs-code">
               <Setter
                     Property="Foreground"
                     Value="{StaticResource BrushSlate200}"/>
               <Setter
                     Property="FontSize"
                     Value="14"/>
               <Setter
                     Property="TextWrapping"
                     Value="Wrap"/>
               <Setter
                     Property="FontFamily"
                     Value="Cascadia Mono, Consolas"/>
          </Style>
          <Style
                Selector="TextBlock.docs-chip">
               <Setter
                     Property="Foreground"
                     Value="{StaticResource BrushWhite}"/>
               <Setter
                     Property="FontSize"
                     Value="14"/>
               <Setter
                     Property="FontWeight"
                     Value="Bold"/>
          </Style>
          <Style
                Selector="Border.docs-surface">
               <Setter
                     Property="Background"
                     Value="{StaticResource BrushSlate900}"/>
               <Setter
                     Property="BorderBrush"
                     Value="{StaticResource BrushSlate800}"/>
               <Setter
                     Property="BorderThickness"
                     Value="1"/>
               <Setter
                     Property="CornerRadius"
                     Value="{StaticResource SampleDocsSurfaceCornerRadius}"/>
               <Setter
                     Property="ClipToBounds"
                     Value="True"/>
          </Style>
          <Style
                Selector="Border.docs-note">
               <Setter
                     Property="Background"
                     Value="{StaticResource BrushSlate900}"/>
               <Setter
                     Property="BorderBrush"
                     Value="{StaticResource BrushSlate800}"/>
               <Setter
                     Property="BorderThickness"
                     Value="1"/>
               <Setter
                     Property="CornerRadius"
                     Value="{StaticResource SampleDocsInnerCornerRadius}"/>
               <Setter
                     Property="Padding"
                     Value="18"/>
          </Style>
          <Style
                Selector="Border.docs-inset">
               <Setter
                     Property="Background"
                     Value="{StaticResource BrushSlate800}"/>
               <Setter
                     Property="BorderBrush"
                     Value="{StaticResource BrushSlate700}"/>
               <Setter
                     Property="BorderThickness"
                     Value="1"/>
               <Setter
                     Property="CornerRadius"
                     Value="{StaticResource SampleDocsInnerCornerRadius}"/>
               <Setter
                     Property="Padding"
                     Value="16"/>
          </Style>
          <Style
                Selector="Border.docs-paddingShell">
               <Setter
                     Property="Background"
                     Value="{StaticResource SamplePaddingStripeBrush}"/>
               <Setter
                     Property="CornerRadius"
                     Value="{StaticResource SampleDocsChipCornerRadius}"/>
               <Setter
                     Property="ClipToBounds"
                     Value="True"/>
          </Style>
          <Style
                Selector="Border.docs-paddingCore">
               <Setter
                     Property="Background"
                     Value="{StaticResource BrushViolet600}"/>
               <Setter
                     Property="CornerRadius"
                     Value="{StaticResource SampleDocsChipCornerRadius}"/>
          </Style>
          <Style
                Selector="Border.docs-marginShell">
               <Setter
                     Property="Background"
                     Value="{StaticResource SamplePaddingStripeBrush}"/>
               <Setter
                     Property="BorderBrush"
                     Value="{StaticResource BrushSlate700}"/>
               <Setter
                     Property="BorderThickness"
                     Value="1"/>
               <Setter
                     Property="CornerRadius"
                     Value="{StaticResource SampleDocsInnerCornerRadius}"/>
               <Setter
                     Property="Padding"
                     Value="0"/>
               <Setter
                     Property="ClipToBounds"
                     Value="True"/>
          </Style>
     </Window.Styles>
     <TabControl
           Margin="{StaticResource SampleDocsShellMargin}"
           Background="Transparent"
           BorderBrush="Transparent"
           BorderThickness="0"
           SelectedIndex="0"
           TabStripPlacement="Left">
          <TabItem
                Header="{StaticResource SampleDocsPaddingTabTitle}">
               <Border
                     Background="{StaticResource BrushSlate950}">
                    <ScrollViewer
                          HorizontalScrollBarVisibility="Disabled">
                         <StackPanel
                               Margin="{StaticResource SampleDocsContentMargin}"
                               Spacing="{StaticResource SampleDocsSectionSpacing}">
                              <StackPanel
                                    Spacing="10">
                                   <TextBlock
                                         Classes="docs-library"
                                         Text="{StaticResource SampleDocsLibraryLabel}"/>
                                   <TextBlock
                                         Classes="docs-pageTitle"
                                         Text="{StaticResource SamplePaddingPageTitle}"/>
                                   <TextBlock
                                         Classes="docs-body"
                                         Text="{StaticResource SamplePaddingPageDescription}"/>
                                   <Border
                                         Classes="docs-note"
                                         BorderThickness="2"
                                         tw:Tw.Class="{StaticResource SampleDocsSupportNoteClass}">
                                        <StackPanel
                                              Spacing="6">
                                             <TextBlock
                                                   Classes="docs-noteTitle"
                                                   tw:Tw.Class="{StaticResource SampleDocsSupportNoteTitleClass}"
                                                   Text="{StaticResource SampleDocsSupportNoteTitle}"/>
                                             <TextBlock
                                                   Classes="docs-noteBody"
                                                   tw:Tw.Class="{StaticResource SampleDocsSupportNoteBodyClass}"
                                                   Text="{StaticResource SamplePaddingSupportNote}"/>
                                        </StackPanel>
                                   </Border>
                              </StackPanel>
                              <StackPanel
                                    Spacing="18">
                                   <TextBlock
                                         Classes="docs-eyebrow"
                                         Text="{StaticResource SampleDocsExamplesEyebrow}"/>
                                   <StackPanel
                                         Spacing="{StaticResource SampleDocsSectionCardSpacing}">
                                        <TextBlock
                                              Classes="docs-sectionTitle"
                                              Text="{StaticResource SamplePaddingBasicTitle}"/>
                                        <TextBlock
                                              Classes="docs-body"
                                              Text="{StaticResource SamplePaddingBasicDescription}"/>
                                        <Border
                                              Classes="docs-surface">
                                             <StackPanel
                                                   Spacing="0">
                                                  <Border
                                                        Background="{StaticResource BrushSlate950}"
                                                        Height="{StaticResource SampleDocsPreviewHeight}"
                                                        Padding="28">
                                                       <Grid>
                                                            <Border
                                                                  Classes="docs-paddingShell"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  tw:Tw.Class="p-8">
                                                                 <Border
                                                                       Classes="docs-paddingCore">
                                                                      <Grid
                                                                            MinWidth="96"
                                                                            MinHeight="56">
                                                                           <TextBlock
                                                                                 Classes="docs-chip"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"
                                                                                 Text="p-8"/>
                                                                      </Grid>
                                                                 </Border>
                                                            </Border>
                                                       </Grid>
                                                  </Border>
                                                  <Border
                                                        BorderBrush="{StaticResource BrushSlate800}"
                                                        BorderThickness="0,1,0,0"
                                                        Padding="{StaticResource SampleDocsCodePadding}">
                                                       <TextBlock
                                                             Classes="docs-code"
                                                             Text="{StaticResource SamplePaddingBasicCode}"/>
                                                  </Border>
                                             </StackPanel>
                                        </Border>
                                   </StackPanel>
                                   <StackPanel
                                         Spacing="{StaticResource SampleDocsSectionCardSpacing}">
                                        <TextBlock
                                              Classes="docs-sectionTitle"
                                              Text="{StaticResource SamplePaddingSideTitle}"/>
                                        <TextBlock
                                              Classes="docs-body"
                                              Text="{StaticResource SamplePaddingSideDescription}"/>
                                        <Border
                                              Classes="docs-surface">
                                             <StackPanel
                                                   Spacing="0">
                                                  <Border
                                                        Background="{StaticResource BrushSlate950}"
                                                        Height="{StaticResource SampleDocsCompactPreviewHeight}"
                                                        Padding="24">
                                                       <Grid>
                                                            <StackPanel
                                                                  Orientation="Horizontal"
                                                                  HorizontalAlignment="Center"
                                                                  Spacing="18">
                                                                 <Border
                                                                       Classes="docs-paddingShell"
                                                                       tw:Tw.Class="pt-6">
                                                                      <Border
                                                                            Classes="docs-paddingCore">
                                                                           <Grid
                                                                                 MinWidth="84"
                                                                                 MinHeight="52">
                                                                                <TextBlock
                                                                                      Classes="docs-chip"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"
                                                                                      Text="pt-6"/>
                                                                           </Grid>
                                                                      </Border>
                                                                 </Border>
                                                                 <Border
                                                                       Classes="docs-paddingShell"
                                                                       tw:Tw.Class="pr-4">
                                                                      <Border
                                                                            Classes="docs-paddingCore">
                                                                           <Grid
                                                                                 MinWidth="84"
                                                                                 MinHeight="52">
                                                                                <TextBlock
                                                                                      Classes="docs-chip"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"
                                                                                      Text="pr-4"/>
                                                                           </Grid>
                                                                      </Border>
                                                                 </Border>
                                                                 <Border
                                                                       Classes="docs-paddingShell"
                                                                       tw:Tw.Class="pb-8">
                                                                      <Border
                                                                            Classes="docs-paddingCore">
                                                                           <Grid
                                                                                 MinWidth="84"
                                                                                 MinHeight="52">
                                                                                <TextBlock
                                                                                      Classes="docs-chip"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"
                                                                                      Text="pb-8"/>
                                                                           </Grid>
                                                                      </Border>
                                                                 </Border>
                                                                 <Border
                                                                       Classes="docs-paddingShell"
                                                                       tw:Tw.Class="pl-2">
                                                                      <Border
                                                                            Classes="docs-paddingCore">
                                                                           <Grid
                                                                                 MinWidth="84"
                                                                                 MinHeight="52">
                                                                                <TextBlock
                                                                                      Classes="docs-chip"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"
                                                                                      Text="pl-2"/>
                                                                           </Grid>
                                                                      </Border>
                                                                 </Border>
                                                            </StackPanel>
                                                       </Grid>
                                                  </Border>
                                                  <Border
                                                        BorderBrush="{StaticResource BrushSlate800}"
                                                        BorderThickness="0,1,0,0"
                                                        Padding="{StaticResource SampleDocsCodePadding}">
                                                       <TextBlock
                                                             Classes="docs-code"
                                                             Text="{StaticResource SamplePaddingSideCode}"/>
                                                  </Border>
                                             </StackPanel>
                                        </Border>
                                   </StackPanel>
                                   <StackPanel
                                         Spacing="{StaticResource SampleDocsSectionCardSpacing}">
                                        <TextBlock
                                              Classes="docs-sectionTitle"
                                              Text="{StaticResource SamplePaddingAxisTitle}"/>
                                        <TextBlock
                                              Classes="docs-body"
                                              Text="{StaticResource SamplePaddingAxisDescription}"/>
                                        <Border
                                              Classes="docs-surface">
                                             <StackPanel
                                                   Spacing="0">
                                                  <Border
                                                        Background="{StaticResource BrushSlate950}"
                                                        Height="{StaticResource SampleDocsCompactPreviewHeight}"
                                                        Padding="24">
                                                       <Grid>
                                                            <StackPanel
                                                                  Orientation="Horizontal"
                                                                  HorizontalAlignment="Center"
                                                                  Spacing="24">
                                                                 <Border
                                                                       Classes="docs-paddingShell"
                                                                       tw:Tw.Class="px-8">
                                                                      <Border
                                                                            Classes="docs-paddingCore">
                                                                           <Grid
                                                                                 MinWidth="92"
                                                                                 MinHeight="56">
                                                                                <TextBlock
                                                                                      Classes="docs-chip"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"
                                                                                      Text="px-8"/>
                                                                           </Grid>
                                                                      </Border>
                                                                 </Border>
                                                                 <Border
                                                                       Classes="docs-paddingShell"
                                                                       tw:Tw.Class="py-8">
                                                                      <Border
                                                                            Classes="docs-paddingCore">
                                                                           <Grid
                                                                                 MinWidth="92"
                                                                                 MinHeight="56">
                                                                                <TextBlock
                                                                                      Classes="docs-chip"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"
                                                                                      Text="py-8"/>
                                                                           </Grid>
                                                                      </Border>
                                                                 </Border>
                                                            </StackPanel>
                                                       </Grid>
                                                  </Border>
                                                  <Border
                                                        BorderBrush="{StaticResource BrushSlate800}"
                                                        BorderThickness="0,1,0,0"
                                                        Padding="{StaticResource SampleDocsCodePadding}">
                                                       <TextBlock
                                                             Classes="docs-code"
                                                             Text="{StaticResource SamplePaddingAxisCode}"/>
                                                  </Border>
                                             </StackPanel>
                                        </Border>
                                   </StackPanel>
                                   <StackPanel
                                         Spacing="{StaticResource SampleDocsSectionCardSpacing}">
                                        <TextBlock
                                              Classes="docs-sectionTitle"
                                              Text="{StaticResource SamplePaddingLogicalTitle}"/>
                                        <TextBlock
                                              Classes="docs-body"
                                              Text="{StaticResource SamplePaddingLogicalDescription}"/>
                                        <Border
                                              Classes="docs-surface">
                                             <StackPanel
                                                   Spacing="0">
                                                  <Border
                                                        Background="{StaticResource BrushSlate950}"
                                                        Height="{StaticResource SampleDocsPreviewHeight}"
                                                        Padding="24">
                                                       <Grid
                                                             ColumnDefinitions="*,*"
                                                             ColumnSpacing="20">
                                                            <Border
                                                                  Classes="docs-inset">
                                                                 <StackPanel
                                                                       Spacing="12">
                                                                      <TextBlock
                                                                            Classes="docs-miniTitle"
                                                                            Text="{StaticResource SampleDocsLeftToRightLabel}"/>
                                                                      <StackPanel
                                                                            Orientation="Horizontal"
                                                                            FlowDirection="LeftToRight"
                                                                            Spacing="14">
                                                                           <Border
                                                                                 Classes="docs-paddingShell"
                                                                                 tw:Tw.Class="ps-8">
                                                                                <Border
                                                                                      Classes="docs-paddingCore">
                                                                                     <Grid
                                                                                           MinWidth="88"
                                                                                           MinHeight="48">
                                                                                          <TextBlock
                                                                                                Classes="docs-chip"
                                                                                                HorizontalAlignment="Center"
                                                                                                VerticalAlignment="Center"
                                                                                                Text="ps-8"/>
                                                                                     </Grid>
                                                                                </Border>
                                                                           </Border>
                                                                           <Border
                                                                                 Classes="docs-paddingShell"
                                                                                 tw:Tw.Class="pe-8">
                                                                                <Border
                                                                                      Classes="docs-paddingCore">
                                                                                     <Grid
                                                                                           MinWidth="88"
                                                                                           MinHeight="48">
                                                                                          <TextBlock
                                                                                                Classes="docs-chip"
                                                                                                HorizontalAlignment="Center"
                                                                                                VerticalAlignment="Center"
                                                                                                Text="pe-8"/>
                                                                                     </Grid>
                                                                                </Border>
                                                                           </Border>
                                                                      </StackPanel>
                                                                      <Border
                                                                            Classes="docs-paddingShell"
                                                                            HorizontalAlignment="Left"
                                                                            tw:Tw.Class="pbs-8">
                                                                           <Border
                                                                                 Classes="docs-paddingCore">
                                                                                <Grid
                                                                                      MinWidth="88"
                                                                                      MinHeight="48">
                                                                                     <TextBlock
                                                                                           Classes="docs-chip"
                                                                                           HorizontalAlignment="Center"
                                                                                           VerticalAlignment="Center"
                                                                                           Text="pbs-8"/>
                                                                                </Grid>
                                                                           </Border>
                                                                      </Border>
                                                                 </StackPanel>
                                                            </Border>
                                                            <Border
                                                                  Classes="docs-inset">
                                                                 <StackPanel
                                                                       Spacing="12">
                                                                      <TextBlock
                                                                            Classes="docs-miniTitle"
                                                                            Text="{StaticResource SampleDocsRightToLeftLabel}"/>
                                                                      <StackPanel
                                                                            Orientation="Horizontal"
                                                                            FlowDirection="RightToLeft"
                                                                            Spacing="14">
                                                                           <Border
                                                                                 Classes="docs-paddingShell"
                                                                                 tw:Tw.Class="ps-8">
                                                                                <Border
                                                                                      Classes="docs-paddingCore">
                                                                                     <Grid
                                                                                           MinWidth="88"
                                                                                           MinHeight="48">
                                                                                          <TextBlock
                                                                                                Classes="docs-chip"
                                                                                                HorizontalAlignment="Center"
                                                                                                VerticalAlignment="Center"
                                                                                                Text="ps-8"/>
                                                                                     </Grid>
                                                                                </Border>
                                                                           </Border>
                                                                           <Border
                                                                                 Classes="docs-paddingShell"
                                                                                 tw:Tw.Class="pe-8">
                                                                                <Border
                                                                                      Classes="docs-paddingCore">
                                                                                     <Grid
                                                                                           MinWidth="88"
                                                                                           MinHeight="48">
                                                                                          <TextBlock
                                                                                                Classes="docs-chip"
                                                                                                HorizontalAlignment="Center"
                                                                                                VerticalAlignment="Center"
                                                                                                Text="pe-8"/>
                                                                                     </Grid>
                                                                                </Border>
                                                                           </Border>
                                                                      </StackPanel>
                                                                      <Border
                                                                            Classes="docs-paddingShell"
                                                                            HorizontalAlignment="Left"
                                                                            tw:Tw.Class="pbs-8">
                                                                           <Border
                                                                                 Classes="docs-paddingCore">
                                                                                <Grid
                                                                                      MinWidth="88"
                                                                                      MinHeight="48">
                                                                                     <TextBlock
                                                                                           Classes="docs-chip"
                                                                                           HorizontalAlignment="Center"
                                                                                           VerticalAlignment="Center"
                                                                                           Text="pbs-8"/>
                                                                                </Grid>
                                                                           </Border>
                                                                      </Border>
                                                                 </StackPanel>
                                                            </Border>
                                                       </Grid>
                                                  </Border>
                                                  <Border
                                                        BorderBrush="{StaticResource BrushSlate800}"
                                                        BorderThickness="0,1,0,0"
                                                        Padding="{StaticResource SampleDocsCodePadding}">
                                                       <TextBlock
                                                             Classes="docs-code"
                                                             Text="{StaticResource SamplePaddingLogicalCode}"/>
                                                  </Border>
                                             </StackPanel>
                                        </Border>
                                   </StackPanel>
                              </StackPanel>
                         </StackPanel>
                    </ScrollViewer>
               </Border>
          </TabItem>
          <TabItem
                Header="{StaticResource SampleDocsMarginTabTitle}">
               <Border
                     Background="{StaticResource BrushSlate950}">
                    <ScrollViewer
                          HorizontalScrollBarVisibility="Disabled">
                         <StackPanel
                               Margin="{StaticResource SampleDocsContentMargin}"
                               Spacing="{StaticResource SampleDocsSectionSpacing}">
                              <StackPanel
                                    Spacing="10">
                                   <TextBlock
                                         Classes="docs-library"
                                         Text="{StaticResource SampleDocsLibraryLabel}"/>
                                   <TextBlock
                                         Classes="docs-pageTitle"
                                         Text="{StaticResource SampleMarginPageTitle}"/>
                                   <TextBlock
                                         Classes="docs-body"
                                         Text="{StaticResource SampleMarginPageDescription}"/>
                                   <Border
                                         Classes="docs-note"
                                         BorderThickness="2"
                                         tw:Tw.Class="{StaticResource SampleDocsSupportNoteClass}">
                                        <StackPanel
                                              Spacing="6">
                                             <TextBlock
                                                   Classes="docs-noteTitle"
                                                   tw:Tw.Class="{StaticResource SampleDocsSupportNoteTitleClass}"
                                                   Text="{StaticResource SampleDocsSupportNoteTitle}"/>
                                             <TextBlock
                                                   Classes="docs-noteBody"
                                                   tw:Tw.Class="{StaticResource SampleDocsSupportNoteBodyClass}"
                                                   Text="{StaticResource SampleMarginSupportNote}"/>
                                        </StackPanel>
                                   </Border>
                              </StackPanel>
                              <StackPanel
                                    Spacing="18">
                                   <TextBlock
                                         Classes="docs-eyebrow"
                                         Text="{StaticResource SampleDocsExamplesEyebrow}"/>
                                   <StackPanel
                                         Spacing="{StaticResource SampleDocsSectionCardSpacing}">
                                        <TextBlock
                                              Classes="docs-sectionTitle"
                                              Text="{StaticResource SampleMarginBasicTitle}"/>
                                        <TextBlock
                                              Classes="docs-body"
                                              Text="{StaticResource SampleMarginBasicDescription}"/>
                                        <Border
                                              Classes="docs-surface">
                                             <StackPanel
                                                   Spacing="0">
                                                  <Border
                                                        Background="{StaticResource BrushSlate950}"
                                                        Height="{StaticResource SampleDocsPreviewHeight}"
                                                        Padding="28">
                                                       <Grid>
                                                            <Border
                                                                  Classes="docs-marginShell"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center">
                                                                 <Grid
                                                                       Width="280"
                                                                       Height="120">
                                                                      <Border
                                                                            Background="{StaticResource BrushSky500}"
                                                                            CornerRadius="{StaticResource SampleDocsChipCornerRadius}"
                                                                            HorizontalAlignment="Stretch"
                                                                            VerticalAlignment="Stretch"
                                                                            tw:Tw.Class="m-8">
                                                                           <TextBlock
                                                                                 Classes="docs-chip"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"
                                                                                 Text="m-8"/>
                                                                      </Border>
                                                                 </Grid>
                                                            </Border>
                                                       </Grid>
                                                  </Border>
                                                  <Border
                                                        BorderBrush="{StaticResource BrushSlate800}"
                                                        BorderThickness="0,1,0,0"
                                                        Padding="{StaticResource SampleDocsCodePadding}">
                                                       <TextBlock
                                                             Classes="docs-code"
                                                             Text="{StaticResource SampleMarginBasicCode}"/>
                                                  </Border>
                                             </StackPanel>
                                        </Border>
                                   </StackPanel>
                                   <StackPanel
                                         Spacing="{StaticResource SampleDocsSectionCardSpacing}">
                                        <TextBlock
                                              Classes="docs-sectionTitle"
                                              Text="{StaticResource SampleMarginSideTitle}"/>
                                        <TextBlock
                                              Classes="docs-body"
                                              Text="{StaticResource SampleMarginSideDescription}"/>
                                        <Border
                                              Classes="docs-surface">
                                             <StackPanel
                                                   Spacing="0">
                                                  <Border
                                                        Background="{StaticResource BrushSlate950}"
                                                        Height="{StaticResource SampleDocsCompactPreviewHeight}"
                                                        Padding="24">
                                                       <Grid>
                                                            <Grid
                                                                  Width="620"
                                                                  Height="112">
                                                                 <Border
                                                                       Classes="docs-marginShell"
                                                                       HorizontalAlignment="Left"
                                                                       VerticalAlignment="Center">
                                                                      <Border
                                                                            Background="{StaticResource BrushViolet500}"
                                                                            CornerRadius="{StaticResource SampleDocsChipCornerRadius}"
                                                                            Width="64"
                                                                            Height="56"
                                                                            tw:Tw.Class="ml-2">
                                                                           <TextBlock
                                                                                 Classes="docs-chip"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"
                                                                                 Text="ml-2"/>
                                                                      </Border>
                                                                 </Border>
                                                                 <Border
                                                                       Classes="docs-marginShell"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center">
                                                                      <Border
                                                                            Background="{StaticResource BrushViolet500}"
                                                                            CornerRadius="{StaticResource SampleDocsChipCornerRadius}"
                                                                            Width="64"
                                                                            Height="56"
                                                                            tw:Tw.Class="mr-4">
                                                                           <TextBlock
                                                                                 Classes="docs-chip"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"
                                                                                 Text="mr-4"/>
                                                                      </Border>
                                                                 </Border>
                                                                 <Border
                                                                       Classes="docs-marginShell"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Top">
                                                                      <Border
                                                                            Background="{StaticResource BrushViolet500}"
                                                                            CornerRadius="{StaticResource SampleDocsChipCornerRadius}"
                                                                            Width="68"
                                                                            Height="56"
                                                                            tw:Tw.Class="mt-6">
                                                                           <TextBlock
                                                                                 Classes="docs-chip"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"
                                                                                 Text="mt-6"/>
                                                                      </Border>
                                                                 </Border>
                                                                 <Border
                                                                       Classes="docs-marginShell"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Bottom">
                                                                      <Border
                                                                            Background="{StaticResource BrushViolet500}"
                                                                            CornerRadius="{StaticResource SampleDocsChipCornerRadius}"
                                                                            Width="68"
                                                                            Height="56"
                                                                            tw:Tw.Class="mb-8">
                                                                           <TextBlock
                                                                                 Classes="docs-chip"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"
                                                                                 Text="mb-8"/>
                                                                      </Border>
                                                                 </Border>
                                                            </Grid>
                                                       </Grid>
                                                  </Border>
                                                  <Border
                                                        BorderBrush="{StaticResource BrushSlate800}"
                                                        BorderThickness="0,1,0,0"
