                                              Classes="docs-surface">
                                             <StackPanel
                                                   Spacing="0">
                                                  <Border
                                                        Background="{StaticResource BrushSlate950}"
                                                        Height="{StaticResource SampleDocsPreviewHeight}"
                                                        Padding="28">
                                                       <Grid>
                                                            <Border
                                                                  Classes="docs-marginShell"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center">
                                                                 <StackPanel
                                                                       Spacing="0">
                                                                      <Border
                                                                            Background="{StaticResource BrushSky400}"
                                                                            CornerRadius="{StaticResource SampleDocsChipCornerRadius}"
                                                                            Width="240"
                                                                            Padding="16">
                                                                           <TextBlock
                                                                                 Classes="docs-chip"
                                                                                 HorizontalAlignment="Center"
                                                                                 Text="{StaticResource SampleMarginNegativeBaseLabel}"/>
                                                                      </Border>
                                                                      <Border
                                                                            Background="{StaticResource BrushBlue500}"
                                                                            CornerRadius="{StaticResource SampleDocsChipCornerRadius}"
                                                                            Width="188"
                                                                            Padding="16"
                                                                            HorizontalAlignment="Center"
                                                                            tw:Tw.Class="-mt-8">
                                                                           <TextBlock
                                                                                 Classes="docs-chip"
                                                                                 HorizontalAlignment="Center"
                                                                                 Text="{StaticResource SampleMarginNegativeOffsetLabel}"/>
                                                                      </Border>
                                                                 </StackPanel>
                                                            </Border>
                                                       </Grid>
                                                  </Border>
                                                  <Border
                                                        BorderBrush="{StaticResource BrushSlate800}"
                                                        BorderThickness="0,1,0,0"
                                                        Padding="{StaticResource SampleDocsCodePadding}">
                                                       <TextBlock
                                                             Classes="docs-code"
                                                             Text="{StaticResource SampleMarginNegativeCode}"/>
                                                  </Border>
                                             </StackPanel>
                                        </Border>
                                   </StackPanel>
                                   <StackPanel
                                         Spacing="{StaticResource SampleDocsSectionCardSpacing}">
