                                              Classes="docs-sectionTitle"
                                              Text="{StaticResource SampleMarginNegativeTitle}"/>
                                        <TextBlock
                                              Classes="docs-body"
                                              Text="{StaticResource SampleMarginNegativeDescription}"/>
