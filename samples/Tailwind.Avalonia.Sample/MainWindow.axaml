                                                                            Width="156"
                                                                            Height="64"
                                                                            tw:Tw.Class="mx-8">
                                                                           <TextBlock
                                                                                 Classes="docs-chip"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"
                                                                                 Text="mx-8"/>
                                                                      </Border>
                                                                 </Border>
                                                                 <Border
                                                                       Classes="docs-marginShell">
                                                                      <Border
                                                                            Background="{StaticResource BrushRose500}"
                                                                            CornerRadius="{StaticResource SampleDocsChipCornerRadius}"
                                                                            Width="72"
                                                                            Height="56"
                                                                            tw:Tw.Class="my-8">
                                                                           <TextBlock
                                                                                 Classes="docs-chip"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"
                                                                                 Text="my-8"/>
                                                                      </Border>
                                                                 </Border>
                                                            </StackPanel>
                                                       </Grid>
                                                  </Border>
                                                  <Border
