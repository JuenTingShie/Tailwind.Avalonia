<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sample="using:Tailwind.Avalonia.Sample"
    xmlns:tw="using:Tailwind.Avalonia">
    <Styles.Resources>
        <!-- One mono stack for every code surface in the docs, ordered so each
             platform hits a real face before falling back to the generic. -->
        <FontFamily
            x:Key="DocsMonoFontFamily">Cascadia Mono, JetBrains Mono, SF Mono, Menlo, DejaVu Sans Mono, Consolas, monospace</FontFamily>

        <!-- Micro-texture over the page ground. A flat fill reads as sterile at
             this scale, so an off-lattice dot tile breaks the surface without
             ever resolving into a visible grid. -->
        <DrawingBrush
            x:Key="DocsGrainBrush"
            DestinationRect="0,0,7,7"
            Stretch="None"
            TileMode="Tile">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing
                        Brush="#0AFFFFFF"
                        Geometry="M0,0 H1 V1 H0 Z" />
                    <GeometryDrawing
                        Brush="#07FFFFFF"
                        Geometry="M3,4 H4 V5 H3 Z" />
                    <GeometryDrawing
                        Brush="#05FFFFFF"
                        Geometry="M5,1 H6 V2 H5 Z" />
                    <GeometryDrawing
                        Brush="#06FFFFFF"
                        Geometry="M2,6 H3 V7 H2 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- Ambient light from the upper left so every tinted shadow in the docs
             has a single, consistent source to fall away from. -->
        <RadialGradientBrush
            x:Key="DocsAmbientBrush"
            Center="18%,0%"
            GradientOrigin="18%,0%"
            RadiusX="85%"
            RadiusY="85%">
            <GradientStop
                Offset="0"
                Color="#141E3A8A" />
            <GradientStop
                Offset="0.55"
                Color="#070C4A6E" />
            <GradientStop
                Offset="1"
                Color="#00020617" />
        </RadialGradientBrush>

        <DrawingBrush
            x:Key="SamplePaddingStripeBrush"
            DestinationRect="0,0,24,24"
            Stretch="None"
            TileMode="Tile">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing
                        Brush="#FF8B5CF6"
                        Geometry="M0,0 H24 V24 H0 Z" />
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen
                                Brush="#4DFFFFFF"
                                Thickness="2" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry
                                    StartPoint="-6,18"
                                    EndPoint="18,-6" />
                                <LineGeometry
                                    StartPoint="0,24"
                                    EndPoint="24,0" />
                                <LineGeometry
                                    StartPoint="6,30"
                                    EndPoint="30,6" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Styles.Resources>

    <!-- ===================================================================
         Page scaffold
         =================================================================== -->
    <!-- Bottom margin runs deliberately larger than the top: optically even
         padding needs more room under the content than over it. -->
    <Style
        Selector="StackPanel.docs-pageLayout">
        <Setter
            Property="tw:Tw.Class"
            Value="ml-9 mt-8 mr-11 mb-14 max-w-[1100px]" />
        <Setter
            Property="Spacing"
            Value="52" />
    </Style>
    <Style
        Selector="UserControl.docs-mobile StackPanel.docs-pageLayout">
        <!-- Tw clears any property the new token list omits, so an override
             has to restate every token it still wants - here, the max width. -->
        <Setter
            Property="tw:Tw.Class"
            Value="ml-3.5 mt-3 mr-3.5 mb-7 max-w-[1100px]" />
        <Setter
            Property="Spacing"
            Value="30" />
    </Style>

    <!-- Overview block: support notes and the class reference, kept tight. -->
    <Style
        Selector="StackPanel.docs-overviewStack">
        <Setter
            Property="Spacing"
            Value="18" />
    </Style>

    <!-- Worked examples, spaced far enough apart to read as separate ideas. -->
    <Style
        Selector="StackPanel.docs-exampleStack">
        <Setter
            Property="Spacing"
            Value="44" />
    </Style>
    <Style
        Selector="UserControl.docs-mobile StackPanel.docs-exampleStack">
        <Setter
            Property="Spacing"
            Value="28" />
    </Style>

    <!-- ===================================================================
         Type scale
         =================================================================== -->
    <Style
        Selector="TextBlock.docs-library">
        <Setter
            Property="tw:Tw.Class"
            Value="text-slate-500" />
        <Setter
            Property="FontSize"
            Value="11" />
        <Setter
            Property="FontWeight"
            Value="Medium" />
        <Setter
            Property="LetterSpacing"
            Value="2" />
    </Style>
    <Style
        Selector="TextBlock.docs-pageTitle">
        <Setter
            Property="tw:Tw.Class"
            Value="text-white" />
        <Setter
            Property="FontSize"
            Value="44" />
        <Setter
            Property="FontWeight"
            Value="Bold" />
        <Setter
            Property="LetterSpacing"
            Value="-1.4" />
        <Setter
            Property="LineHeight"
            Value="48" />
    </Style>
    <Style
        Selector="UserControl.docs-mobile TextBlock.docs-pageTitle">
        <Setter
            Property="FontSize"
            Value="30" />
        <Setter
            Property="LetterSpacing"
            Value="-0.9" />
        <Setter
            Property="LineHeight"
            Value="34" />
    </Style>

    <!-- Opening paragraph: one step up from body so the page has a real lede. -->
    <Style
        Selector="TextBlock.docs-lede">
        <Setter
            Property="tw:Tw.Class"
            Value="text-slate-300 max-w-[680px]" />
        <Setter
            Property="FontSize"
            Value="18" />
        <Setter
            Property="FontWeight"
            Value="Normal" />
        <Setter
            Property="TextWrapping"
            Value="Wrap" />
        <Setter
            Property="LineHeight"
            Value="30" />
        <!-- Without this the measure column centres itself once the max width
             bites, which reads as broken next to a left-aligned title. -->
        <Setter
            Property="HorizontalAlignment"
            Value="Left" />
    </Style>
    <Style
        Selector="UserControl.docs-mobile TextBlock.docs-lede">
        <Setter
            Property="FontSize"
            Value="15" />
        <Setter
            Property="LineHeight"
            Value="25" />
    </Style>

    <Style
        Selector="TextBlock.docs-eyebrow">
        <Setter
            Property="tw:Tw.Class"
            Value="text-slate-500" />
        <Setter
            Property="FontSize"
            Value="13" />
        <Setter
            Property="FontWeight"
            Value="Medium" />
    </Style>

    <!-- Body copy capped near 65 characters at this size. -->
    <Style
        Selector="TextBlock.docs-body">
        <Setter
            Property="tw:Tw.Class"
            Value="text-slate-400 max-w-[680px]" />
        <Setter
            Property="FontSize"
            Value="16" />
        <Setter
            Property="FontWeight"
            Value="Normal" />
        <Setter
            Property="TextWrapping"
            Value="Wrap" />
        <Setter
            Property="LineHeight"
            Value="28" />
        <Setter
            Property="HorizontalAlignment"
            Value="Left" />
    </Style>
    <Style
        Selector="UserControl.docs-mobile TextBlock.docs-body">
        <Setter
            Property="FontSize"
            Value="14" />
        <Setter
            Property="LineHeight"
            Value="24" />
    </Style>

    <Style
        Selector="TextBlock.docs-sectionTitle">
        <Setter
            Property="tw:Tw.Class"
            Value="text-white" />
        <Setter
            Property="FontSize"
            Value="26" />
        <Setter
            Property="FontWeight"
            Value="SemiBold" />
        <Setter
            Property="LetterSpacing"
            Value="-0.6" />
        <Setter
            Property="TextWrapping"
            Value="Wrap" />
    </Style>
    <Style
        Selector="UserControl.docs-mobile TextBlock.docs-sectionTitle">
        <Setter
            Property="FontSize"
            Value="21" />
        <Setter
            Property="LetterSpacing"
            Value="-0.3" />
    </Style>

    <Style
        Selector="TextBlock.docs-noteTitle">
        <Setter
            Property="tw:Tw.Class"
            Value="text-slate-100" />
        <Setter
            Property="FontSize"
            Value="14" />
        <Setter
            Property="FontWeight"
            Value="SemiBold" />
        <Setter
            Property="TextWrapping"
            Value="Wrap" />
    </Style>
    <Style
        Selector="TextBlock.docs-noteBody">
        <Setter
            Property="tw:Tw.Class"
            Value="text-slate-400" />
        <Setter
            Property="FontSize"
            Value="14" />
        <Setter
            Property="TextWrapping"
            Value="Wrap" />
        <Setter
            Property="LineHeight"
            Value="23" />
        <Setter
            Property="MaxWidth"
            Value="680" />
        <Setter
            Property="HorizontalAlignment"
            Value="Left" />
    </Style>

    <!-- Label above a code footer or a preview strip. -->
    <Style
        Selector="TextBlock.docs-miniTitle">
        <Setter
            Property="tw:Tw.Class"
            Value="text-slate-500" />
        <Setter
            Property="FontFamily"
            Value="{StaticResource DocsMonoFontFamily}" />
        <Setter
            Property="FontSize"
            Value="11" />
        <Setter
            Property="FontWeight"
            Value="Medium" />
        <Setter
            Property="LetterSpacing"
            Value="0.8" />
    </Style>

    <!-- Instruction sitting on a preview stage. Italic rather than another
         row of small caps, which the docs already lean on hard enough. -->
    <Style
        Selector="TextBlock.docs-hint">
        <Setter
            Property="tw:Tw.Class"
            Value="text-slate-400" />
        <Setter
            Property="FontSize"
            Value="13" />
        <Setter
            Property="FontStyle"
            Value="Italic" />
        <Setter
            Property="TextWrapping"
            Value="Wrap" />
    </Style>

    <Style
        Selector="TextBlock.docs-chip">
        <Setter
            Property="tw:Tw.Class"
            Value="text-white" />
        <Setter
            Property="FontFamily"
            Value="{StaticResource DocsMonoFontFamily}" />
        <Setter
            Property="FontSize"
            Value="13" />
        <Setter
            Property="FontWeight"
            Value="SemiBold" />
    </Style>

    <!-- A chip sitting on a saturated 500-level swatch. White on sky-500 is
         roughly 2.9:1; the near-black reads cleanly on every demo colour. -->
    <Style
        Selector="TextBlock.docs-chip.on-color">
        <Setter
            Property="tw:Tw.Class"
            Value="text-slate-950" />
    </Style>

    <Style
        Selector="sample|AxamlCodeBlock">
        <Setter
            Property="tw:Tw.Class"
            Value="text-slate-200" />
        <Setter
            Property="FontSize"
            Value="14" />
        <Setter
            Property="FontFamily"
            Value="{StaticResource DocsMonoFontFamily}" />
    </Style>
    <Style
        Selector="UserControl.docs-mobile sample|AxamlCodeBlock">
        <Setter
            Property="FontSize"
            Value="13" />
    </Style>

    <!-- ===================================================================
         Surfaces. Radius steps down as elements nest: frame 28, surface 20,
         note 16, inset 14, chip 10.
         =================================================================== -->
    <Style
        Selector="Border.docs-surface">
        <Setter
            Property="tw:Tw.Class"
            Value="bg-slate-900 border-slate-800" />
        <Setter
            Property="BorderThickness"
            Value="1" />
        <Setter
            Property="CornerRadius"
            Value="20" />
        <Setter
            Property="ClipToBounds"
            Value="True" />
        <Setter
            Property="BoxShadow"
            Value="0 18 40 -20 #A6020617, 0 2 8 -3 #59020617" />
    </Style>

    <!-- Where a live preview sits inside a surface. -->
    <Style
        Selector="Border.docs-stage">
        <Setter
            Property="tw:Tw.Class"
            Value="bg-slate-950 p-7" />
    </Style>
    <Style
        Selector="UserControl.docs-mobile Border.docs-stage">
        <Setter
            Property="tw:Tw.Class"
            Value="bg-slate-950 p-4" />
    </Style>

    <!-- Code footer pinned under a preview. -->
    <Style
        Selector="Border.docs-codeFooter">
        <Setter
            Property="tw:Tw.Class"
            Value="bg-slate-900 border-slate-800 px-[22px] py-[18px]" />
        <Setter
            Property="BorderThickness"
            Value="0,1,0,0" />
    </Style>
    <Style
        Selector="UserControl.docs-mobile Border.docs-codeFooter">
        <Setter
            Property="tw:Tw.Class"
            Value="bg-slate-900 border-slate-800 p-3.5" />
    </Style>

    <Style
        Selector="Border.docs-note">
        <Setter
            Property="tw:Tw.Class"
            Value="bg-slate-900/70 border-slate-800" />
        <Setter
            Property="BorderThickness"
            Value="1" />
        <Setter
            Property="CornerRadius"
            Value="16" />
        <Setter
            Property="Padding"
            Value="18" />
    </Style>
    <Style
        Selector="UserControl.docs-mobile Border.docs-note">
        <Setter
            Property="Padding"
            Value="14" />
    </Style>

    <Style
        Selector="Border.docs-inset">
        <Setter
            Property="tw:Tw.Class"
            Value="bg-slate-800 border-slate-700 p-4" />
        <Setter
            Property="BorderThickness"
            Value="1" />
        <Setter
            Property="CornerRadius"
            Value="14" />
    </Style>

    <!-- ===================================================================
         Spacing demo illustrations. Violet stays here on purpose: it marks
         measured space in the diagrams and is never used as page chrome.
         =================================================================== -->
    <Style
        Selector="Border.docs-paddingShell">
        <Setter
            Property="Background"
            Value="{StaticResource SamplePaddingStripeBrush}" />
        <Setter
            Property="CornerRadius"
            Value="12" />
        <Setter
            Property="ClipToBounds"
            Value="True" />
    </Style>
    <Style
        Selector="Border.docs-paddingCore">
        <Setter
            Property="tw:Tw.Class"
            Value="bg-violet-600" />
        <Setter
            Property="CornerRadius"
            Value="10" />
    </Style>
    <Style
        Selector="Border.docs-marginShell">
        <Setter
            Property="Background"
            Value="{StaticResource SamplePaddingStripeBrush}" />
        <Setter
            Property="tw:Tw.Class"
            Value="border-slate-700" />
        <Setter
            Property="BorderThickness"
            Value="1" />
        <Setter
            Property="CornerRadius"
            Value="16" />
        <Setter
            Property="Padding"
            Value="0" />
        <Setter
            Property="ClipToBounds"
            Value="True" />
    </Style>

    <!-- ===================================================================
         Reference table
         =================================================================== -->
    <Style
        Selector="Border.docs-referenceHeader">
        <Setter
            Property="tw:Tw.Class"
            Value="bg-slate-900 border-slate-800 px-5 py-3.5" />
        <Setter
            Property="BorderThickness"
            Value="0,0,0,1" />
    </Style>
    <Style
        Selector="UserControl.docs-mobile Border.docs-referenceHeader">
        <Setter
            Property="tw:Tw.Class"
            Value="bg-slate-900 border-slate-800 px-3.5 py-3" />
    </Style>
    <Style
        Selector="ItemsControl.docs-referenceList">
        <Setter
            Property="HorizontalAlignment"
            Value="Stretch" />
    </Style>
    <Style
        Selector="Border.docs-referenceRow">
        <Setter
            Property="tw:Tw.Class"
            Value="bg-slate-950 border-slate-800" />
        <Setter
            Property="BorderThickness"
            Value="0,0,0,1" />
        <Setter
            Property="Padding"
            Value="20,13" />
        <Setter
            Property="Transitions">
            <Transitions>
                <BrushTransition
                    Property="Background"
                    Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style
        Selector="Border.docs-referenceRow:pointerover">
        <Setter
            Property="tw:Tw.Class"
            Value="bg-slate-900 border-slate-700" />
    </Style>
    <Style
        Selector="UserControl.docs-mobile Border.docs-referenceRow">
        <Setter
            Property="Padding"
            Value="14,12" />
    </Style>
    <Style
        Selector="Grid.docs-referenceColumns">
        <Setter
            Property="ColumnSpacing"
            Value="24" />
    </Style>
    <Style
        Selector="UserControl.docs-mobile Grid.docs-referenceColumns">
        <Setter
            Property="ColumnSpacing"
            Value="14" />
    </Style>
    <Style
        Selector="TextBlock.docs-referenceHeading">
        <Setter
            Property="tw:Tw.Class"
            Value="text-slate-300" />
        <Setter
            Property="FontSize"
            Value="13" />
        <Setter
            Property="FontWeight"
            Value="Medium" />
    </Style>

    <!-- Class names carry the single accent; their expansion stays neutral so
         the eye lands on the token first. -->
    <Style
        Selector="TextBlock.docs-tableClass">
        <Setter
            Property="tw:Tw.Class"
            Value="text-sky-300" />
        <Setter
            Property="FontFamily"
            Value="{StaticResource DocsMonoFontFamily}" />
        <Setter
            Property="FontSize"
            Value="14" />
        <Setter
            Property="FontWeight"
            Value="Medium" />
        <Setter
            Property="TextWrapping"
            Value="Wrap" />
    </Style>
    <Style
        Selector="TextBlock.docs-tableStyle">
        <Setter
            Property="tw:Tw.Class"
            Value="text-slate-400" />
        <Setter
            Property="FontFamily"
            Value="{StaticResource DocsMonoFontFamily}" />
        <Setter
            Property="FontSize"
            Value="13" />
        <Setter
            Property="TextWrapping"
            Value="Wrap" />
    </Style>

    <Style
        Selector="Border.docs-showMoreShell">
        <Setter
            Property="tw:Tw.Class"
            Value="bg-slate-900 border-slate-800 px-0 py-3.5" />
        <Setter
            Property="BorderThickness"
            Value="0,1,0,0" />
        <Setter
            Property="CornerRadius"
            Value="0,0,20,20" />
    </Style>

    <!-- ===================================================================
         Buttons
         =================================================================== -->
    <Style
        Selector="Button.docs-showMoreButton">
        <!-- Every state below restates the full token list on purpose. Tw
             clears whatever a new list leaves out, so a state that named only
             its border would strip the background, text colour and padding. -->
        <Setter
            Property="tw:Tw.Class"
            Value="border-slate-700 bg-slate-800 text-slate-200 px-[18px] py-[9px] min-w-40" />
        <Setter
            Property="BorderThickness"
            Value="1" />
        <Setter
            Property="FontSize"
            Value="13" />
        <Setter
            Property="FontWeight"
            Value="Medium" />
        <Setter
            Property="HorizontalContentAlignment"
            Value="Center" />
        <Setter
            Property="CornerRadius"
            Value="10" />
        <Setter
            Property="RenderTransformOrigin"
            Value="50%,50%" />
        <Setter
            Property="Transitions">
            <Transitions>
                <BrushTransition
                    Property="Background"
                    Duration="0:0:0.18" />
                <BrushTransition
                    Property="Foreground"
                    Duration="0:0:0.18" />
                <TransformOperationsTransition
                    Property="RenderTransform"
                    Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style
        Selector="Button.docs-showMoreButton:pointerover">
        <Setter
            Property="tw:Tw.Class"
            Value="border-slate-600 bg-slate-700 text-white px-[18px] py-[9px] min-w-40" />
    </Style>
    <Style
        Selector="Button.docs-showMoreButton:pressed">
        <Setter
            Property="tw:Tw.Class"
            Value="border-slate-600 bg-slate-700 text-white px-[18px] py-[9px] min-w-40" />
        <Setter
            Property="RenderTransform"
            Value="scale(0.97)" />
    </Style>
    <Style
        Selector="Button.docs-showMoreButton:focus-visible">
        <Setter
            Property="tw:Tw.Class"
            Value="border-sky-400 bg-slate-800 text-slate-200 px-[18px] py-[9px] min-w-40" />
        <Setter
            Property="BorderThickness"
            Value="1.5" />
    </Style>
</Styles>
