<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Typography.TextOverflow">
    <docs:DocsPage
        Section="Typography"
        Title="Text overflow"
        Intro="Utilities for controlling how text wraps and how it is trimmed when it does not fit. They map to Avalonia&#x27;s TextTrimming and TextWrapping properties."
        Supported="truncate sets TextTrimming to CharacterEllipsis and TextWrapping to NoWrap. text-ellipsis and text-clip set only the trimming, text-wrap and text-nowrap set only the wrapping. The last class per property wins, removing a class restores the default, and elements without these properties (for example Border) ignore the token with a warning. Trimming only shows when the text has a constrained width, for example w-64.">
        <docs:DocsPage.Utilities>
            <docs:UtilityReferenceRow ClassName="truncate" AxamlStyle="TextTrimming: CharacterEllipsis; TextWrapping: NoWrap" />
            <docs:UtilityReferenceRow ClassName="text-ellipsis" AxamlStyle="TextTrimming: CharacterEllipsis" />
            <docs:UtilityReferenceRow ClassName="text-clip" AxamlStyle="TextTrimming: None" />
            <docs:UtilityReferenceRow ClassName="text-wrap" AxamlStyle="TextWrapping: Wrap" />
            <docs:UtilityReferenceRow ClassName="text-nowrap" AxamlStyle="TextWrapping: NoWrap" />
        </docs:DocsPage.Utilities>
        <docs:DocsPage.Gaps>
            <docs:DocsGap Text="text-balance · text-pretty · break-*" />
        </docs:DocsPage.Gaps>

        <docs:DocsSection
            Heading="Truncate, ellipsis, clip and wrap"
            Summary="Each TextBlock below is 16rem wide and carries the real token. truncate and text-ellipsis end the line with an ellipsis, text-clip cuts it, and text-wrap wraps onto more lines.">
            <docs:DocsExample>
                <StackPanel
                    Spacing="10">
                    <TextBlock
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="w-64 truncate"
                        Text="The quick brown fox jumps over the lazy dog and keeps running across the field." />
                    <TextBlock
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="w-64 text-ellipsis"
                        Text="The quick brown fox jumps over the lazy dog and keeps running across the field." />
                    <TextBlock
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="w-64 text-clip text-nowrap"
                        Text="The quick brown fox jumps over the lazy dog and keeps running across the field." />
                    <TextBlock
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="w-64 text-wrap"
                        Text="The quick brown fox jumps over the lazy dog and keeps running across the field." />
                </StackPanel>
            </docs:DocsExample>
        </docs:DocsSection>
    </docs:DocsPage>
</UserControl>
