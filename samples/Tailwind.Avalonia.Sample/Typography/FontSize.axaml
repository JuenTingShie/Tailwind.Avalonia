<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Typography.FontSize">
    <docs:DocsPage
        Section="Typography"
        Title="Font size"
        Intro="Utilities for controlling the font size of an element. Recognized size tokens set FontSize, while palette tokens like text-sky-300 keep targeting Foreground on the same tw:Tw.Class surface.">
        <StackPanel
            Spacing="52">
            <StackPanel
                Classes="docs-overviewStack">
                <docs:DocsNote
                    Classes="supported"
                    Title="Implemented in this sample"
                    Body="text-xs through text-9xl work, as do bracket arbitrary values like text-[14px], text-[1.5rem], and text-[18]. Line-height modifiers, the text-(length:&lt;custom-property&gt;) shorthand, and responsive variants are still out of scope." />
                <docs:DocsUtilityTable
                    x:Name="UtilityTable"
                    CollapsedRowCount="5" />
                <docs:DocsNote
                    Classes="gap"
                    Title="Not covered yet"
                    Body="These Tailwind font-size rows sit outside the current parser surface.">
                    <StackPanel
                        Spacing="6">
                        <TextBlock
                            Classes="docs-tableClass"
                            Text="text-sm/6 · text-sm/7 · text-sm/8 · text-lg/7" />
                        <TextBlock
                            Classes="docs-tableClass"
                            Text="text-(length:&lt;custom-property&gt;) · md:text-base" />
                    </StackPanel>
                </docs:DocsNote>
            </StackPanel>

            <StackPanel
                Spacing="22">
                <TextBlock
                    Classes="docs-eyebrow"
                    Text="Examples" />
                <StackPanel
                    Classes="docs-exampleStack">
                    <docs:DocsSection
                        Heading="Basic example"
                        Summary="Use utilities like text-sm and text-2xl to set the font size of an element. Each previewed TextBlock below carries the real tw:Tw.Class token.">
                        <docs:DocsExample>
                            <docs:DocsExample.Snippets>
                                <x:String>&lt;TextBlock tw:Tw.Class="text-xs" /&gt;</x:String>
                                <x:String>&lt;TextBlock tw:Tw.Class="text-base" /&gt;</x:String>
                                <x:String>&lt;TextBlock tw:Tw.Class="text-2xl" /&gt;</x:String>
                                <x:String>&lt;TextBlock tw:Tw.Class="text-5xl" /&gt;</x:String>
                            </docs:DocsExample.Snippets>
                            <StackPanel
                                Spacing="12">
                                <TextBlock
                                    tw:Tw.Class="text-slate-100 text-xs"
                                    Text="The quick brown fox jumps over the lazy dog." />
                                <TextBlock
                                    tw:Tw.Class="text-slate-100 text-base"
                                    Text="The quick brown fox jumps over the lazy dog." />
                                <TextBlock
                                    FontWeight="SemiBold"
                                    tw:Tw.Class="text-slate-100 text-2xl"
                                    Text="The quick brown fox." />
                                <TextBlock
                                    FontWeight="Bold"
                                    LetterSpacing="-1"
                                    tw:Tw.Class="text-slate-50 text-5xl"
                                    Text="Quick fox" />
                            </StackPanel>
                        </docs:DocsExample>
                    </docs:DocsSection>

                    <docs:DocsSection
                        Heading="Setting the line-height"
                        Summary="Tailwind also supports text-sm/6 style tokens that set font size and line-height together. The parser here only maps FontSize, so the slash modifiers stay documented as a gap rather than quietly ignored.">
                        <docs:DocsNote
                            Classes="gap muted"
                            Title="Official examples not implemented yet">
                            <TextBlock
                                Classes="docs-tableClass"
                                Text="text-sm/6 · text-sm/7 · text-sm/8 · text-lg/7" />
                        </docs:DocsNote>
                    </docs:DocsSection>

                    <docs:DocsSection
                        Heading="Using a custom value"
                        Summary="Bracket syntax like text-[14px] sets the font size from an absolute value.">
                        <StackPanel
                            Spacing="18">
                            <docs:DocsNote
                                Title="How arbitrary sizes resolve">
                                <StackPanel
                                    Spacing="8">
                                    <TextBlock
                                        Classes="docs-tableClass"
                                        Text="px · rem · em · unitless" />
                                    <TextBlock
                                        Classes="docs-noteBody"
                                        Text="Arbitrary font sizes are parser-only and emit no generated package keys." />
                                    <TextBlock
                                        Classes="docs-noteBody"
                                        Text="rem and em resolve against a 16px base. Unitless values are treated as px." />
                                    <TextBlock
                                        Classes="docs-noteBody"
                                        Text="Percentages and text-(length:&lt;custom-property&gt;) stay unsupported because Avalonia models FontSize as an absolute double." />
                                </StackPanel>
                            </docs:DocsNote>
                            <docs:DocsExample>
                                <docs:DocsExample.Snippets>
                                    <x:String>&lt;TextBlock tw:Tw.Class="text-[14px]" /&gt;</x:String>
                                    <x:String>&lt;TextBlock tw:Tw.Class="text-[1.5rem]" /&gt;</x:String>
                                    <x:String>&lt;TextBlock tw:Tw.Class="text-[2em]" /&gt;</x:String>
                                </docs:DocsExample.Snippets>
                                <StackPanel
                                    Spacing="12">
                                    <TextBlock
                                        tw:Tw.Class="text-slate-100 text-[14px]"
                                        Text="text-[14px]" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        tw:Tw.Class="text-slate-100 text-[1.5rem]"
                                        Text="text-[1.5rem]" />
                                    <TextBlock
                                        FontWeight="Bold"
                                        tw:Tw.Class="text-slate-50 text-[2em]"
                                        Text="text-[2em]" />
                                </StackPanel>
                            </docs:DocsExample>
                        </StackPanel>
                    </docs:DocsSection>

                    <docs:DocsSection
                        Heading="Responsive design"
                        Summary="Tailwind's font-size docs also show breakpoint-prefixed examples like md:text-base. Variant prefixes are unsupported across the whole parser surface, so the docs name them instead of implying they work.">
                        <docs:DocsNote
                            Classes="gap muted"
                            Title="Official examples not implemented yet">
                            <StackPanel
                                Spacing="6">
                                <TextBlock
                                    Classes="docs-tableClass"
                                    Text="text-sm md:text-base" />
                                <TextBlock
                                    Classes="docs-tableClass"
                                    Text="text-base lg:text-2xl" />
                            </StackPanel>
                        </docs:DocsNote>
                    </docs:DocsSection>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </docs:DocsPage>
</UserControl>
