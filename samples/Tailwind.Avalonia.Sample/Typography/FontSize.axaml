<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Typography.FontSize">
    <docs:DocsPage
        Section="Typography"
        Title="Font size"
        Intro="Utilities for controlling the font size of an element. Recognized size tokens set FontSize, while palette tokens like text-sky-300 keep targeting Foreground on the same tw:Tw.Class surface."
        Supported="text-xs through text-9xl work, as do bracket arbitrary values like text-[14px], text-[1.5rem], and text-[18]. Line-height modifiers, the text-(length:&lt;custom-property&gt;) shorthand, and responsive variants are still out of scope. Each named size also sets its Tailwind line height (text-sm is 14px on a 20px line); a leading-* class or text-&lt;size&gt;/&lt;n&gt; overrides it in any order, and arbitrary sizes such as text-[14px] leave the line height alone."
        CollapsedRowCount="5"
        GapsTitle="Not implemented yet"
        GapsBody="These Tailwind font-size rows sit outside the current parser surface.">
        <docs:DocsPage.Utilities>
            <docs:UtilityReferenceRow ClassName="text-xs" AxamlStyle="&lt;TextBlock FontSize=&quot;12&quot; LineHeight=&quot;16&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="text-sm" AxamlStyle="&lt;TextBlock FontSize=&quot;14&quot; LineHeight=&quot;20&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="text-base" AxamlStyle="&lt;TextBlock FontSize=&quot;16&quot; LineHeight=&quot;24&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="text-lg" AxamlStyle="&lt;TextBlock FontSize=&quot;18&quot; LineHeight=&quot;28&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="text-xl" AxamlStyle="&lt;TextBlock FontSize=&quot;20&quot; LineHeight=&quot;28&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="text-2xl" AxamlStyle="&lt;TextBlock FontSize=&quot;24&quot; LineHeight=&quot;32&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="text-3xl" AxamlStyle="&lt;TextBlock FontSize=&quot;30&quot; LineHeight=&quot;36&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="text-4xl" AxamlStyle="&lt;TextBlock FontSize=&quot;36&quot; LineHeight=&quot;40&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="text-5xl" AxamlStyle="&lt;TextBlock FontSize=&quot;48&quot; LineHeight=&quot;48&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="text-6xl" AxamlStyle="&lt;TextBlock FontSize=&quot;60&quot; LineHeight=&quot;60&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="text-7xl" AxamlStyle="&lt;TextBlock FontSize=&quot;72&quot; LineHeight=&quot;72&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="text-8xl" AxamlStyle="&lt;TextBlock FontSize=&quot;96&quot; LineHeight=&quot;96&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="text-9xl" AxamlStyle="&lt;TextBlock FontSize=&quot;128&quot; LineHeight=&quot;128&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="text-[&lt;value&gt;]" AxamlStyle="&lt;TextBlock FontSize=&quot;&lt;parsed value&gt;&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="text-&lt;size&gt;/&lt;number&gt;" AxamlStyle="FontSize and LineHeight = number * 4px (text-sm/6)" />
            <docs:UtilityReferenceRow ClassName="text-&lt;size&gt;/[&lt;value&gt;]" AxamlStyle="FontSize and LineHeight: px, rem, or a unitless / em multiplier" />
        </docs:DocsPage.Utilities>
        <docs:DocsPage.Gaps>
            <docs:DocsGap Text="text-(length:&lt;custom-property&gt;) · md:text-base" />
        </docs:DocsPage.Gaps>

        <docs:DocsSection
            Heading="Basic example"
            Summary="Use utilities like text-sm and text-2xl to set the font size of an element. Each previewed TextBlock below carries the real tw:Tw.Class token.">
            <docs:DocsExample>
                <StackPanel
                    Spacing="12">
                    <TextBlock
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="text-slate-100 text-xs"
                        Text="The quick brown fox jumps over the lazy dog." />
                    <TextBlock
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="text-slate-100 text-base"
                        Text="The quick brown fox jumps over the lazy dog." />
                    <TextBlock
                        docs:DocsCode.Show="True"
                        FontWeight="SemiBold"
                        tw:Tw.Class="text-slate-100 text-2xl"
                        Text="The quick brown fox." />
                    <TextBlock
                        docs:DocsCode.Show="True"
                        FontWeight="Bold"
                        LetterSpacing="-1"
                        tw:Tw.Class="text-slate-50 text-5xl"
                        Text="Quick fox" />
                </StackPanel>
            </docs:DocsExample>
        </docs:DocsSection>

        <docs:DocsSection
            Heading="Setting the line-height"
            Summary="Add a slash after the size to set the line height too: text-sm/6 is 14px text on a 24px line. The number uses the spacing scale, and brackets take any value, where a unitless or em value multiplies the font size. A later leading-* class still overrides it.">
            <docs:DocsExample>
                <StackPanel
                    Spacing="16">
                    <TextBlock docs:DocsCode.Show="True" Width="320" HorizontalAlignment="Left" tw:Tw.Class="text-slate-100 text-sm/6 text-wrap" Text="text-sm/6: So I started to walk into the water. I won&#x27;t lie to you boys, I was terrified." />
                    <TextBlock docs:DocsCode.Show="True" Width="320" HorizontalAlignment="Left" tw:Tw.Class="text-slate-100 text-sm/7 text-wrap" Text="text-sm/7: So I started to walk into the water. I won&#x27;t lie to you boys, I was terrified." />
                    <TextBlock docs:DocsCode.Show="True" Width="320" HorizontalAlignment="Left" tw:Tw.Class="text-slate-100 text-sm/8 text-wrap" Text="text-sm/8: So I started to walk into the water. I won&#x27;t lie to you boys, I was terrified." />
                    <TextBlock docs:DocsCode.Show="True" Width="320" HorizontalAlignment="Left" tw:Tw.Class="text-slate-100 text-lg/[1.5] text-wrap" Text="text-lg/[1.5]: So I started to walk into the water. I won&#x27;t lie to you boys, I was terrified." />
                </StackPanel>
            </docs:DocsExample>
        </docs:DocsSection>

        <docs:DocsSection
            Heading="Using a custom value"
            Summary="Bracket syntax like text-[14px] sets the font size from an absolute value.">
            <StackPanel
                Spacing="18">
                <docs:DocsNote
                    Title="How arbitrary sizes resolve">
                    <StackPanel
                        Spacing="8">
                        <TextBlock
                            Classes="docs-tableClass"
                            Text="px · rem · em · unitless" />
                        <TextBlock
                            Classes="docs-noteBody"
                            Text="Arbitrary font sizes are parser-only and emit no generated package keys." />
                        <TextBlock
                            Classes="docs-noteBody"
                            Text="rem and em resolve against a 16px base. Unitless values are treated as px." />
                        <TextBlock
                            Classes="docs-noteBody"
                            Text="Percentages and text-(length:&lt;custom-property&gt;) stay unsupported because Avalonia models FontSize as an absolute double." />
                    </StackPanel>
                </docs:DocsNote>
                <docs:DocsExample>
                    <StackPanel
                        Spacing="12">
                        <TextBlock
                            docs:DocsCode.Show="True"
                            tw:Tw.Class="text-slate-100 text-[14px]"
                            Text="text-[14px]" />
                        <TextBlock
                            docs:DocsCode.Show="True"
                            FontWeight="SemiBold"
                            tw:Tw.Class="text-slate-100 text-[1.5rem]"
                            Text="text-[1.5rem]" />
                        <TextBlock
                            docs:DocsCode.Show="True"
                            FontWeight="Bold"
                            tw:Tw.Class="text-slate-50 text-[2em]"
                            Text="text-[2em]" />
                    </StackPanel>
                </docs:DocsExample>
            </StackPanel>
        </docs:DocsSection>

        <docs:DocsSection
            Heading="Responsive design"
            Summary="Tailwind's font-size docs also show breakpoint-prefixed examples like md:text-base. Breakpoint prefixes are unsupported across the whole parser surface, and font size does not accept hover:, pressed: or focus: either — those work only on the bg-*, text-*, border-* colour utilities and opacity-*. See Interactivity &gt; Pseudo-class variants.">
            <docs:DocsNote
                Classes="gap muted"
                Title="Official examples not implemented yet">
                <TextBlock
                    Classes="docs-tableClass"
                    Text="md:text-base · lg:text-2xl" />
            </docs:DocsNote>
        </docs:DocsSection>
    </docs:DocsPage>
</UserControl>
