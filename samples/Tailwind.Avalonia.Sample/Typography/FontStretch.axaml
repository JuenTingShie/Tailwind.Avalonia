<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Typography.FontStretch">
    <docs:DocsPage
        Section="Typography"
        Title="Font stretch"
        Intro="Utilities for the width of the typeface. font-stretch-* map to the FontStretch property."
        Supported="font-stretch-ultra-condensed through font-stretch-ultra-expanded set FontStretch. It is available on every platform, but only fonts that ship condensed or expanded faces change appearance; other fonts render at normal width.">
        <docs:DocsPage.Utilities>
            <docs:UtilityReferenceRow ClassName="font-stretch-ultra-condensed" AxamlStyle="FontStretch: UltraCondensed" />
            <docs:UtilityReferenceRow ClassName="font-stretch-extra-condensed" AxamlStyle="FontStretch: ExtraCondensed" />
            <docs:UtilityReferenceRow ClassName="font-stretch-condensed" AxamlStyle="FontStretch: Condensed" />
            <docs:UtilityReferenceRow ClassName="font-stretch-semi-condensed" AxamlStyle="FontStretch: SemiCondensed" />
            <docs:UtilityReferenceRow ClassName="font-stretch-normal" AxamlStyle="FontStretch: Normal" />
            <docs:UtilityReferenceRow ClassName="font-stretch-semi-expanded" AxamlStyle="FontStretch: SemiExpanded" />
            <docs:UtilityReferenceRow ClassName="font-stretch-expanded" AxamlStyle="FontStretch: Expanded" />
            <docs:UtilityReferenceRow ClassName="font-stretch-extra-expanded" AxamlStyle="FontStretch: ExtraExpanded" />
            <docs:UtilityReferenceRow ClassName="font-stretch-ultra-expanded" AxamlStyle="FontStretch: UltraExpanded" />
        </docs:DocsPage.Utilities>
        <docs:DocsPage.Gaps>
            <docs:DocsGap Text="font-stretch-&lt;percentage&gt;" />
        </docs:DocsPage.Gaps>

        <docs:DocsSection
            Heading="Font stretch"
            Summary="Only fonts with matching faces change width.">
            <docs:DocsExample>
                <StackPanel Spacing="8">
                    <TextBlock docs:DocsCode.Show="True" FontSize="20" tw:Tw.Class="font-stretch-condensed" Text="font-stretch-condensed" />
                    <TextBlock docs:DocsCode.Show="True" FontSize="20" tw:Tw.Class="font-stretch-normal" Text="font-stretch-normal" />
                    <TextBlock docs:DocsCode.Show="True" FontSize="20" tw:Tw.Class="font-stretch-expanded" Text="font-stretch-expanded" />
                </StackPanel>
            </docs:DocsExample>
        </docs:DocsSection>
    </docs:DocsPage>
</UserControl>
