<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Typography.ColorUtilities">
    <docs:DocsPage
        Section="Typography"
        Title="Colors"
        Intro="Use bg-*, text-*, and border-* to apply whole-property Tailwind palette colors to Avalonia controls. This page covers the families tw:Tw.Class already implements, including transparent, /opacity, and arbitrary hex bracket values.">
        <StackPanel
            Spacing="52">
            <StackPanel
                Classes="docs-overviewStack">
                <docs:DocsNote
                    Classes="supported"
                    Title="Implemented in this sample"
                    Body="bg-*, text-*, and border-* accept Tailwind palette tokens, transparent, /opacity, and arbitrary hex bracket values. Border utilities set the whole BorderBrush property; per-side border colors stay outside the current no-custom-component scope." />
                <docs:DocsUtilityTable
                    x:Name="UtilityTable"
                    CollapsedRowCount="4" />
            </StackPanel>

            <StackPanel
                Spacing="22">
                <TextBlock
                    Classes="docs-eyebrow"
                    Text="Examples" />
                <StackPanel
                    Classes="docs-exampleStack">
                    <docs:DocsSection
                        Heading="Text color"
                        Summary="Apply text-* directly to controls that expose Foreground. Every line below carries the real tw:Tw.Class token on the text element itself.">
                        <docs:DocsExample>
                            <docs:DocsExample.Snippets>
                                <x:String>&lt;TextBlock tw:Tw.Class="text-sky-300" /&gt;</x:String>
                                <x:String>&lt;TextBlock tw:Tw.Class="text-rose-300/80" /&gt;</x:String>
                            </docs:DocsExample.Snippets>
                            <StackPanel
                                Spacing="12">
                                <TextBlock
                                    FontSize="28"
                                    FontWeight="Bold"
                                    LetterSpacing="-0.5"
                                    tw:Tw.Class="text-sky-300"
                                    Text="text-sky-300" />
                                <TextBlock
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    tw:Tw.Class="text-rose-300/80"
                                    Text="text-rose-300/80" />
                                <TextBlock
                                    FontSize="16"
                                    tw:Tw.Class="text-slate-200"
                                    Text="text-slate-200 keeps longer copy readable on dark surfaces." />
                            </StackPanel>
                        </docs:DocsExample>
                    </docs:DocsSection>

                    <docs:DocsSection
                        Heading="Background and border color"
                        Summary="Apply bg-* and border-* to controls that expose Background and BorderBrush. The utilities sit on the live target control rather than on a painted stand-in.">
                        <docs:DocsExample>
                            <docs:DocsExample.Snippets>
                                <x:String>&lt;Button tw:Tw.Class="bg-emerald-500 text-slate-950 border-emerald-300" /&gt;</x:String>
                                <x:String>&lt;Button tw:Tw.Class="bg-transparent text-sky-200 border-sky-400" /&gt;</x:String>
                            </docs:DocsExample.Snippets>
                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="20"
                                RowDefinitions="Auto,Auto"
                                RowSpacing="16">
                                <Button
                                    Grid.Column="0"
                                    Grid.Row="0"
                                    CornerRadius="10"
                                    BorderThickness="2"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    tw:Tw.Class="bg-emerald-500 text-slate-950 border-emerald-300 px-[18px] py-3.5"
                                    Content="bg-emerald-500" />
                                <Button
                                    Grid.Column="1"
                                    Grid.Row="0"
                                    CornerRadius="10"
                                    BorderThickness="2"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    tw:Tw.Class="bg-amber-400/20 text-amber-100 border-amber-300/45 px-[18px] py-3.5"
                                    Content="bg-amber-400/20 border-amber-300/45" />
                                <Button
                                    Grid.Column="0"
                                    Grid.Row="1"
                                    CornerRadius="10"
                                    BorderThickness="2"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    tw:Tw.Class="bg-transparent text-sky-200 border-sky-400 px-[18px] py-3.5"
                                    Content="bg-transparent" />
                                <Button
                                    Grid.Column="1"
                                    Grid.Row="1"
                                    CornerRadius="10"
                                    BorderThickness="2"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    tw:Tw.Class="bg-violet-500/20 text-violet-100 border-violet-300/55 px-[18px] py-3.5"
                                    Content="border-violet-300/55" />
                            </Grid>
                        </docs:DocsExample>
                    </docs:DocsSection>

                    <docs:DocsSection
                        Heading="Whole-property border scope"
                        Summary="Border color support sets BorderBrush on the target control, so the whole outline changes together. That matches the implemented parser boundary.">
                        <docs:DocsExample
                            Code="&lt;Border BorderThickness=&quot;3&quot; tw:Tw.Class=&quot;border-cyan-400&quot; /&gt;">
                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="20">
                                <Border
                                    Grid.Column="0"
                                    CornerRadius="14"
                                    BorderThickness="3"
                                    tw:Tw.Class="border-cyan-400 bg-slate-900 p-[18px]">
                                    <StackPanel
                                        Spacing="8">
                                        <TextBlock
                                            Classes="docs-chip"
                                            Text="border-cyan-400" />
                                        <TextBlock
                                            Classes="docs-noteBody"
                                            Text="The whole outline changes together." />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Grid.Column="1"
                                    CornerRadius="14"
                                    BorderThickness="3"
                                    tw:Tw.Class="border-rose-400/65 bg-slate-900 p-[18px]">
                                    <StackPanel
                                        Spacing="8">
                                        <TextBlock
                                            Classes="docs-chip"
                                            Text="border-rose-400/65" />
                                        <TextBlock
                                            Classes="docs-noteBody"
                                            Text="Directional border colors stay out of scope here." />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </docs:DocsExample>
                    </docs:DocsSection>

                    <docs:DocsSection
                        Heading="Arbitrary color values"
                        Summary="Bracket syntax like text-[#ff6b6b] takes a direct color value.">
                        <StackPanel
                            Spacing="18">
                            <docs:DocsNote
                                Title="How arbitrary colors resolve">
                                <StackPanel
                                    Spacing="8">
                                    <TextBlock
                                        Classes="docs-tableClass"
                                        Text="#rrggbb · #rrggbbaa · #rgb · #rgba · [#hex]/opacity" />
                                    <TextBlock
                                        Classes="docs-tableClass"
                                        Text="rgb(r,g,b) · rgba(r,g,b,a) · hsl(h,s%,l%) · hsla(h,s%,l%,a) · oklch(l%,c,h)" />
                                    <TextBlock
                                        Classes="docs-noteBody"
                                        Text="Hex is case-insensitive. Arbitrary colors are parser-only and generate no dedicated package keys." />
                                    <TextBlock
                                        Classes="docs-noteBody"
                                        Text="Only bracket syntax is parsed, and the bracket may hold a hex literal or an rgb(), rgba(), hsl(), hsla(), or oklch() function. bg-(&lt;custom-property&gt;), text-(&lt;custom-property&gt;), and border-(&lt;custom-property&gt;) stay unsupported." />
                                    <TextBlock
                                        Classes="docs-noteBody"
                                        Text="The class list is split on whitespace before parsing, so only space-free function syntax survives: bg-[rgb(255,0,0)] works but bg-[rgb(255, 0, 0)] silently does nothing. oklch() must use commas here too, e.g. bg-[oklch(70%,0.15,200)], because the CSS-standard space-separated form cannot survive that split." />
                                    <TextBlock
                                        Classes="docs-noteBody"
                                        Text="CSS-native inner alpha, e.g. rgb(255,0,0/0.5), is not supported. Set alpha with the post-bracket modifier instead, e.g. bg-[rgb(255,0,0)]/50." />
                                </StackPanel>
                            </docs:DocsNote>
                            <docs:DocsExample>
                                <docs:DocsExample.Snippets>
                                    <x:String>&lt;TextBlock tw:Tw.Class="text-[#ff6b6b]" /&gt;</x:String>
                                    <x:String>&lt;TextBlock tw:Tw.Class="text-[#4ecdc4]/70" /&gt;</x:String>
                                    <x:String>&lt;Button tw:Tw.Class="bg-[#95e1d3] text-[#38ada9] border-[#1abc9c]" /&gt;</x:String>
                                </docs:DocsExample.Snippets>
                                <StackPanel
                                    Spacing="12">
                                    <TextBlock
                                        FontSize="24"
                                        FontWeight="Bold"
                                        LetterSpacing="-0.4"
                                        tw:Tw.Class="text-[#ff6b6b]"
                                        Text="text-[#ff6b6b]" />
                                    <TextBlock
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        tw:Tw.Class="text-[#4ecdc4]/70"
                                        Text="text-[#4ecdc4]/70" />
                                    <Button
                                        CornerRadius="10"
                                        BorderThickness="2"
                                        HorizontalAlignment="Left"
                                        tw:Tw.Class="bg-[#95e1d3] text-[#38ada9] border-[#1abc9c] px-3.5 py-[9px]"
                                        Content="bg / text / border arbitrary" />
                                </StackPanel>
                            </docs:DocsExample>
                            <docs:DocsExample>
                                <docs:DocsExample.Snippets>
                                    <x:String>&lt;TextBlock tw:Tw.Class="text-[rgb(56,173,169)]" /&gt;</x:String>
                                    <x:String>&lt;TextBlock tw:Tw.Class="text-[hsl(175,50%,55%)]/70" /&gt;</x:String>
                                    <x:String>&lt;Button tw:Tw.Class="bg-[oklch(70%,0.15,200)] text-[#04252b] border-[rgb(0,140,148)]" /&gt;</x:String>
                                </docs:DocsExample.Snippets>
                                <StackPanel
                                    Spacing="12">
                                    <TextBlock
                                        FontSize="24"
                                        FontWeight="Bold"
                                        LetterSpacing="-0.4"
                                        tw:Tw.Class="text-[rgb(56,173,169)]"
                                        Text="text-[rgb(56,173,169)]" />
                                    <TextBlock
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        tw:Tw.Class="text-[hsl(175,50%,55%)]/70"
                                        Text="text-[hsl(175,50%,55%)]/70" />
                                    <Button
                                        CornerRadius="10"
                                        BorderThickness="2"
                                        HorizontalAlignment="Left"
                                        tw:Tw.Class="bg-[oklch(70%,0.15,200)] text-[#04252b] border-[rgb(0,140,148)] px-3.5 py-[9px]"
                                        Content="bg / text / border via CSS functions" />
                                </StackPanel>
                            </docs:DocsExample>
                        </StackPanel>
                    </docs:DocsSection>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </docs:DocsPage>
</UserControl>
