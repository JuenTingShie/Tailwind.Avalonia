<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Typography.LetterSpacingLineHeight">
    <docs:DocsPage
        Section="Typography"
        Title="Tracking and leading"
        Intro="Utilities for letter spacing (tracking-*) and line height (leading-*). They map to Avalonia&#x27;s TextBlock LetterSpacing and LineHeight properties."
        Supported="tracking-* sets LetterSpacing and leading-* sets LineHeight in device-independent pixels. Named tracking values (tighter to widest, in em) and leading-none (1 x the font size) are resolved against the font size in the same class list, for example text-lg, or against the element&#x27;s current FontSize when the list has no size class. leading-&lt;n&gt; uses the spacing scale (leading-6 is 24px) and both accept arbitrary pixel values such as tracking-[3px] and leading-[18px]. Removing the class restores the default. Values are calculated when the class is applied and do not follow later FontSize changes.">
        <docs:DocsPage.Utilities>
            <docs:UtilityReferenceRow ClassName="tracking-tighter" AxamlStyle="LetterSpacing: -0.05em" />
            <docs:UtilityReferenceRow ClassName="tracking-tight" AxamlStyle="LetterSpacing: -0.025em" />
            <docs:UtilityReferenceRow ClassName="tracking-normal" AxamlStyle="LetterSpacing: 0" />
            <docs:UtilityReferenceRow ClassName="tracking-wide" AxamlStyle="LetterSpacing: 0.025em" />
            <docs:UtilityReferenceRow ClassName="tracking-wider" AxamlStyle="LetterSpacing: 0.05em" />
            <docs:UtilityReferenceRow ClassName="tracking-widest" AxamlStyle="LetterSpacing: 0.1em" />
            <docs:UtilityReferenceRow ClassName="tracking-[3px]" AxamlStyle="LetterSpacing: 3px" />
            <docs:UtilityReferenceRow ClassName="leading-none" AxamlStyle="LineHeight: 1 x font size" />
            <docs:UtilityReferenceRow ClassName="leading-6" AxamlStyle="LineHeight: 24px" />
            <docs:UtilityReferenceRow ClassName="leading-[18px]" AxamlStyle="LineHeight: 18px" />
            <docs:UtilityReferenceRow ClassName="leading-[&lt;number&gt;]" AxamlStyle="LineHeight: number x font size (leading-[1.5])" />
            <docs:UtilityReferenceRow ClassName="leading-[&lt;n&gt;em]" AxamlStyle="LineHeight: n x font size" />
        </docs:DocsPage.Utilities>

        <docs:DocsSection
            Heading="Letter spacing"
            Summary="Named tracking values scale with the font size in the class list. An arbitrary pixel value ignores the font size.">
            <docs:DocsExample>
                <StackPanel
                    Spacing="10">
                    <TextBlock
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="text-base tracking-tighter"
                        Text="text-base tracking-tighter" />
                    <TextBlock
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="text-base tracking-normal"
                        Text="text-base tracking-normal" />
                    <TextBlock
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="text-base tracking-wide"
                        Text="text-base tracking-wide" />
                    <TextBlock
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="text-base tracking-widest"
                        Text="text-base tracking-widest" />
                    <TextBlock
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="text-base tracking-[6px]"
                        Text="text-base tracking-[6px]" />
                </StackPanel>
            </docs:DocsExample>
        </docs:DocsSection>

        <docs:DocsSection
            Heading="Line height"
            Summary="Each paragraph is 18rem wide so it wraps. leading-&lt;n&gt; uses the spacing scale: leading-5 is 20px, leading-6 24px, leading-8 32px and leading-10 40px.">
            <docs:DocsExample>
                <StackPanel
                    Spacing="10">
                    <TextBlock
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="w-72 text-sm text-wrap leading-5"
                        Text="leading-5: Line height controls the space between lines of wrapped text, so a longer paragraph shows the difference clearly." />
                    <TextBlock
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="w-72 text-sm text-wrap leading-6"
                        Text="leading-6: Line height controls the space between lines of wrapped text, so a longer paragraph shows the difference clearly." />
                    <TextBlock
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="w-72 text-sm text-wrap leading-8"
                        Text="leading-8: Line height controls the space between lines of wrapped text, so a longer paragraph shows the difference clearly." />
                    <TextBlock
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="w-72 text-sm text-wrap leading-10"
                        Text="leading-10: Line height controls the space between lines of wrapped text, so a longer paragraph shows the difference clearly." />
                </StackPanel>
            </docs:DocsExample>
        </docs:DocsSection>

        <docs:DocsSection
            Heading="Custom line height"
            Summary="As in CSS, a unitless or em value multiplies the font size: with text-sm (14px), leading-[1.5] and leading-[1.5em] are 21px. px and rem values are absolute. Tailwind v4 removed the named leading-tight family, so use this form, the spacing scale or text-sm/6.">
            <docs:DocsExample>
                <StackPanel
                    Spacing="10">
                    <TextBlock docs:DocsCode.Show="True" tw:Tw.Class="w-72 text-sm text-wrap leading-[1.5]" Text="leading-[1.5]: Line height controls the space between lines of wrapped text, so a longer paragraph shows the difference clearly." />
                    <TextBlock docs:DocsCode.Show="True" tw:Tw.Class="w-72 text-sm text-wrap leading-[2rem]" Text="leading-[2rem]: Line height controls the space between lines of wrapped text, so a longer paragraph shows the difference clearly." />
                </StackPanel>
            </docs:DocsExample>
        </docs:DocsSection>
    </docs:DocsPage>
</UserControl>
