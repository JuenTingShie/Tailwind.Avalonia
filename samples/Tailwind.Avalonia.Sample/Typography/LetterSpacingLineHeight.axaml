<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Typography.LetterSpacingLineHeight">
    <docs:DocsPage
        Section="Typography"
        Title="Tracking and leading"
        Intro="Utilities for letter spacing (tracking-*) and line height (leading-*). They map to Avalonia&#x27;s TextBlock LetterSpacing and LineHeight properties."
        Supported="tracking-* sets LetterSpacing and leading-* sets LineHeight in device-independent pixels. Named tracking values (tighter to widest, in em) and leading keywords (none to loose, as multiples of the font size) are resolved against the font size in the same class list, for example text-lg, or against the element&#x27;s current FontSize when the list has no size class. leading-&lt;n&gt; uses the spacing scale (leading-6 is 24px) and both accept arbitrary pixel values such as tracking-[3px] and leading-[18px]. Removing the class restores the default. Values are calculated when the class is applied and do not follow later FontSize changes.">
        <docs:DocsPage.Utilities>
            <docs:UtilityReferenceRow ClassName="tracking-tighter" AxamlStyle="LetterSpacing: -0.05em" />
            <docs:UtilityReferenceRow ClassName="tracking-tight" AxamlStyle="LetterSpacing: -0.025em" />
            <docs:UtilityReferenceRow ClassName="tracking-normal" AxamlStyle="LetterSpacing: 0" />
            <docs:UtilityReferenceRow ClassName="tracking-wide" AxamlStyle="LetterSpacing: 0.025em" />
            <docs:UtilityReferenceRow ClassName="tracking-wider" AxamlStyle="LetterSpacing: 0.05em" />
            <docs:UtilityReferenceRow ClassName="tracking-widest" AxamlStyle="LetterSpacing: 0.1em" />
            <docs:UtilityReferenceRow ClassName="tracking-[3px]" AxamlStyle="LetterSpacing: 3px" />
            <docs:UtilityReferenceRow ClassName="leading-none" AxamlStyle="LineHeight: 1 x font size" />
            <docs:UtilityReferenceRow ClassName="leading-tight" AxamlStyle="LineHeight: 1.25 x font size" />
            <docs:UtilityReferenceRow ClassName="leading-snug" AxamlStyle="LineHeight: 1.375 x font size" />
            <docs:UtilityReferenceRow ClassName="leading-normal" AxamlStyle="LineHeight: 1.5 x font size" />
            <docs:UtilityReferenceRow ClassName="leading-relaxed" AxamlStyle="LineHeight: 1.625 x font size" />
            <docs:UtilityReferenceRow ClassName="leading-loose" AxamlStyle="LineHeight: 2 x font size" />
            <docs:UtilityReferenceRow ClassName="leading-6" AxamlStyle="LineHeight: 24px" />
            <docs:UtilityReferenceRow ClassName="leading-[18px]" AxamlStyle="LineHeight: 18px" />
        </docs:DocsPage.Utilities>

        <docs:DocsSection
            Heading="Letter spacing"
            Summary="Named tracking values scale with the font size in the class list. An arbitrary pixel value ignores the font size.">
            <docs:DocsExample>
                <StackPanel
                    Spacing="10">
                    <TextBlock
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="text-base tracking-tighter"
                        Text="text-base tracking-tighter" />
                    <TextBlock
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="text-base tracking-normal"
                        Text="text-base tracking-normal" />
                    <TextBlock
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="text-base tracking-wide"
                        Text="text-base tracking-wide" />
                    <TextBlock
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="text-base tracking-widest"
                        Text="text-base tracking-widest" />
                    <TextBlock
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="text-base tracking-[6px]"
                        Text="text-base tracking-[6px]" />
                </StackPanel>
            </docs:DocsExample>
        </docs:DocsSection>

        <docs:DocsSection
            Heading="Line height"
            Summary="Each paragraph is 18rem wide so it wraps. leading-10 is a fixed 40px, the keyword values scale with the text-sm font size.">
            <docs:DocsExample>
                <StackPanel
                    Spacing="10">
                    <TextBlock
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="w-72 text-sm text-wrap leading-tight"
                        Text="leading-tight: Line height controls the space between lines of wrapped text, so a longer paragraph shows the difference clearly." />
                    <TextBlock
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="w-72 text-sm text-wrap leading-normal"
                        Text="leading-normal: Line height controls the space between lines of wrapped text, so a longer paragraph shows the difference clearly." />
                    <TextBlock
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="w-72 text-sm text-wrap leading-loose"
                        Text="leading-loose: Line height controls the space between lines of wrapped text, so a longer paragraph shows the difference clearly." />
                    <TextBlock
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="w-72 text-sm text-wrap leading-10"
                        Text="leading-10: Line height controls the space between lines of wrapped text, so a longer paragraph shows the difference clearly." />
                </StackPanel>
            </docs:DocsExample>
        </docs:DocsSection>
    </docs:DocsPage>
</UserControl>
