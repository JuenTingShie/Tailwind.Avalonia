<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Typography.FontFamily">
    <docs:DocsPage
        Section="Typography"
        Title="Font family"
        Intro="Utilities for choosing the typeface. font-sans, font-serif and font-mono map to FontFamily fallback stacks."
        Supported="font-sans, font-serif and font-mono set FontFamily to a fallback stack modelled on Tailwind defaults. Families that are not installed fall back to the next entry and finally the platform default, so the tokens are safe on desktop, Browser and mobile. Later font family classes win and removing the class restores the default.">
        <docs:DocsPage.Utilities>
            <docs:UtilityReferenceRow ClassName="italic" AxamlStyle="&lt;TextBlock FontFamily=&quot;Italic&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="not-italic" AxamlStyle="&lt;TextBlock FontFamily=&quot;Normal&quot; /&gt;" />
        </docs:DocsPage.Utilities>
        <docs:DocsPage.Gaps>
            <docs:DocsGap Text="font-[Family Name] · font-(--var) · theme font tokens" />
        </docs:DocsPage.Gaps>

        <docs:DocsSection
            Heading="Sans, serif and mono"
            Summary="Each TextBlock below carries the real token; the rendered face depends on which fonts the platform provides.">
            <docs:DocsExample>
                <StackPanel
                    Spacing="10">
                    <TextBlock docs:DocsCode.Show="True" FontSize="20" tw:Tw.Class="font-sans" Text="font-sans: The quick brown fox" />
                    <TextBlock docs:DocsCode.Show="True" FontSize="20" tw:Tw.Class="font-serif" Text="font-serif: The quick brown fox" />
                    <TextBlock docs:DocsCode.Show="True" FontSize="20" tw:Tw.Class="font-mono" Text="font-mono: The quick brown fox" />
                </StackPanel>
            </docs:DocsExample>
        </docs:DocsSection>
    </docs:DocsPage>
</UserControl>
