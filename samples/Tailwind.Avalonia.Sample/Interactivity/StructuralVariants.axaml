<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Interactivity.StructuralVariants">
    <docs:DocsPage
        Section="Interactivity"
        Title="Structural variants"
        Intro="first:, last:, odd: and even: apply a utility depending on the element&#x27;s position among its siblings. They map to Avalonia&#x27;s nth-child selectors."
        Supported="first:, last:, odd: and even: work with the color (bg-, text-, border-) and opacity utilities. They match once the element has a parent, count from 1 like CSS, and can be combined with hover: etc. Core Avalonia selectors, so they work on every platform."
        GapsBody="Structural variants for other utilities and dark: / group-* variants are not implemented yet.">
        <docs:DocsPage.Utilities>
            <docs:UtilityReferenceRow ClassName="first:&lt;utility&gt;" AxamlStyle=":nth-child(1)" />
            <docs:UtilityReferenceRow ClassName="last:&lt;utility&gt;" AxamlStyle=":nth-last-child(1)" />
            <docs:UtilityReferenceRow ClassName="odd:&lt;utility&gt;" AxamlStyle=":nth-child(2n+1)" />
            <docs:UtilityReferenceRow ClassName="even:&lt;utility&gt;" AxamlStyle=":nth-child(2n)" />
        </docs:DocsPage.Utilities>
        <docs:DocsPage.Gaps>
            <docs:DocsGap Text="dark: · group-hover: · aria-* · variants on non-color utilities" />
        </docs:DocsPage.Gaps>

        <docs:DocsSection
            Heading="First, last, odd and even"
            Summary="Every row carries the same classes; only its position differs.">
            <docs:DocsExample>
                <StackPanel Spacing="4" Width="260">
                    <ContentControl docs:DocsCode.Show="True" Padding="10" CornerRadius="6" tw:Tw.Class="bg-slate-100 first:bg-sky-200 last:bg-amber-200 odd:text-slate-900 even:text-slate-600"><TextBlock Text="row 1" /></ContentControl>
                    <ContentControl Padding="10" CornerRadius="6" tw:Tw.Class="bg-slate-100 first:bg-sky-200 last:bg-amber-200 odd:text-slate-900 even:text-slate-600"><TextBlock Text="row 2" /></ContentControl>
                    <ContentControl Padding="10" CornerRadius="6" tw:Tw.Class="bg-slate-100 first:bg-sky-200 last:bg-amber-200 odd:text-slate-900 even:text-slate-600"><TextBlock Text="row 3" /></ContentControl>
                    <ContentControl Padding="10" CornerRadius="6" tw:Tw.Class="bg-slate-100 first:bg-sky-200 last:bg-amber-200 odd:text-slate-900 even:text-slate-600"><TextBlock Text="row 4" /></ContentControl>
                    <ContentControl Padding="10" CornerRadius="6" tw:Tw.Class="bg-slate-100 first:bg-sky-200 last:bg-amber-200 odd:text-slate-900 even:text-slate-600"><TextBlock Text="row 5" /></ContentControl>
                </StackPanel>
            </docs:DocsExample>
        </docs:DocsSection>
    </docs:DocsPage>
</UserControl>
