<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Interactivity.ColorScheme">
    <docs:DocsPage
        Section="Interactivity"
        Title="Color scheme"
        Intro="Utilities for choosing the light or dark theme of a subtree. scheme-* sets RequestedThemeVariant.">
        <StackPanel
            Spacing="52">
            <StackPanel
                Classes="docs-overviewStack">
                <docs:DocsNote
                    Classes="supported"
                    Title="Implemented in this sample"
                    Body="scheme-light, scheme-dark and scheme-normal set RequestedThemeVariant on the element that carries them, which is meaningful on ThemeVariantScope (and Window). Everything inside renders with that theme variant. Core Avalonia theming, available on every platform." />
                <docs:DocsUtilityTable
                    x:Name="UtilityTable"
                    CollapsedRowCount="6" />
                <docs:DocsNote
                    Classes="gap"
                    Title="Not implemented yet"
                    Body="These forms sit outside the current parser surface.">
                    <StackPanel
                        Spacing="6">
                        <TextBlock
                            Classes="docs-tableClass"
                            Text="dark: variant · scheme-light-dark" />
                    </StackPanel>
                </docs:DocsNote>
            </StackPanel>

            <StackPanel
                Spacing="22">
                <TextBlock
                    Classes="docs-eyebrow"
                    Text="Examples" />
                <StackPanel
                    Classes="docs-exampleStack">
                    <docs:DocsSection
                        Heading="Light and dark scopes"
                        Summary="Both scopes sit in the same window but follow their own theme variant.">
                        <docs:DocsExample>
                            <docs:DocsExample.Snippets>
                                <x:String>&lt;ThemeVariantScope tw:Tw.Class=&quot;scheme-light&quot; /&gt;</x:String>
                                <x:String>&lt;ThemeVariantScope tw:Tw.Class=&quot;scheme-dark&quot; /&gt;</x:String>
                            </docs:DocsExample.Snippets>
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <ThemeVariantScope tw:Tw.Class="scheme-light">
                                    <Border Padding="16" Background="{DynamicResource SystemRegionBrush}">
                                        <StackPanel Spacing="8"><TextBlock Text="scheme-light" /><Button Content="Button" /></StackPanel>
                                    </Border>
                                </ThemeVariantScope>
                                <ThemeVariantScope tw:Tw.Class="scheme-dark">
                                    <Border Padding="16" Background="{DynamicResource SystemRegionBrush}">
                                        <StackPanel Spacing="8"><TextBlock Text="scheme-dark" /><Button Content="Button" /></StackPanel>
                                    </Border>
                                </ThemeVariantScope>
                            </StackPanel>
                        </docs:DocsExample>
                    </docs:DocsSection>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </docs:DocsPage>
</UserControl>
