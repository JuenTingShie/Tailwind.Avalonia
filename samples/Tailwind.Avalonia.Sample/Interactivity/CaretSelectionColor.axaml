<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Interactivity.CaretSelectionColor">
    <docs:DocsPage
        Section="Interactivity"
        Title="Caret and selection color"
        Intro="Utilities for coloring the text caret and the text selection. caret-* maps to CaretBrush, and the selection: variant maps to SelectionBrush and SelectionForegroundBrush."
        Supported="caret-&lt;color&gt; sets CaretBrush. The selection: variant styles selected text: selection:bg-&lt;color&gt; sets SelectionBrush and selection:text-&lt;color&gt; sets SelectionForegroundBrush. They take the same color values as bg-* and text-*: palette colors, named colors, hex values and arbitrary colors with an opacity modifier. CaretBrush exists on TextBox; the selection brushes on TextBox and SelectableTextBlock; other elements ignore the token with a warning. Removing the class restores the theme&#x27;s brush. These are plain brush properties, so they work on every target.">
        <docs:DocsPage.Utilities>
            <docs:UtilityReferenceRow ClassName="caret-&lt;color&gt;" AxamlStyle="CaretBrush" />
            <docs:UtilityReferenceRow ClassName="selection:bg-&lt;color&gt;" AxamlStyle="SelectionBrush" />
            <docs:UtilityReferenceRow ClassName="selection:text-&lt;color&gt;" AxamlStyle="SelectionForegroundBrush" />
        </docs:DocsPage.Utilities>
        <docs:DocsPage.Gaps>
            <docs:DocsGap Text="accent-* · caret color on non-text controls · selection: with non-color utilities" />
        </docs:DocsPage.Gaps>

        <docs:DocsSection
            Heading="Caret and selection colors"
            Summary="Click into each box and select some text.">
            <docs:DocsExample>
                <StackPanel
                    Spacing="12"
                    Width="420"
                    HorizontalAlignment="Left">
                    <TextBox
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="caret-red-500 selection:bg-red-300"
                        Text="caret-red-500 selection:bg-red-300" />
                    <TextBox
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="caret-emerald-500 selection:bg-emerald-300"
                        Text="caret-emerald-500 selection:bg-emerald-300" />
                    <SelectableTextBlock
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="selection:bg-amber-400 selection:text-slate-950"
                        Text="selection:bg-amber-400 selection:text-slate-950: select this text with the mouse" />
                </StackPanel>
            </docs:DocsExample>
        </docs:DocsSection>
    </docs:DocsPage>
</UserControl>
