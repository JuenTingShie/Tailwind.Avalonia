<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Interactivity.CaretSelectionColor">
    <docs:DocsPage
        Section="Interactivity"
        Title="Caret and selection color"
        Intro="Utilities for coloring the text caret and the text selection. They map to Avalonia&#x27;s CaretBrush and SelectionBrush properties."
        Supported="caret-&lt;color&gt; sets CaretBrush and selection-&lt;color&gt; sets SelectionBrush. Both take the same color values as bg-* and text-*: palette colors (caret-red-500), named colors, hex values and arbitrary colors with an opacity modifier. CaretBrush exists on TextBox, SelectionBrush on TextBox and SelectableTextBlock, and other elements ignore the token with a warning. Removing the class restores the theme&#x27;s brush. Click into a box to see the caret and select text to see the selection. These are plain brush properties, so they work on every target.">
        <docs:DocsPage.Utilities>
            <docs:UtilityReferenceRow ClassName="caret-&lt;color&gt;" AxamlStyle="CaretBrush" />
            <docs:UtilityReferenceRow ClassName="selection-&lt;color&gt;" AxamlStyle="SelectionBrush" />
        </docs:DocsPage.Utilities>
        <docs:DocsPage.Gaps>
            <docs:DocsGap Text="accent-* · caret color on non-text controls · selection: variant" />
        </docs:DocsPage.Gaps>

        <docs:DocsSection
            Heading="Caret and selection colors"
            Summary="Click into each box and select some text.">
            <docs:DocsExample>
                <StackPanel
                    Spacing="12"
                    Width="420"
                    HorizontalAlignment="Left">
                    <TextBox
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="caret-red-500 selection-red-300"
                        Text="caret-red-500 selection-red-300" />
                    <TextBox
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="caret-emerald-500 selection-emerald-300"
                        Text="caret-emerald-500 selection-emerald-300" />
                    <SelectableTextBlock
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="selection-amber-400"
                        Text="selection-amber-400: select this text with the mouse" />
                </StackPanel>
            </docs:DocsExample>
        </docs:DocsSection>
    </docs:DocsPage>
</UserControl>
