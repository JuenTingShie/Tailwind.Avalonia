<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Interactivity.PointerEvents">
    <docs:DocsPage
        Section="Interactivity"
        Title="Pointer events"
        Intro="Utilities for controlling whether an element reacts to the pointer. They map to Avalonia&#x27;s IsHitTestVisible property.">
        <StackPanel
            Spacing="52">
            <StackPanel
                Classes="docs-overviewStack">
                <docs:DocsNote
                    Classes="supported"
                    Title="Implemented in this sample"
                    Body="pointer-events-none sets IsHitTestVisible to false, so pointer input passes through the element to whatever is underneath, and pointer-events-auto sets it back to true. The last class wins and removing the class restores the default. IsHitTestVisible is defined on every visual, so it works on all targets, including touch input." />
                <docs:DocsUtilityTable
                    x:Name="UtilityTable"
                    CollapsedRowCount="6" />
                <docs:DocsNote
                    Classes="gap"
                    Title="Not implemented yet"
                    Body="These forms sit outside the current parser surface.">
                    <StackPanel
                        Spacing="6">
                        <TextBlock
                            Classes="docs-tableClass"
                            Text="select-none · hover:pointer-events-none" />
                    </StackPanel>
                </docs:DocsNote>
            </StackPanel>

            <StackPanel
                Spacing="22">
                <TextBlock
                    Classes="docs-eyebrow"
                    Text="Examples" />
                <StackPanel
                    Classes="docs-exampleStack">
                    <docs:DocsSection
                        Heading="Blocking and allowing input"
                        Summary="Both buttons are real Buttons. The second one ignores the pointer, so it does not react to hover or clicks.">
                        <docs:DocsExample>
                            <StackPanel
                                Spacing="10">
                                <Button
                                    docs:DocsCode.Show="True"
                                    Content="Clickable: pointer-events-auto"
                                    tw:Tw.Class="pointer-events-auto" />
                                <Button
                                    docs:DocsCode.Show="True"
                                    Content="Not clickable: pointer-events-none"
                                    tw:Tw.Class="pointer-events-none opacity-60" />
                            </StackPanel>
                        </docs:DocsExample>
                    </docs:DocsSection>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </docs:DocsPage>
</UserControl>
