<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Interactivity.PointerEvents">
    <docs:DocsPage
        Section="Interactivity"
        Title="Pointer events"
        Intro="Utilities for controlling whether an element reacts to the pointer. They map to Avalonia&#x27;s IsHitTestVisible property."
        Supported="pointer-events-none sets IsHitTestVisible to false, so pointer input passes through the element to whatever is underneath, and pointer-events-auto sets it back to true. The last class wins and removing the class restores the default. IsHitTestVisible is defined on every visual, so it works on all targets, including touch input.">
        <docs:DocsPage.Utilities>
            <docs:UtilityReferenceRow ClassName="pointer-events-none" AxamlStyle="IsHitTestVisible: false" />
            <docs:UtilityReferenceRow ClassName="pointer-events-auto" AxamlStyle="IsHitTestVisible: true" />
        </docs:DocsPage.Utilities>
        <docs:DocsPage.Gaps>
            <docs:DocsGap Text="select-none · hover:pointer-events-none" />
        </docs:DocsPage.Gaps>

        <docs:DocsSection
            Heading="Blocking and allowing input"
            Summary="Both buttons are real Buttons. The second one ignores the pointer, so it does not react to hover or clicks.">
            <docs:DocsExample>
                <StackPanel
                    Spacing="10">
                    <Button
                        docs:DocsCode.Show="True"
                        Content="Clickable: pointer-events-auto"
                        tw:Tw.Class="pointer-events-auto" />
                    <Button
                        docs:DocsCode.Show="True"
                        Content="Not clickable: pointer-events-none"
                        tw:Tw.Class="pointer-events-none opacity-60" />
                </StackPanel>
            </docs:DocsExample>
        </docs:DocsSection>
    </docs:DocsPage>
</UserControl>
