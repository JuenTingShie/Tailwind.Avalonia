<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Interactivity.PlaceholderColor">
    <docs:DocsPage
        Section="Interactivity"
        Title="Placeholder color"
        Intro="Utilities for the color of placeholder text. placeholder-&lt;color&gt; sets TextBox.PlaceholderForeground."
        Supported="placeholder-&lt;color&gt; uses the Tailwind palette (with optional opacity) and sets PlaceholderForeground on TextBox. Other elements ignore it with a warning. Core Avalonia property, available on every platform.">
        <docs:DocsPage.Utilities>
            <docs:UtilityReferenceRow ClassName="placeholder-&lt;color&gt;" AxamlStyle="TextBox.PlaceholderForeground" />
        </docs:DocsPage.Utilities>
        <docs:DocsPage.Gaps>
            <docs:DocsGap Text="placeholder: variant" />
        </docs:DocsPage.Gaps>

        <docs:DocsSection
            Heading="Placeholder color"
            Summary="Each TextBox is empty so the placeholder is visible.">
            <docs:DocsExample>
                <StackPanel Spacing="10" Width="280">
                    <TextBox PlaceholderText="default placeholder" />
                    <TextBox docs:DocsCode.Show="True" PlaceholderText="placeholder-rose-400" tw:Tw.Class="placeholder-rose-400" />
                    <TextBox docs:DocsCode.Show="True" PlaceholderText="placeholder-emerald-500" tw:Tw.Class="placeholder-emerald-500" />
                </StackPanel>
            </docs:DocsExample>
        </docs:DocsSection>
    </docs:DocsPage>
</UserControl>
