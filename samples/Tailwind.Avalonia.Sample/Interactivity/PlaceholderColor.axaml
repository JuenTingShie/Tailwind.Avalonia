<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Interactivity.PlaceholderColor">
    <docs:DocsPage
        Section="Interactivity"
        Title="Placeholder color"
        Intro="The placeholder: variant styles a text box&#x27;s placeholder. placeholder:text-&lt;color&gt; sets TextBox.PlaceholderForeground."
        Supported="placeholder:text-&lt;color&gt; uses the Tailwind palette (with optional opacity) and sets PlaceholderForeground on TextBox. Other elements ignore it with a warning, and placeholder: only accepts text colors. Core Avalonia property, available on every platform.">
        <docs:DocsPage.Utilities>
            <docs:UtilityReferenceRow ClassName="placeholder:text-&lt;color&gt;" AxamlStyle="TextBox.PlaceholderForeground" />
        </docs:DocsPage.Utilities>
        <docs:DocsPage.Gaps>
            <docs:DocsGap Text="placeholder:italic · placeholder: with non-color utilities" />
        </docs:DocsPage.Gaps>

        <docs:DocsSection
            Heading="Placeholder color"
            Summary="Each TextBox is empty so the placeholder is visible.">
            <docs:DocsExample>
                <StackPanel Spacing="10" Width="280">
                    <TextBox PlaceholderText="default placeholder" />
                    <TextBox docs:DocsCode.Show="True" PlaceholderText="placeholder:text-rose-400" tw:Tw.Class="placeholder:text-rose-400" />
                    <TextBox docs:DocsCode.Show="True" PlaceholderText="placeholder:text-emerald-500" tw:Tw.Class="placeholder:text-emerald-500" />
                </StackPanel>
            </docs:DocsExample>
        </docs:DocsSection>
    </docs:DocsPage>
</UserControl>
