<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Effects.Transitions">
    <docs:DocsPage
        Section="Effects"
        Title="Transitions"
        Intro="Utilities for animating a property change instead of applying it instantly. They create Avalonia Transitions for the element."
        Supported="transition, transition-all, transition-colors, transition-opacity, transition-transform and transition-shadow choose what is animated. Colors covers Background, Foreground and BorderBrush, opacity covers Opacity, transform covers RenderTransform and shadow covers BoxShadow. duration-&lt;ms&gt; (or duration-[0.5s]) sets the length, 150ms by default, delay-&lt;ms&gt; delays the start, and ease-linear, ease-in, ease-out and ease-in-out set the easing, with ease-in-out as the default. transition-none removes them. Timing classes only matter together with a transition-* class. A transition animates whatever changes the value, for example a hover: variant or code that sets the property later, and it uses the property of the element&#x27;s own type, so the utilities apply to elements that have those properties. Removing the classes clears the transitions. Avalonia&#x27;s animation system is the same on every target. Hover over each button to see the difference.">
        <docs:DocsPage.Utilities>
            <docs:UtilityReferenceRow ClassName="transition / transition-all" AxamlStyle="colors, opacity, transform and shadow" />
            <docs:UtilityReferenceRow ClassName="transition-colors" AxamlStyle="Background, Foreground, BorderBrush" />
            <docs:UtilityReferenceRow ClassName="transition-opacity" AxamlStyle="Opacity" />
            <docs:UtilityReferenceRow ClassName="transition-transform" AxamlStyle="RenderTransform" />
            <docs:UtilityReferenceRow ClassName="transition-shadow" AxamlStyle="BoxShadow" />
            <docs:UtilityReferenceRow ClassName="transition-none" AxamlStyle="no transitions" />
            <docs:UtilityReferenceRow ClassName="duration-&lt;ms&gt;" AxamlStyle="length, default 150ms" />
            <docs:UtilityReferenceRow ClassName="delay-&lt;ms&gt;" AxamlStyle="start delay" />
            <docs:UtilityReferenceRow ClassName="ease-linear / in / out / in-out" AxamlStyle="easing" />
        </docs:DocsPage.Utilities>
        <docs:DocsPage.Gaps>
            <docs:DocsGap Text="transition-[&lt;property&gt;] · transition-behavior · ease-[cubic-bezier(...)] · duration-initial · motion-safe: / motion-reduce:" />
        </docs:DocsPage.Gaps>

        <docs:DocsSection
            Heading="Colors, opacity and timing"
            Summary="Hover over each button. The first button has no transition, so its color jumps.">
            <docs:DocsExample>
                <StackPanel
                    Spacing="10"
                    HorizontalAlignment="Left">
                    <Button
                        docs:DocsCode.Show="True"
                        Content="no transition: hover changes instantly"
                        tw:Tw.Class="bg-slate-600 text-white hover:bg-emerald-600" />
                    <Button
                        docs:DocsCode.Show="True"
                        Content="transition-colors duration-500"
                        tw:Tw.Class="transition-colors duration-500 bg-slate-600 text-white hover:bg-emerald-600" />
                    <Button
                        docs:DocsCode.Show="True"
                        Content="transition-colors duration-150 ease-linear"
                        tw:Tw.Class="transition-colors duration-150 ease-linear bg-slate-600 text-white hover:bg-rose-600" />
                    <Button
                        docs:DocsCode.Show="True"
                        Content="transition-opacity duration-300"
                        tw:Tw.Class="transition-opacity duration-300 bg-sky-600 text-white opacity-100 hover:opacity-40" />
                    <Button
                        docs:DocsCode.Show="True"
                        Content="transition delay-200 duration-500"
                        tw:Tw.Class="transition delay-200 duration-500 bg-amber-600 text-white hover:bg-amber-800" />
                </StackPanel>
            </docs:DocsExample>
        </docs:DocsSection>
    </docs:DocsPage>
</UserControl>
