<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Effects.Opacity">
    <docs:DocsPage
        Section="Effects"
        Title="Opacity"
        Intro="Utilities for controlling the opacity of an element. opacity-&lt;0-100&gt; maps directly to Avalonia's Opacity property, expressed as the token's value divided by 100."
        Supported="opacity-0 through opacity-100 set Avalonia's Opacity property to the token's integer value divided by 100. hover:, pressed:, and focus: variants apply an opacity-* token only in that pseudo-class state - opacity is the only non-color utility family variant prefixes work on."
        GapsBody="These opacity forms sit outside the current parser surface.">
        <docs:DocsPage.Utilities>
            <docs:UtilityReferenceRow ClassName="opacity-&lt;0-100&gt;" AxamlStyle="&lt;Control Opacity=&quot;&lt;value / 100&gt;&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="hover:opacity-&lt;0-100&gt;" AxamlStyle="&lt;Control Opacity=&quot;&lt;value / 100&gt;&quot; /&gt; while :pointerover" />
            <docs:UtilityReferenceRow ClassName="pressed:opacity-&lt;0-100&gt;" AxamlStyle="&lt;Control Opacity=&quot;&lt;value / 100&gt;&quot; /&gt; while :pressed" />
            <docs:UtilityReferenceRow ClassName="focus:opacity-&lt;0-100&gt;" AxamlStyle="&lt;Control Opacity=&quot;&lt;value / 100&gt;&quot; /&gt; while :focus" />
            <docs:UtilityReferenceRow ClassName="opacity-[&lt;fraction&gt;]" AxamlStyle="Opacity: the fraction (.67) or percentage (35%) in brackets" />
        </docs:DocsPage.Utilities>
        <docs:DocsPage.Gaps>
            <docs:DocsGap Text="opacity-52.5 · opacity-150 · opacity-(&lt;custom-property&gt;)" />
        </docs:DocsPage.Gaps>

        <docs:DocsSection
            Heading="Basic example"
            Summary="Use opacity-&lt;number&gt; utilities like opacity-50 and opacity-100 to set the opacity of an element. Any integer from 0 through 100 works; each previewed Border below carries the real tw:Tw.Class token.">
            <docs:DocsExample>
                <Border
                    Classes="docs-inset"
                    HorizontalAlignment="Left"
                    tw:Tw.Class="p-5">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="18">
                        <Border
                            docs:DocsCode.Show="True"
                            tw:Tw.Class="bg-sky-500 rounded-lg opacity-100 w-20 h-20">
                            <docs:DocsChip OnColor="True" Text="100" />
                        </Border>
                        <Border
                            docs:DocsCode.Show="True"
                            tw:Tw.Class="bg-sky-500 rounded-lg opacity-75 w-20 h-20">
                            <docs:DocsChip OnColor="True" Text="75" />
                        </Border>
                        <Border
                            docs:DocsCode.Show="True"
                            tw:Tw.Class="bg-sky-500 rounded-lg opacity-50 w-20 h-20">
                            <docs:DocsChip OnColor="True" Text="50" />
                        </Border>
                        <Border
                            docs:DocsCode.Show="True"
                            tw:Tw.Class="bg-sky-500 rounded-lg opacity-25 w-20 h-20">
                            <docs:DocsChip OnColor="True" Text="25" />
                        </Border>
                    </StackPanel>
                </Border>
            </docs:DocsExample>
        </docs:DocsSection>

        <docs:DocsSection
            Heading="Variant prefixes"
            Summary="opacity-* is the only non-color utility family that accepts hover:, pressed:, and focus: prefixes; spacing, sizing, and font-size utilities do not. See the Interactivity &gt; Pseudo-class variants page, which already demonstrates opacity-100 pressed:opacity-50 on a button; the two controls below show hover: and focus: doing the same.">
            <docs:DocsExample>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="28">
                    <StackPanel
                        Spacing="14">
                        <TextBlock
                            Classes="docs-hint"
                            Text="Move the pointer over the box." />
                        <Border
                            docs:DocsCode.Show="True"
                            tw:Tw.Class="bg-sky-500 rounded-lg opacity-100 hover:opacity-40 w-24 h-24">
                            <docs:DocsChip OnColor="True" Text="hover" />
                        </Border>
                    </StackPanel>
                    <StackPanel
                        Spacing="14">
                        <TextBlock
                            Classes="docs-hint"
                            Text="Click into the button, or tab to it." />
                        <Button
                            docs:DocsCode.Show="True"
                            CornerRadius="10"
                            BorderThickness="0"
                            HorizontalAlignment="Left"
                            tw:Tw.Class="bg-emerald-500 opacity-100 focus:opacity-40 text-slate-950 px-[18px] py-3.5"
                            Content="focus:opacity-40" />
                    </StackPanel>
                </StackPanel>
            </docs:DocsExample>
        </docs:DocsSection>

        <docs:DocsSection
            Heading="Using a custom value"
            Summary="Bracket syntax takes any fraction from 0 to 1, or a percentage: opacity-[.67] and opacity-[35%]. Values outside that range are ignored. The same form works as a color modifier, for example bg-sky-500/[.5].">
            <docs:DocsExample>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="16">
                    <Border docs:DocsCode.Show="True" tw:Tw.Class="bg-sky-500 rounded-lg opacity-[.67] w-20 h-20"><docs:DocsChip Text="[.67]" /></Border>
                    <Border docs:DocsCode.Show="True" tw:Tw.Class="bg-sky-500 rounded-lg opacity-[35%] w-20 h-20"><docs:DocsChip Text="[35%]" /></Border>
                    <Border docs:DocsCode.Show="True" tw:Tw.Class="bg-sky-500/[.5] rounded-lg w-20 h-20"><docs:DocsChip Text="bg /[.5]" /></Border>
                </StackPanel>
            </docs:DocsExample>
        </docs:DocsSection>

        <docs:DocsSection
            Heading="Decimals and out-of-range values"
            Summary="The bare form opacity-&lt;number&gt; only accepts an integer from 0 to 100, and a bracket value must stay between 0 and 1 (or 0% and 100%). Anything else is rejected rather than clamped, so the token is dropped and the control keeps its default opacity.">
            <docs:DocsNote
                Classes="gap muted"
                Title="Not implemented">
                <StackPanel
                    Spacing="6">
                    <TextBlock
                        Classes="docs-tableClass"
                        Text="opacity-52.5 (non-integer values are rejected)" />
                    <TextBlock
                        Classes="docs-tableClass"
                        Text="opacity-150 (values outside 0-100 are rejected)" />
                    <TextBlock
                        Classes="docs-tableClass"
                        Text="opacity-[1.5] (bracket values outside 0-1 are rejected)" />
                </StackPanel>
            </docs:DocsNote>
        </docs:DocsSection>
    </docs:DocsPage>
</UserControl>
