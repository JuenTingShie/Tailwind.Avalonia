<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Effects.Blur">
    <docs:DocsPage
        Section="Effects"
        Title="Blur"
        Intro="Utilities for blurring an element. They map to Avalonia&#x27;s BlurEffect on Visual.Effect."
        Supported="blur, blur-xs, blur-sm, blur-md, blur-lg, blur-xl, blur-2xl, blur-3xl and blur-[&lt;px&gt;] set a BlurEffect with the radius Tailwind uses (4, 8, 12, 16, 24, 40 and 64 px), and drop-shadow, drop-shadow-xs to drop-shadow-2xl set a DropShadowEffect that follows the drawn shape, with a single layer approximating Tailwind&#x27;s. Both are stored in Visual.Effect, so an element carries one effect and the last of a blur and a drop shadow wins. blur-none and removing the class clear it. Each element gets its own effect object because effects belong to the UI thread. The effect applies to the whole element including its children, as in CSS filters. Effects are drawn by Avalonia&#x27;s Skia renderer, which every target uses, but the other CSS filters (grayscale, brightness, sepia and so on) have no Avalonia equivalent and backdrop-blur is not included.">
        <docs:DocsPage.Utilities>
            <docs:UtilityReferenceRow ClassName="blur / blur-sm" AxamlStyle="BlurEffect radius 8" />
            <docs:UtilityReferenceRow ClassName="blur-xs" AxamlStyle="radius 4" />
            <docs:UtilityReferenceRow ClassName="blur-md" AxamlStyle="radius 12" />
            <docs:UtilityReferenceRow ClassName="blur-lg" AxamlStyle="radius 16" />
            <docs:UtilityReferenceRow ClassName="blur-xl" AxamlStyle="radius 24" />
            <docs:UtilityReferenceRow ClassName="blur-2xl" AxamlStyle="radius 40" />
            <docs:UtilityReferenceRow ClassName="blur-3xl" AxamlStyle="radius 64" />
            <docs:UtilityReferenceRow ClassName="blur-none" AxamlStyle="radius 0" />
            <docs:UtilityReferenceRow ClassName="blur-[&lt;px&gt;]" AxamlStyle="arbitrary radius" />
        </docs:DocsPage.Utilities>
        <docs:DocsPage.Gaps>
            <docs:DocsGap Text="backdrop-blur-* · grayscale · brightness · contrast · sepia · hue-rotate · invert · saturate · blur-(&lt;custom-property&gt;)" />
        </docs:DocsPage.Gaps>

        <docs:DocsSection
            Heading="Blur radii"
            Summary="Each card is blurred by the radius in its class. The first card has no blur class.">
            <docs:DocsExample>
                <WrapPanel
                    ItemSpacing="28"
                    LineSpacing="28"
                    Margin="12"
                    Width="520"
                    HorizontalAlignment="Left">
                    <Border
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="bg-slate-600 w-28 h-16 rounded-lg p-2">
                        <TextBlock
                            FontWeight="Bold"
                            Text="none" />
                    </Border>
                    <Border
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="blur-xs bg-sky-600 w-28 h-16 rounded-lg p-2">
                        <TextBlock
                            FontWeight="Bold"
                            Text="blur-xs" />
                    </Border>
                    <Border
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="blur-sm bg-sky-600 w-28 h-16 rounded-lg p-2">
                        <TextBlock
                            FontWeight="Bold"
                            Text="blur-sm" />
                    </Border>
                    <Border
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="blur-md bg-sky-600 w-28 h-16 rounded-lg p-2">
                        <TextBlock
                            FontWeight="Bold"
                            Text="blur-md" />
                    </Border>
                    <Border
                        docs:DocsCode.Show="True"
                        tw:Tw.Class="blur-[3px] bg-sky-600 w-28 h-16 rounded-lg p-2">
                        <TextBlock
                            FontWeight="Bold"
                            Text="blur-[3px]" />
                    </Border>
                </WrapPanel>
            </docs:DocsExample>
        </docs:DocsSection>
    </docs:DocsPage>
</UserControl>
