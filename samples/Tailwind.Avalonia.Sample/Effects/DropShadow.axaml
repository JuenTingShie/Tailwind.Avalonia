<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Effects.DropShadow">
    <docs:DocsPage
        Section="Effects"
        Title="Drop shadow"
        Intro="Utilities for a soft shadow that follows the shape of an element. They map to Avalonia&#x27;s DropShadowEffect on Visual.Effect."
        Supported="drop-shadow-xs, drop-shadow-sm, drop-shadow-md, drop-shadow-lg, drop-shadow-xl and drop-shadow-2xl set a DropShadowEffect that follows the drawn shape, with a single layer approximating Tailwind&#x27;s. blur-* uses the same Visual.Effect property, so an element carries one effect and the last of a blur and a drop shadow wins. Removing the class clears it. Each element gets its own effect object because effects belong to the UI thread. The effect applies to the whole element including its children, as in CSS filters. Effects are drawn by Avalonia&#x27;s Skia renderer, which every target uses (checked in a real browser run of the Browser sample), but the shadow color is fixed black and drop-shadow-&lt;color&gt; is not included.">
        <docs:DocsPage.Utilities>
            <docs:UtilityReferenceRow ClassName="drop-shadow-xs" AxamlStyle="offset 1, blur 1" />
            <docs:UtilityReferenceRow ClassName="drop-shadow-sm" AxamlStyle="offset 1, blur 2" />
            <docs:UtilityReferenceRow ClassName="drop-shadow-md" AxamlStyle="offset 3, blur 3" />
            <docs:UtilityReferenceRow ClassName="drop-shadow-lg" AxamlStyle="offset 4, blur 4" />
            <docs:UtilityReferenceRow ClassName="drop-shadow-xl" AxamlStyle="offset 9, blur 7" />
            <docs:UtilityReferenceRow ClassName="drop-shadow-2xl" AxamlStyle="offset 25, blur 25" />
        </docs:DocsPage.Utilities>
        <docs:DocsPage.Gaps>
            <docs:DocsGap Text="drop-shadow-&lt;color&gt; · drop-shadow-[&lt;value&gt;] · multi-layer shadows" />
        </docs:DocsPage.Gaps>

        <docs:DocsSection
            Heading="Drop shadow sizes"
            Summary="The shadow is drawn below the white cards on a light backdrop and follows their rounded corners.">
            <docs:DocsExample>
                <Border
                    tw:Tw.Class="bg-slate-200 rounded-lg p-8"
                    HorizontalAlignment="Left">
                    <WrapPanel
                        ItemSpacing="32"
                        LineSpacing="32"
                        Width="480">
                        <Border
                            docs:DocsCode.Show="True"
                            tw:Tw.Class="drop-shadow-sm w-28 h-16 rounded-lg bg-white p-2">
                            <TextBlock
                                tw:Tw.Class="text-slate-800 font-bold text-sm"
                                Text="sm" />
                        </Border>
                        <Border
                            docs:DocsCode.Show="True"
                            tw:Tw.Class="drop-shadow-md w-28 h-16 rounded-lg bg-white p-2">
                            <TextBlock
                                tw:Tw.Class="text-slate-800 font-bold text-sm"
                                Text="md" />
                        </Border>
                        <Border
                            docs:DocsCode.Show="True"
                            tw:Tw.Class="drop-shadow-xl w-28 h-16 rounded-lg bg-white p-2">
                            <TextBlock
                                tw:Tw.Class="text-slate-800 font-bold text-sm"
                                Text="xl" />
                        </Border>
                        <Border
                            docs:DocsCode.Show="True"
                            tw:Tw.Class="drop-shadow-2xl w-28 h-16 rounded-lg bg-white p-2">
                            <TextBlock
                                tw:Tw.Class="text-slate-800 font-bold text-sm"
                                Text="2xl" />
                        </Border>
                    </WrapPanel>
                </Border>
            </docs:DocsExample>
        </docs:DocsSection>
    </docs:DocsPage>
</UserControl>
