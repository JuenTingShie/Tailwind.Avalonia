<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Sizing.Width">
    <docs:DocsPage
        Section="Sizing"
        Title="Width"
        Intro="Utilities for controlling an element's width, minimum width, and maximum width. Sizing currently maps the numeric spacing scale and bracket arbitrary values onto Avalonia's Width, MinWidth, and MaxWidth.">
        <StackPanel
            Spacing="52">
            <StackPanel
                Classes="docs-overviewStack">
                <docs:DocsUtilityTable
                    x:Name="UtilityTable"
                    CollapsedRowCount="4" />
            </StackPanel>

            <StackPanel
                Spacing="22">
                <TextBlock
                    Classes="docs-eyebrow"
                    Text="Examples" />
                <StackPanel
                    Classes="docs-exampleStack">
                    <docs:DocsSection
                        Heading="Basic example"
                        Summary="Use w-&lt;number&gt; utilities like w-24 and w-64 to set a fixed width from the shared spacing scale.">
                        <docs:DocsExample>
                            <docs:DocsExample.Snippets>
                                <x:String>&lt;Border Height="56" tw:Tw.Class="w-24" /&gt;</x:String>
                                <x:String>&lt;Border Height="56" tw:Tw.Class="w-40" /&gt;</x:String>
                                <x:String>&lt;Border Height="56" tw:Tw.Class="w-64" /&gt;</x:String>
                            </docs:DocsExample.Snippets>
                            <StackPanel
                                HorizontalAlignment="Left"
                                Spacing="14">
                                <Border
                                    Classes="docs-inset"
                                    tw:Tw.Class="w-[460px]">
                                    <Border
                                        tw:Tw.Class="bg-sky-500 w-24"
                                        CornerRadius="10"
                                        Height="56"
                                        HorizontalAlignment="Left">
                                        <TextBlock
                                            Classes="docs-chip on-color"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="w-24" />
                                    </Border>
                                </Border>
                                <Border
                                    Classes="docs-inset"
                                    tw:Tw.Class="w-[460px]">
                                    <Border
                                        tw:Tw.Class="bg-violet-500 w-40"
                                        CornerRadius="10"
                                        Height="56"
                                        HorizontalAlignment="Left">
                                        <TextBlock
                                            Classes="docs-chip on-color"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="w-40" />
                                    </Border>
                                </Border>
                                <Border
                                    Classes="docs-inset"
                                    tw:Tw.Class="w-[460px]">
                                    <Border
                                        tw:Tw.Class="bg-emerald-500 w-64"
                                        CornerRadius="10"
                                        Height="56"
                                        HorizontalAlignment="Left">
                                        <TextBlock
                                            Classes="docs-chip on-color"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="w-64" />
                                    </Border>
                                </Border>
                            </StackPanel>
                        </docs:DocsExample>
                    </docs:DocsSection>

                    <docs:DocsSection
                        Heading="Setting a minimum width"
                        Summary="Use min-w-&lt;number&gt; when an element should never shrink below a spacing-scale width, even if a local Width value is smaller. Both bars below set Width=&quot;80&quot;.">
                        <docs:DocsExample>
                            <docs:DocsExample.Snippets>
                                <x:String>&lt;Border Width="80" Height="56" tw:Tw.Class="min-w-24" /&gt;</x:String>
                                <x:String>&lt;Border Width="80" Height="56" tw:Tw.Class="min-w-40" /&gt;</x:String>
                            </docs:DocsExample.Snippets>
                            <StackPanel
                                HorizontalAlignment="Left"
                                Spacing="14">
                                <Border
                                    Classes="docs-inset"
                                    tw:Tw.Class="w-[460px]">
                                    <Border
                                        tw:Tw.Class="bg-amber-500 min-w-24"
                                        CornerRadius="10"
                                        Width="80"
                                        Height="56"
                                        HorizontalAlignment="Left">
                                        <TextBlock
                                            Classes="docs-chip on-color"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="min-w-24" />
                                    </Border>
                                </Border>
                                <Border
                                    Classes="docs-inset"
                                    tw:Tw.Class="w-[460px]">
                                    <Border
                                        tw:Tw.Class="bg-orange-500 min-w-40"
                                        CornerRadius="10"
                                        Width="80"
                                        Height="56"
                                        HorizontalAlignment="Left">
                                        <TextBlock
                                            Classes="docs-chip on-color"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="min-w-40" />
                                    </Border>
                                </Border>
                            </StackPanel>
                        </docs:DocsExample>
                    </docs:DocsSection>

                    <docs:DocsSection
                        Heading="Setting a maximum width"
                        Summary="Use max-w-&lt;number&gt; when content should cap out at a spacing-scale width, even if a local Width value is larger. Both bars below set Width=&quot;320&quot;.">
                        <docs:DocsExample>
                            <docs:DocsExample.Snippets>
                                <x:String>&lt;Border Width="320" Height="56" tw:Tw.Class="max-w-24" /&gt;</x:String>
                                <x:String>&lt;Border Width="320" Height="56" tw:Tw.Class="max-w-40" /&gt;</x:String>
                            </docs:DocsExample.Snippets>
                            <StackPanel
                                HorizontalAlignment="Left"
                                Spacing="14">
                                <Border
                                    Classes="docs-inset"
                                    tw:Tw.Class="w-[460px]">
                                    <Border
                                        tw:Tw.Class="bg-rose-500 max-w-24"
                                        CornerRadius="10"
                                        Width="320"
                                        Height="56"
                                        HorizontalAlignment="Left">
                                        <TextBlock
                                            Classes="docs-chip on-color"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="max-w-24" />
                                    </Border>
                                </Border>
                                <Border
                                    Classes="docs-inset"
                                    tw:Tw.Class="w-[460px]">
                                    <Border
                                        tw:Tw.Class="bg-pink-500 max-w-40"
                                        CornerRadius="10"
                                        Width="320"
                                        Height="56"
                                        HorizontalAlignment="Left">
                                        <TextBlock
                                            Classes="docs-chip on-color"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="max-w-40" />
                                    </Border>
                                </Border>
                            </StackPanel>
                        </docs:DocsExample>
                    </docs:DocsSection>

                    <docs:DocsSection
                        Heading="Using a custom value"
                        Summary="Bracket syntax like w-[100px] takes a direct arbitrary value.">
                        <StackPanel
                            Spacing="18">
                            <docs:DocsNote
                                Title="How arbitrary sizes resolve">
                                <StackPanel
                                    Spacing="8">
                                    <TextBlock
                                        Classes="docs-tableClass"
                                        Text="px · rem · em · unitless" />
                                    <TextBlock
                                        Classes="docs-noteBody"
                                        Text="Arbitrary sizing values are parser-only and emit no generated package keys." />
                                    <TextBlock
                                        Classes="docs-noteBody"
                                        Text="rem and em resolve against a 16px base. Unitless values are treated as px." />
                                    <TextBlock
                                        Classes="docs-noteBody"
                                        Text="Only bracket syntax is parsed; w-(&lt;custom-property&gt;) stays unsupported." />
                                    <TextBlock
                                        Classes="docs-noteBody"
                                        Text="Percentages stay unsupported; a % token fails to parse and the whole class is dropped." />
                                </StackPanel>
                            </docs:DocsNote>
                            <docs:DocsExample>
                                <docs:DocsExample.Snippets>
                                    <x:String>&lt;Border tw:Tw.Class="w-[100px]" /&gt;</x:String>
                                    <x:String>&lt;Border Width="80" tw:Tw.Class="min-w-[12.5rem]" /&gt;</x:String>
                                    <x:String>&lt;Border Width="320" tw:Tw.Class="max-w-[5em]" /&gt;</x:String>
                                </docs:DocsExample.Snippets>
                                <StackPanel
                                    HorizontalAlignment="Left"
                                    Spacing="14">
                                    <Border
                                        Classes="docs-inset"
                                        tw:Tw.Class="w-[460px]">
                                        <Border
                                            tw:Tw.Class="bg-sky-500 w-[100px] h-14"
                                            CornerRadius="10"
                                            HorizontalAlignment="Left">
                                            <TextBlock
                                                Classes="docs-chip on-color"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="w-[100px]" />
                                        </Border>
                                    </Border>
                                    <Border
                                        Classes="docs-inset"
                                        tw:Tw.Class="w-[460px]">
                                        <Border
                                            tw:Tw.Class="bg-violet-500 min-w-[12.5rem] h-14"
                                            CornerRadius="10"
                                            Width="80"
                                            HorizontalAlignment="Left">
                                            <TextBlock
                                                Classes="docs-chip on-color"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="min-w-[12.5rem]" />
                                        </Border>
                                    </Border>
                                    <Border
                                        Classes="docs-inset"
                                        tw:Tw.Class="w-[460px]">
                                        <Border
                                            tw:Tw.Class="bg-emerald-500 max-w-[5em] h-14"
                                            CornerRadius="10"
                                            HorizontalAlignment="Left"
                                            Width="320">
                                            <TextBlock
                                                Classes="docs-chip on-color"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="max-w-[5em]" />
                                        </Border>
                                    </Border>
                                </StackPanel>
                            </docs:DocsExample>
                        </StackPanel>
                    </docs:DocsSection>

                    <!-- Tailwind's width docs close with seven sections that this
                         parser does not implement. Collapsed into one grouped
                         gap list rather than seven near-identical callouts. -->
                    <docs:DocsSection
                        Heading="Not implemented yet"
                        Summary="Tailwind's width, min-width, and max-width pages cover several more families. They are listed here rather than shown as examples, so nothing on this page implies support that does not exist.">
                        <docs:DocsNote
                            Classes="gap"
                            Title="Official rows outside the current parser surface">
                            <StackPanel
                                Spacing="14">
                                <StackPanel
                                    Spacing="5">
                                    <TextBlock
                                        Classes="docs-miniTitle"
                                        Text="percentages and fractions" />
                                    <TextBlock
                                        Classes="docs-tableClass"
                                        Text="w-full · w-1/2 · w-2/5 · w-1/3 · w-1/4 · min-w-3/4 · max-w-9/10" />
                                </StackPanel>
                                <StackPanel
                                    Spacing="5">
                                    <TextBlock
                                        Classes="docs-miniTitle"
                                        Text="container scale" />
                                    <TextBlock
                                        Classes="docs-tableClass"
                                        Text="w-3xs…w-2xl · min-w-3xs…min-w-2xl · max-w-3xs…max-w-7xl · max-w-prose" />
                                </StackPanel>
                                <StackPanel
                                    Spacing="5">
                                    <TextBlock
                                        Classes="docs-miniTitle"
                                        Text="viewport units" />
                                    <TextBlock
                                        Classes="docs-tableClass"
                                        Text="w-screen · w-dvw · w-lvw · w-svw · w-dvh · w-lvh · w-svh" />
                                </StackPanel>
                                <StackPanel
                                    Spacing="5">
                                    <TextBlock
                                        Classes="docs-miniTitle"
                                        Text="keywords and resets" />
                                    <TextBlock
                                        Classes="docs-tableClass"
                                        Text="w-auto · container · container mx-auto px-4" />
                                </StackPanel>
                                <StackPanel
                                    Spacing="5">
                                    <TextBlock
                                        Classes="docs-miniTitle"
                                        Text="combined dimensions" />
                                    <TextBlock
                                        Classes="docs-tableClass"
                                        Text="size-16 · size-24 · size-40 · size-full · size-px" />
                                </StackPanel>
                                <StackPanel
                                    Spacing="5">
                                    <TextBlock
                                        Classes="docs-miniTitle"
                                        Text="custom properties and breakpoints" />
                                    <TextBlock
                                        Classes="docs-tableClass"
                                        Text="w-(&lt;custom-property&gt;) · md:w-full · md:min-w-0 · md:max-w-lg" />
                                </StackPanel>
                            </StackPanel>
                        </docs:DocsNote>
                    </docs:DocsSection>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </docs:DocsPage>
</UserControl>
