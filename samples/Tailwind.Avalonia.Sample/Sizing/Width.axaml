<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:Tailwind.Avalonia.Sample.Docs"
    xmlns:tw="using:Tailwind.Avalonia"
    x:Class="Tailwind.Avalonia.Sample.Sizing.Width">
    <docs:DocsPage
        Section="Sizing"
        Title="Width"
        Intro="Utilities for controlling an element's width, minimum width, and maximum width. Sizing currently maps the numeric spacing scale and bracket arbitrary values onto Avalonia's Width, MinWidth, and MaxWidth."
        Supported="w-&lt;number&gt;, min-w-&lt;number&gt;, and max-w-&lt;number&gt; map the numeric spacing scale onto Width, MinWidth, and MaxWidth, as do bracket arbitrary values like w-[100px], min-w-[12.5rem], and max-w-[5em]. Percentages, the container scale, viewport units, size-*, and responsive variants are still out of scope. As in Tailwind v4, &lt;number&gt; is any multiple of 0.25 on the 4px spacing scale, so values like 13 or 17 work too."
        CollapsedRowCount="4"
        GapsTitle="Official rows outside the current parser surface"
        GapsBody="">
        <docs:DocsPage.Utilities>
            <docs:UtilityReferenceRow ClassName="w-&lt;number&gt;" AxamlStyle="&lt;Border Width=&quot;&lt;number&gt;&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="w-[&lt;value&gt;]" AxamlStyle="&lt;Border Width=&quot;&lt;parsed value&gt;&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="min-w-&lt;number&gt;" AxamlStyle="&lt;Border MinWidth=&quot;&lt;number&gt;&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="min-w-[&lt;value&gt;]" AxamlStyle="&lt;Border MinWidth=&quot;&lt;parsed value&gt;&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="max-w-&lt;number&gt;" AxamlStyle="&lt;Border MaxWidth=&quot;&lt;number&gt;&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="max-w-[&lt;value&gt;]" AxamlStyle="&lt;Border MaxWidth=&quot;&lt;parsed value&gt;&quot; /&gt;" />
            <docs:UtilityReferenceRow ClassName="inline-&lt;number&gt;" AxamlStyle="Width (alias of w-)" />
            <docs:UtilityReferenceRow ClassName="min-inline-&lt;number&gt;" AxamlStyle="MinWidth" />
            <docs:UtilityReferenceRow ClassName="max-inline-&lt;number&gt;" AxamlStyle="MaxWidth" />
        </docs:DocsPage.Utilities>
        <docs:DocsPage.Gaps>
            <docs:DocsGap Title="percentages and fractions" Text="w-1/2 · w-2/5 · w-1/3 · w-1/4 · min-w-3/4 · max-w-9/10" />
            <docs:DocsGap Title="container scale" Text="w-3xs…w-2xl · min-w-3xs…min-w-2xl · max-w-3xs…max-w-7xl · max-w-prose" />
            <docs:DocsGap Title="viewport units" Text="w-screen · w-dvw · w-lvw · w-svw · w-dvh · w-lvh · w-svh" />
            <docs:DocsGap Title="keywords and resets" Text="container" />
            <docs:DocsGap Title="custom properties and breakpoints" Text="w-(&lt;custom-property&gt;) · md:w-full · md:min-w-0 · md:max-w-lg" />
        </docs:DocsPage.Gaps>

        <docs:DocsSection
            Heading="Basic example"
            Summary="Use w-&lt;number&gt; utilities like w-24 and w-64 to set a fixed width from the shared spacing scale.">
            <docs:DocsExample>
                <StackPanel
                    HorizontalAlignment="Left"
                    Spacing="14">
                    <Border
                        Classes="docs-inset"
                        tw:Tw.Class="w-[460px]">
                        <Border
                            docs:DocsCode.Show="True"
                            docs:DocsCode.Attributes="Height"
                            tw:Tw.Class="bg-sky-500 w-24"
                            CornerRadius="10"
                            Height="56"
                            HorizontalAlignment="Left">
                            <docs:DocsChip OnColor="True" Text="w-24" />
                        </Border>
                    </Border>
                    <Border
                        Classes="docs-inset"
                        tw:Tw.Class="w-[460px]">
                        <Border
                            docs:DocsCode.Show="True"
                            docs:DocsCode.Attributes="Height"
                            tw:Tw.Class="bg-violet-500 w-40"
                            CornerRadius="10"
                            Height="56"
                            HorizontalAlignment="Left">
                            <docs:DocsChip OnColor="True" Text="w-40" />
                        </Border>
                    </Border>
                    <Border
                        Classes="docs-inset"
                        tw:Tw.Class="w-[460px]">
                        <Border
                            docs:DocsCode.Show="True"
                            docs:DocsCode.Attributes="Height"
                            tw:Tw.Class="bg-emerald-500 w-64"
                            CornerRadius="10"
                            Height="56"
                            HorizontalAlignment="Left">
                            <docs:DocsChip OnColor="True" Text="w-64" />
                        </Border>
                    </Border>
                </StackPanel>
            </docs:DocsExample>
        </docs:DocsSection>

        <docs:DocsSection
            Heading="Setting a minimum width"
            Summary="Use min-w-&lt;number&gt; when an element should never shrink below a spacing-scale width, even if a local Width value is smaller. Both bars below set Width=&quot;80&quot;.">
            <docs:DocsExample>
                <StackPanel
                    HorizontalAlignment="Left"
                    Spacing="14">
                    <Border
                        Classes="docs-inset"
                        tw:Tw.Class="w-[460px]">
                        <Border
                            docs:DocsCode.Show="True"
                            docs:DocsCode.Attributes="Width,Height"
                            tw:Tw.Class="bg-amber-500 min-w-24"
                            CornerRadius="10"
                            Width="80"
                            Height="56"
                            HorizontalAlignment="Left">
                            <docs:DocsChip OnColor="True" Text="min-w-24" />
                        </Border>
                    </Border>
                    <Border
                        Classes="docs-inset"
                        tw:Tw.Class="w-[460px]">
                        <Border
                            docs:DocsCode.Show="True"
                            docs:DocsCode.Attributes="Width,Height"
                            tw:Tw.Class="bg-orange-500 min-w-40"
                            CornerRadius="10"
                            Width="80"
                            Height="56"
                            HorizontalAlignment="Left">
                            <docs:DocsChip OnColor="True" Text="min-w-40" />
                        </Border>
                    </Border>
                </StackPanel>
            </docs:DocsExample>
        </docs:DocsSection>

        <docs:DocsSection
            Heading="Setting a maximum width"
            Summary="Use max-w-&lt;number&gt; when content should cap out at a spacing-scale width, even if a local Width value is larger. Both bars below set Width=&quot;320&quot;.">
            <docs:DocsExample>
                <StackPanel
                    HorizontalAlignment="Left"
                    Spacing="14">
                    <Border
                        Classes="docs-inset"
                        tw:Tw.Class="w-[460px]">
                        <Border
                            docs:DocsCode.Show="True"
                            docs:DocsCode.Attributes="Width,Height"
                            tw:Tw.Class="bg-rose-500 max-w-24"
                            CornerRadius="10"
                            Width="320"
                            Height="56"
                            HorizontalAlignment="Left">
                            <docs:DocsChip OnColor="True" Text="max-w-24" />
                        </Border>
                    </Border>
                    <Border
                        Classes="docs-inset"
                        tw:Tw.Class="w-[460px]">
                        <Border
                            docs:DocsCode.Show="True"
                            docs:DocsCode.Attributes="Width,Height"
                            tw:Tw.Class="bg-pink-500 max-w-40"
                            CornerRadius="10"
                            Width="320"
                            Height="56"
                            HorizontalAlignment="Left">
                            <docs:DocsChip OnColor="True" Text="max-w-40" />
                        </Border>
                    </Border>
                </StackPanel>
            </docs:DocsExample>
        </docs:DocsSection>

        <docs:DocsSection
            Heading="Using a custom value"
            Summary="Bracket syntax like w-[100px] takes a direct arbitrary value.">
            <StackPanel
                Spacing="18">
                <docs:DocsNote
                    Title="How arbitrary sizes resolve">
                    <StackPanel
                        Spacing="8">
                        <TextBlock
                            Classes="docs-tableClass"
                            Text="px · rem · em · unitless" />
                        <TextBlock
                            Classes="docs-noteBody"
                            Text="Arbitrary sizing values are parser-only and emit no generated package keys." />
                        <TextBlock
                            Classes="docs-noteBody"
                            Text="rem and em resolve against a 16px base. Unitless values are treated as px." />
                        <TextBlock
                            Classes="docs-noteBody"
                            Text="Only bracket syntax is parsed; w-(&lt;custom-property&gt;) stays unsupported." />
                        <TextBlock
                            Classes="docs-noteBody"
                            Text="Percentages stay unsupported; a % token fails to parse and that token is dropped, while the rest of the class list still applies." />
                    </StackPanel>
                </docs:DocsNote>
                <docs:DocsExample>
                    <StackPanel
                        HorizontalAlignment="Left"
                        Spacing="14">
                        <Border
                            Classes="docs-inset"
                            tw:Tw.Class="w-[460px]">
                            <Border
                                docs:DocsCode.Show="True"
                                tw:Tw.Class="bg-sky-500 w-[100px] h-14"
                                CornerRadius="10"
                                HorizontalAlignment="Left">
                                <docs:DocsChip OnColor="True" Text="w-[100px]" />
                            </Border>
                        </Border>
                        <Border
                            Classes="docs-inset"
                            tw:Tw.Class="w-[460px]">
                            <Border
                                docs:DocsCode.Show="True"
                                docs:DocsCode.Attributes="Width"
                                tw:Tw.Class="bg-violet-500 min-w-[12.5rem] h-14"
                                CornerRadius="10"
                                Width="80"
                                HorizontalAlignment="Left">
                                <docs:DocsChip OnColor="True" Text="min-w-[12.5rem]" />
                            </Border>
                        </Border>
                        <Border
                            Classes="docs-inset"
                            tw:Tw.Class="w-[460px]">
                            <Border
                                docs:DocsCode.Show="True"
                                docs:DocsCode.Attributes="Width"
                                tw:Tw.Class="bg-emerald-500 max-w-[5em] h-14"
                                CornerRadius="10"
                                HorizontalAlignment="Left"
                                Width="320">
                                <docs:DocsChip OnColor="True" Text="max-w-[5em]" />
                            </Border>
                        </Border>
                    </StackPanel>
                </docs:DocsExample>
            </StackPanel>
        </docs:DocsSection>
    </docs:DocsPage>
</UserControl>
